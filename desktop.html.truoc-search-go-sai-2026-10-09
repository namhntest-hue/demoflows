              <p class="t-multiline w-full min-w-0 text-secondary-foreground truncate">${c.name}</p>
            </div>
          </div>
          <p class="t-single text-muted-foreground">${c.variant}</p>
          ${c.preorder ? `<p class="t-single text-foreground-alt pt-1">Nhận hàng dự kiến <span class="font-medium">${c.preorder}</span></p>` : ''}
          ${cartRowNote(c)}
        </div>
        <!-- giá + stepper ghim đáy ô — ĐẢO CHỖ 13/09/2026 theo brief (PDF trang 25,
