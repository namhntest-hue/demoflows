/* Hàng chấm của hero — thứ DUY NHẤT phải viết JS cho trang chủ.
   Mũi tên đã do `wireRail()` lo trọn gói (ẩn/hiện theo hướng còn nội dung, bấm là cuộn
   đúng `track.clientWidth`, đo lại khi đổi khổ) vì hero mang đủ `.dk-rail` +
   `.dk-rail-track` + 2 attribute `data-rail-*`. `place()` bên trong wireRail tự thoát vì
   track không có `[data-product]`, nên `--rail-arrow-y` không được đặt và CSS rơi về
   `top: 50%` — đúng giữa ảnh, chính xác cái mình cần ở đây.
   Listener đẩy vào `scrollCleanups` để đổi màn không rò. */
/* 2 nut lat TRANG cua dai Instagram (07/09/2026, lenh user). Khong dung wireRail():
   cai do lat theo `scrollLeft` cua mot hop cuon, con day het cuon roi — lat bang
   `transform` giong #promoSlider.
   MOT TRANG = `100%`. `100%` cua translateX tinh theo BE RONG CHINH TRACK, ma track la
   khoi block nen rong dung bang khung (6 o cua trang sau tran ra ngoai va bi
   `overflow: hidden` cat). Truoc 15/09/2026 con phai cong bu mot khe 2px; nay khe ve 0
   (lenh user: cac hinh sat nhau) nen buoc lat la so tron.
   VONG LAI o hai dau: bam trai o trang dau thi ve trang cuoi. Nho vay CA HAI nut luc nao
   cung co viec — dung luat "khong bay nut khong co viec" cua du an, ma van hien du 2 nut
   nhu lenh yeu cau. Con neu kho anh chi du 1 trang thi an ca hai. */
function wireInsta(root) {
  const wrap = root.querySelector('.hm-insta-wrap');
  if (!wrap) return;
  const track = wrap.querySelector('.hm-insta');
  const prev = wrap.querySelector('[data-insta-prev]');
  const next = wrap.querySelector('[data-insta-next]');
  if (!track || !prev || !next) return;
  const pages = Math.max(1, Math.ceil(track.children.length / HM_INSTA.per));
  if (pages < 2) { prev.hidden = true; next.hidden = true; return; }
  let page = 0;
  const paint = () => { track.style.transform = 'translateX(' + (-page * 100) + '%)'; };
  const step = d => { page = (page + d + pages) % pages; paint(); };
  prev.addEventListener('click', () => step(-1));
  next.addEventListener('click', () => step(1));
  paint();
}

function wireHeroDots(root) {
  const track = root.querySelector('.hm-hero-track');
  const dots  = root.querySelector('[data-hero-dots]');
  if (!track || !dots) return;
  const pips = [...dots.querySelectorAll('[data-hero-dot]')];
  /* Mot class trang thai RIENG thay vi lat 2 class mau cua tailwind: tu 07/09 cham nam
     TREN anh nen mau cua no do CSS lo (trang / trang 45%), khong con la bg-primary /
     bg-border. Giu bg-* o day thi chung thanh nhan trang thai doi lot ten mau. */
  const paint = i => pips.forEach((d, k) => d.classList.toggle('hm-pip-on', k === i));
  /* `cur` = tấm mà dải ĐANG nhắm tới. Nó là biến riêng chứ không suy ra từ `scrollLeft`
     mỗi lượt, vì nhịp tự chạy ở dưới cần một điểm neo KHÔNG phụ thuộc cú cuộn trước đã
     chạy xong hay chưa — xem chú thích ở đó. `sync()` (chạy khi người dùng vuốt/kéo, hoặc
     khi đổi khổ) kéo `cur` về đúng thực tế, nên tương tác của người dùng vẫn là chân lý. */
  let cur = 0;
  const sync = () => {
    const w = track.clientWidth || 1;
    cur = Math.max(0, Math.min(pips.length - 1, Math.round(track.scrollLeft / w)));
    paint(cur);
  };
  /* Bấm chấm: cuộn tới tấm đó RỒI GỌI THẲNG sync(), không chờ sự kiện `scroll`.
     Trạng thái của hàng chấm là HỆ QUẢ của cú bấm, nên đừng bắt nó đi vòng qua một
     sự kiện mà chính mình vừa gây ra: `scroll` có thể đến muộn, bị gộp nhịp, hoặc
     (đo được 04/09 khi kiểm) không đến trong 700ms nếu tài liệu đang ở trạng thái
     ẩn. Gọi thẳng sync() thì chấm đúng ngay; sự kiện đến sau chỉ chạy lại đúng phép
     tính đó, vô hại. */
  /* SUA 08/09/2026: bam cham nay DAT `cur` va son cham THEO CHI SO VUA BAM, khong goi
     `sync()` nua. `sync()` suy chi so tu `scrollLeft`, ma o thoi diem handler chay thi
     scrollLeft CHUA nhich (cuon muot vua bat dau) -> no son lai dung cai cham CU. Do duoc:
     bam cham thu 2, hang cham van bao tam 1.
     Hai hau qua that, khong chi la chuyen do trong pane:
       · o trinh duyet that no tu chua duoc nho cac su kien `scroll` den sau, nhung nhay
         mot nhip — cham sang muon hon cu bam;
       · `cur` (diem neo cua nhip tu chay) khong duoc cap nhat, nen bam cham 2 xong nhip
         ke tiep chay (0+1) = dung tam vua chon -> hero nhu dung yen mot luot.
     Dung `scrollTo` co `behavior` TUONG MINH cho giong nhip tu chay va giong cu snap khi
     nha chuot. Chinh chu thich cu da noi "trang thai hang cham la HE QUA cua cu bam" —
     nay code moi lam dung dieu do. */
  pips.forEach((d, i) => d.addEventListener('click', () => {
    cur = i;
    track.scrollTo({ left: i * (track.clientWidth || 1), behavior: 'smooth' });
    paint(i);
  }));
  track.addEventListener('scroll', sync, { passive: true });
  window.addEventListener('resize', sync, { passive: true });
  scrollCleanups.push(() => window.removeEventListener('resize', sync));

  /* TỰ CHẠY (07/09/2026, lệnh user "auto slide"). Chỉ chạy khi có >1 tấm — 1 tấm thì
     hàng chấm cũng không dựng.
     DỪNG khi rê chuột và khi đang kéo: một băng tự nhảy dưới con trỏ là thứ làm người ta
     bấm trượt. Bấm chấm cũng ĐẶT LẠI đồng hồ, kẻo vừa chọn tấm xong nó nhảy tiếp ngay.
     `behavior: 'smooth'` khai TƯỜNG MINH chứ không nhờ CSS: `scroll-behavior: smooth` nằm
     ở `.dk-rail-track` nên chỉ bản desktop có, bản mobile không.
     Sơn chấm NGAY thay vì chờ sự kiện `scroll` — cùng lý do đã ghi ở chỗ bấm chấm.
     VÌ SAO ĐI QUA `cur` CHỨ KHÔNG ĐỌC `scrollLeft` mỗi vòng: bản đầu tôi tính tấm kế tiếp
     bằng `Math.round(scrollLeft / w) + 1`. Đo ra nó ĐỨNG HẲN — nếu cú cuộn trước chưa tới
     đích (animation bị cắt, snap chưa nghỉ, hoặc môi trường không chạy smooth) thì vòng sau
     đọc lại đúng vị trí cũ và tính ra đúng tấm cũ, nên dải kẹt ở một tấm. Giữ chỉ số riêng
     thì nhịp không bao giờ kẹt, còn `sync()` vẫn kéo nó về thực tế khi người dùng vuốt.
     clearInterval đẩy vào `scrollCleanups` vì mỗi lần đổi màn là dựng lại trang chủ: không
     gỡ thì mỗi lượt vào lại chồng thêm một đồng hồ (đúng cái bẫy mà
     `clearInterval(window.__promoTimer)` ở `wire()` đang phải chống). */
  let timer = null;
  const stop = () => { clearInterval(timer); timer = null; };
  const start = () => {
    stop();
    if (pips.length < 2) return;
    timer = setInterval(() => {
      cur = (cur + 1) % pips.length;
      track.scrollTo({ left: cur * (track.clientWidth || 1), behavior: 'smooth' });
      paint(cur);
    }, HM_HERO_MS);
  };
  track.addEventListener('pointerenter', stop);
  track.addEventListener('pointerleave', start);
  track.addEventListener('pointerdown', stop);
  pips.forEach(d => d.addEventListener('click', start));
  scrollCleanups.push(stop);
  start();

  sync();
}


