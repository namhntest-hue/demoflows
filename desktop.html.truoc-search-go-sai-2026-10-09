                </div>`;
  };
  /* Một dòng hàng của thẻ SẢN PHẨM — danh sách PHẲNG (hàng rồi quà), không chia đợt (layout v4,
     01/10/2026). Khuôn tách riêng từ trước khi màn còn chia đợt.
     28/09/2026 (brief trang 55): dòng vào LƯỚI 3 CỘT .ord-grid — ảnh + chữ | SL | tiền.
     Hãng tra PRODUCTS (trước in cứng "Versace"); thêm dòng "Mã sản phẩm" (brief "Itemno"). */
  const itemRow = it => {
    const p = orderItemP(it), pa = orderPdpAttr(it), cp = pa ? ' cursor-pointer press' : '';
    return `
              <div class="ord-grid">
                <div class="flex gap-4 min-w-0">
                  <div class="w-[72px] h-[96px] bg-secondary overflow-hidden shrink-0${cp}"${pa}>
                    <img src="${A}${it.img}" class="w-full h-full object-cover" alt="${it.name}">
                  </div>
                  <div class="flex-1 min-w-0 flex flex-col">
                    ${p.brand ? `<span class="t-single text-muted-foreground">${p.brand}</span>` : ''}
                    <!-- 03/09/2026: badge "Đặt trước" ĐỨNG TRƯỚC TÊN như mọi thẻ
                         khác, và dòng ngày THÔI mở đầu bằng "Pre-order" — vừa lặp
                         badge, vừa là chữ Anh trong câu Việt (nhãn VI chốt 27/08 là
                         "Đặt trước"). Nay dòng đi đúng khoá i18n sẵn có
                         'Nhận hàng dự kiến' của hàng giỏ. -->
                    <span class="flex items-start gap-1.5 min-w-0">
                      ${it.preorder ? `<span class="t-single badge-inline px-1 font-medium text-foreground shrink-0">Đặt trước</span>` : ''}
                      <span class="t-multiline w-full min-w-0 text-foreground line-clamp-2${cp}"${pa}>${it.name}</span>
                    </span>
                    <span class="t-single text-muted-foreground mt-1">${it.variant}</span>
                    ${it.sku ? `<span class="t-single text-muted-foreground mt-0.5">Mã sản phẩm: <span>${it.sku}</span></span>` : ''}
                    ${it.qty > 1 ? `<span class="t-single text-muted-foreground mt-0.5"><span>Đơn giá:</span> <span>${vndDot(vndNum(it.price))}</span></span>` : ''}
                    ${it.preorder ? `<span class="t-single text-foreground-alt mt-0.5">Nhận hàng dự kiến <span class="font-medium">${it.preorder}</span></span>` : ''}
                    <span class="ord-qty-in t-single text-muted-foreground mt-0.5">SL: ${it.qty || 1}</span>
                  </div>
                </div>
                <span class="t-multiline text-foreground text-center">x${it.qty || 1}</span>
                ${priceCell(it)}
              </div>`;
  };
  /* Dòng QUÀ TẶNG trong đơn — cùng khuôn dòng hàng, khác đúng 3 chỗ: badge "Quà tặng"
     đứng trước tên (chỗ của badge "Đặt trước"), dòng phụ là TÊN CHƯƠNG TRÌNH thay cho
     phân loại, và giá 0 ₫. Trước 06/09 quà chỉ sống ở giỏ, thanh toán và màn Hoàn tất;
     mở lại đơn cũ thì không còn dấu vết nào của quà đã nhận.
     28/09/2026: vào cùng lưới 3 cột với dòng hàng (x1 | 0 ₫). */
  const giftRow = ({ pk, g }) => `
              <div class="ord-grid">
                <div class="flex gap-4 min-w-0">
                  <div class="w-[72px] h-[96px] bg-secondary overflow-hidden shrink-0">
                    <img src="${A}${g.img}" class="w-full h-full object-cover" alt="${g.name}">
                  </div>
                  <div class="flex-1 min-w-0 flex flex-col">
                    <span class="t-single text-muted-foreground">${g.brand}</span>
                    <span class="flex items-start gap-1.5 min-w-0">
                      <span class="t-single badge-inline px-1 font-medium text-foreground shrink-0">Quà tặng</span>
                      <span class="t-multiline w-full min-w-0 text-foreground line-clamp-2">${g.name}</span>
                    </span>
                    <span class="t-single text-muted-foreground mt-1">${(GIFT_PROGRAMS[pk] || {}).name || ''}</span>
                    <span class="ord-qty-in t-single text-muted-foreground mt-0.5">SL: 1</span>
                  </div>
                </div>
                <span class="t-multiline text-foreground text-center">x1</span>
                <p class="t-lead text-foreground text-right">0 ₫</p>
              </div>`;
  /* Khối tổng (02/10/2026, giống bản mobile): hàng 14/20 nhãn + số cùng màu mực (Giảm giá đỏ cả nhãn lẫn số), kẻ ngăn nhạt, Tổng thanh toán Inter 16/24 · 500 kèm "(Bao gồm VAT)" mờ cạnh nhãn; hàng điểm đã DỜI lên
     thẻ Mã đơn (02/10: dải kem góc phải; 04/10: cột "Điểm tích luỹ" của hàng thông tin; 05/10 tối: một dòng trong danh sách thông tin; 07/10 lượt 2: hàng CUỐI của tấm tổng — hình brief, xem ptsRow) (v4 từng: Libre 16/24, "Đã bao gồm VAT" một dòng riêng, hàng điểm màu thành công). Đơn do checkout sinh ra ghi discount '' khi không giảm — quy về '0 ₫' cho khỏi in một ô đỏ rỗng. Nhãn "Giảm giá" và "(7%)" là hai span riêng để luật i18n khớp nguyên chuỗi.
     Hàng điểm: "Điểm tích luỹ sau khi hoàn tất" khi đơn chưa Hoàn tất (điểm DỰ KIẾN), "Điểm tích luỹ" khi đã xong; đơn huỷ không có hàng này; cùng luật giỏ (100.000 ₫ = 1 điểm); số trần "+1.195"
     như khung (không chữ "điểm"). */
  const sumRow = (label, val, cls = '') => `
              <div class="ov-sum-row t-lead ${cls}"><span>${label}</span><span>${val}</span></div>`;
  const disc = o.discount || '0 ₫', pct = orderDiscPct(o), neg = disc !== '0 ₫';
  /* Hành động của màn (01/10/2026, quy trình khách chốt; ĐỔI CHỖ 05/10/2026 theo khung user 1159:105033): đơn Chờ thanh toán có MỘT nút "Thanh toán lại" nằm BÊN PHẢI hàng đầu thẻ Mã đơn (trước: chính nhãn trạng thái là nút — statusTag(o, true, true) —
     và một nút nữa dưới ngày đặt; nay nhãn chỉ là nhãn); đơn có mã vận đơn có nút "Theo dõi vận đơn" (07/10 lượt 2: ở đầu thẻ Trạng thái, nút CHÍNH đen chữ trắng + dải vàng "Mã vận đơn" dưới nút). Mua lại · Xuất hoá đơn · Huỷ đơn · Nhắc tôi khi hàng về đã gỡ. */
  /* Timeline 4 chặng (khung v4; nằm ở thẻ TRẠNG THÁI từ 07/10 lượt 2, trước đó ở thẻ MÃ ĐƠN): xong = nút đen + tick · ĐANG Ở = vòng đen + chấm · chưa tới = nền mờ + chấm nhỏ; chặng CUỐI của đơn đã hoàn tất là tick (không phải "đang ở") như stepper cũ
     (28/09: tick ở chặng "Chờ thanh toán" đang chờ đọc ra "đã thanh toán xong"). Đơn huỷ: các chặng đã qua + nút cuối ✕ đỏ "Đã huỷ". Giờ ghi "dd/mm · hh:mm"; chặng cuối chưa tới ghi "Dự kiến dd/mm" khi có ngày giao. */
  const tlHTML = orderTlSteps(o).map((s, i) => {
    const node = orderDotHTML(s.st);
    return `
              <div class="ov-step">
                ${i > 0 ? `<span class="ov-step-line${s.st === 'todo' ? ' is-todo' : ''}"></span>` : ''}
                ${node}
                <span class="t-single ov-step-name${s.st === 'cancel' ? ' text-destructive' : s.st === 'todo' ? '' : ' is-on'}">${s.label}</span>
                ${s.when ? `<span class="t-single ov-step-time">${s.when}</span>` : ''}
              </div>`;
  }).join('');
  /* HÀNG THÔNG TIN của thẻ ĐẦU (07/10/2026 lượt 2, vị trí theo hình brief): HOÁ ĐƠN rồi THANH TOÁN — mỗi loại một dòng [nhãn xám 14/20 · giá trị 14/20 · 500], STYLE của 05/10 tối (khung user `1174:115805`). Trước 07/10: điểm tích luỹ · thanh toán · hoá đơn;
     điểm tích luỹ nay nằm CUỐI tấm tổng (hình). Hoá đơn có VAT là NÚT mở ngăn kéo (giá trị "Công ty / Cá nhân" + mũi tên phải).
     09/10/2026 (user, hình chụp màn này khoanh ba dòng: "cuối câu cho dấu :" — gõ ra là dấu ngoặc kép, hai phím sát nhau, hiểu là dấu hai chấm): NHÃN của cả ba dòng (và nhãn hoá đơn bản NÚT) thêm ":" cuối nhãn. Dấu đứng NGOÀI span nhãn để luật i18n còn khớp nguyên chuỗi — cùng nếp .ord-card-total-l. Bản mobile KHÔNG đổi (hàng nhãn trái · giá trị phải). */
  const metaHTML = [
    o.vat ? `
                    <button type="button" data-inv-sheet="${o.id}" aria-haspopup="dialog" class="ov-mi ov-prog press">
                      <span class="t-lead ov-k"><span>Thông tin xuất hóa đơn</span>:</span>
                      <span class="t-lead ov-mv ov-go"><span>${orderVatRows(o)[0][1]}</span>${I.chevR('currentColor')}</span>
                    </button>` : `
                    <div class="ov-mi"><span class="t-lead ov-k"><span>Thông tin xuất hóa đơn</span>:</span><span class="t-lead ov-mv">Không xuất hoá đơn</span></div>`,
    `
                    <div class="ov-mi"><span class="t-lead ov-k"><span>Phương thức thanh toán</span>:</span><span class="t-lead ov-mv">${orderPayName(o)}</span></div>`,
    /* 07/10/2026 tối (layout cuối, khung 1220:155122): dòng thứ BA — giá trị = tên phương thức giao hàng (trước nằm ở dải vàng cuối thẻ Trạng thái). */
    `
                    <div class="ov-mi"><span class="t-lead ov-k"><span>Phương thức giao hàng</span>:</span><span class="t-lead ov-mv">${o.method}</span></div>`
  ].join('');
  /* Hàng ĐIỂM TÍCH LUỸ — hàng CUỐI của tấm tổng (hình: dải điểm ở góc phải dưới tấm). "Điểm tích luỹ sau khi hoàn tất" khi đơn chưa Hoàn tất (điểm DỰ KIẾN), "Điểm tích luỹ" khi đã xong; đơn huỷ không có hàng này; số trần "+1.195" (không chữ "điểm"). Kiểu chữ = hàng điểm cũ: nhãn xám · số 500 (đồng ở skin-li). */
  const ptsRow = o.tone === 'cancel' ? '' : `
                    <div class="ov-sum-row t-lead ov-ptsrow"><span class="ov-k">${orderPointsFinal(o) ? 'Điểm tích luỹ' : 'Điểm tích luỹ sau khi hoàn tất'}</span><span class="t-lead ov-mv ov-pts">+${n(orderPoints(o))}</span></div>`;

  return `
  <div class="w-full" data-scroller>
    ${navBar()}
    <div class="max-w-[1440px] mx-auto w-full acc-page">
      ${dkCrumbs(['Trang chủ', 'Tài khoản', 'Chi tiết đơn hàng'])}
      <!-- 28/09/2026 (brief trang 55) — BỎ TRẦN 860, rồi đưa màn VÀO KHUNG TÀI KHOẢN: mục lục trái với "Đơn hàng" đang sáng, cột nội dung 1040 (khuôn khung user 734:52984, xem .acc-layout). 02/10/2026 (user: "làm desktop giống
           bản mobile luôn nhé"): theo NGÔN NGỮ của bản mobile (khung Figma 1063:78040). 04/10/2026 (user sửa khung 1071:54047 + "nâng cấp giao diện ở bản desktop"): hàng tiêu đề kẻ đáy, thân TRẮNG, thẻ MÃ ĐƠN (mã · nhãn / ngày / hàng thông tin 3 cột
           điểm · hoá đơn · thanh toán / timeline ngang), hai KHỐI VIỀN người nhận | giao hàng, thẻ SẢN PHẨM, tấm TỔNG xám thu gọn dính phải — xem khối CSS ".ov-cards". Hoá đơn và tiến trình mở NGĂN KÉO bên phải (#shipSheet).
           05/10/2026 (user sửa tiếp khung 1159:105033, "dùng layout này … áp cho các trạng thái khác"): hàng tiêu đề HẾT kẻ đáy, các thẻ cách 16 + thẻ Mã đơn / Sản phẩm có VIỀN, tấm tổng nằm TRONG thẻ Sản phẩm, hàng thông tin NGANG, nút "Thanh toán lại" bên PHẢI hàng đầu, nút "Theo dõi vận đơn" lên hàng tiêu đề khối giao hàng. 07/10/2026 lượt 2: BỐ CỤC đổi theo HÌNH brief (người nhận lên thẻ đầu, thẻ Trạng thái mới, điểm xuống tấm tổng), STYLE giữ — xem khối CSS ov-cards. -->
      <div class="acc-layout">
        ${accSideNav('orders')}
        <div class="acc-main">
          <div class="ov-page">
            <div class="ov-titlebar">
              <button type="button" data-atab="orders" aria-label="Đơn hàng" class="ov-backbtn press">${I.chevL}</button>
              <h1 class="t-display-title text-foreground">Chi tiết đơn hàng</h1>
            </div>
            <!-- 07/10/2026 (lượt 2; user: "bố cục dùng giống hình brief thôi, còn style thì như cũ"): MỘT KHUNG VIỀN (.ov-cards, 800, như 05/10 tối) chia ba phần bằng kẻ — thứ tự + vị trí nội dung theo HÌNH brief, kiểu dáng giữ của bản cũ. Giải thích: khối CSS ở .ov-cards. .rise đặt ở khung, không ở từng phần. -->
            <div class="ov-cards rise">

              <!-- 1. THẺ ĐẦU — hàng đầu [mã + nhãn trạng thái | ngày đặt canh PHẢI (hình), đơn Chờ thanh toán có nút Thanh toán lại ngay dưới ngày (khung user 1159:105033: nút 1 bên, nhãn trạng thái chỉ là NHÃN)] · dải ghi chú theo trạng thái (đơn huỷ vì sao + tiền hoàn, xem orderNoteLines; hình chỉ vẽ đơn đang giao) · kẻ ·
                   NGƯỜI NHẬN (hình: ngay dưới hàng đầu) · hàng HOÁ ĐƠN rồi THANH TOÁN (mỗi loại một dòng). Chỉ kẻ ĐÁY, đệm 16 · khe 24.
                   07/10/2026 TỐI (LAYOUT CUỐI, khung user 1220:155122): tiêu đề "Thông tin đơn hàng" + HAI CỘT bằng nhau — trái người nhận, phải ba dòng hoá đơn · thanh toán · GIAO HÀNG (dòng mới); xem CSS .ov-info (không dùng dấu huyền trong chú thích này: nó nằm TRONG template). -->
              <div class="ov-card is-head">
                <div class="ov-top">
                  <div class="ov-hrow">
                    <div class="ov-codes">
                      <span class="ov-idg"><span class="ov-codek">Mã đơn hàng</span><span class="ov-code">${o.id}</span></span>
                      ${statusTag(o, false, true)}
                    </div>
                    <div class="ov-headr">
                      <span class="ov-dateg"><span class="t-lead ov-datek">Ngày đặt</span><span class="t-lead ov-date">${orderPlaced(o)}</span></span>
                      ${payAct ? `<button ${payAct.attr} class="ov-pay t-lead h-12 px-8 bg-primary text-primary-foreground btn-p press">${payAct.label}</button>` : ''}
                    </div>
                  </div>
                  ${noteLines.length ? `
                  <div class="bg-accent-0 px-4 py-2 flex flex-col gap-1">
                    ${noteLines.map(l => `<span class="t-multiline text-foreground-alt">${l}</span>`).join('')}
                  </div>` : ''}
                  <div class="ov-divider"></div>
                  <div class="ov-info">
                    <div class="ov-rcv">
                      <p class="ov-ttl text-foreground">Thông tin đơn hàng</p>
                      <div class="ov-addr">
                        <span class="t-lead ov-name">${personName(o.address)}</span>
                        ${o.address.line ? `<span class="t-lead">${o.address.line}</span>` : ''}
                        ${o.address.phone ? `<span class="t-lead">${o.address.phone}</span>` : ''}
                      </div>
                    </div>
                    <div class="ov-meta">${metaHTML}
                    </div>
                  </div>
                </div>
              </div>

              <!-- 2. THẺ TRẠNG THÁI (hình) — tiêu đề "Trạng thái đơn hàng" bên trái; bên PHẢI nút CHÍNH đen chữ trắng "Theo dõi vận đơn" (mở ngăn kéo tiến trình) + DẢI VÀNG "Mã vận đơn …" ngay dưới nút (chỉ đơn có mã vận đơn); stepper 4 chặng; DẢI VÀNG cuối [tên phương thức | Dự kiến giao + ngày] (không nhãn "Phương thức") (đơn huỷ: chỉ còn phương thức).
                   ⚠ 07/10/2026 TỐI (LAYOUT CUỐI, khung user 1220:155122) ĐẢO hai chỗ: nút Theo dõi = nút VIỀN nhỏ cao 36 (không còn nút đen 48) và dải vàng giao hàng BỎ HẲN (phương thức lên khối Thông tin đơn hàng ở thẻ đầu; ngày dự kiến còn ở chặng cuối stepper). -->
              <div class="ov-card is-stat">
                <div class="ov-st-head">
                  <p class="ov-ttl text-foreground">Trạng thái đơn hàng</p>
                  ${awbs.length ? `
                  <div class="ov-trk">
                    <button type="button" data-ship-sheet="${o.id}" aria-haspopup="dialog" class="t-lead h-9 px-3 rounded-xs border border-border bg-background text-foreground btn-o press">Theo dõi vận đơn</button>
                    <p class="ov-mi ov-awb"><span class="t-lead ov-k">Mã vận đơn</span><span class="t-lead ov-v">${awbs.join(', ')}</span></p>
                  </div>` : ''}
                </div>
                <div class="ov-tl">${tlHTML}
                </div>
              </div>

              <!-- 3. THẺ SẢN PHẨM + TỔNG (như 05/10 tối: chỉ kẻ ĐỈNH, tấm TỔNG xám FULL bề ngang lòng thẻ). Bảng hàng (brief trang 55): "Sản phẩm (N) | Số lượng | Thành tiền" — hàng tiêu đề và mọi dòng dùng CHUNG lưới .ord-grid nên nhãn cột đứng thẳng trên cột của nó. N = số dòng hàng, như "Giỏ hàng (N)".
                   Quà vào cùng danh sách, ảnh quà 72×96 bằng ảnh hàng thường. Cột chữ của tấm tổng canh PHẢI (hình); hàng điểm tích luỹ là hàng CUỐI của tấm. -->
              <div class="ov-card ov-items">
                <div class="ord-grid ord-grid-head">
                  <p class="ov-ttl text-foreground">Sản phẩm (${o.items.length})</p>
                  <span class="t-single ov-colhead text-center">Số lượng</span>
                  <span class="t-single ov-colhead text-right">Thành tiền</span>
                </div>
                <div class="ov-lines">${o.items.map(itemRow).join('')}${orderGifts(o).map(giftRow).join('')}
                </div>
                <div class="ov-sum-wrap">
                  <div class="ov-sum">
                    ${sumRow('Tạm tính', o.sub)}
                    ${sumRow(pct ? `<span>Giảm giá</span> <span>(${pct}%)</span>` : 'Giảm giá', disc, neg ? 'is-neg' : '')}
                    ${sumRow('Phí vận chuyển', o.ship)}
                    ${o.pointsUsed ? sumRow(`Dùng ${Math.round(o.pointsUsed).toLocaleString('vi-VN')} điểm`, '− ' + vndDot(o.pointsUsed * REWARD_POINT_VALUE), 'is-neg') : ''}
                    <div class="ov-divider"></div>
                    <div class="ov-sum-row ov-sum-total">
                      <span class="ov-total-l"><span class="ov-total">Tổng thanh toán</span><span class="t-single ov-vat">(Bao gồm VAT)</span></span>
                      <span class="ov-total">${o.total}</span>
                    </div>${ptsRow}
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    </div>
    ${footer()}
  </div>`;
