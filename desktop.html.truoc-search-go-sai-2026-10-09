/* Ẩn nút "Xem tất cả" khi thân hộp khuyến mãi KHÔNG bị cắt (23/09/2026).
   Vì sao cần: `.promo-peek` kẹp thân ở 89px, nhưng 5/6 PDP chỉ có 2–3 dòng ưu đãi
   (2 dòng ~60px, 3 dòng ~86px) nên chẳng có gì bị giấu — để nguyên thì nút "Xem tất
   cả N chương trình" bấm vào không thấy gì đổi, đọc ra như nút hỏng. Hộp ở GIỎ có 3
   khối nhiều dòng nên luôn vượt 89, nút vẫn hiện như cũ.
   Cách làm: so `scrollHeight` với `clientHeight` NGAY SAU KHI dựng (đo được vì cả hai
   đã có layout lúc wire chạy). Vừa khít thì bật sẵn `.open` — dùng lại trạng thái CÓ
   SẴN thay vì đẻ class mới: `.open` vừa bỏ trần chiều cao vừa tắt vệt mờ đáy, đúng hai
   thứ cần tắt khi không còn gì để giấu.
   Cộng 1px dung sai: chiều cao dòng lẻ làm scrollHeight hơn clientHeight đúng 1px ở
   vài cỡ chữ, không bù thì nút hiện nhầm. */
function wirePromoPeek(root) {
  root.querySelectorAll('.promo-box').forEach(hop => {
    /* 29/09/2026 — hộp PHẲNG (PDP) cắt theo SỐ HÀNG và tự in nút khi cần, thân không còn trần
       chiều cao nên scrollHeight luôn bằng clientHeight: để đo tiếp là bật `.open` và ẩn nhầm
       cái nút vừa được in cho trường hợp hơn 5 chương trình. Chỉ hộp ở giỏ còn dùng phép đo này. */
    if (hop.classList.contains('promo-flat')) return;
    const peek = hop.querySelector('.promo-peek');
    const nut  = hop.querySelector('.promo-foot');
    if (!peek || !nut || peek.classList.contains('open')) return;
    if (peek.scrollHeight <= peek.clientHeight + 1) {
      peek.classList.add('open');
      nut.classList.add('hidden');
    }
  });
}

