            ${HM_BRAND_CARDS.map(([name, logo]) => `
            <button data-nav="plp" data-plp-brand="${name}" class="hm-brand-card press" aria-label="${name}">
              ${logo
                ? `<img src="${A}${logo}" alt="${name}" class="lazy">`
