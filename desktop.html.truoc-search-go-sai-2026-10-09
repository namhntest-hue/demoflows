   cây + facet của ngành đó (Làm đẹp → cây nước hoa + Dung tích; Nữ → cây nữ + Độ cao
   giày); không tick hoặc tick nhiều mục thì cây đủ.
   fsGenders = các mục đang tick TRONG panel (chưa Áp dụng); null = theo bộ lọc đã áp. */
let fsGenders = null;
const searchGenders = () => (fsGenders || plpFilters).filter(l => FILTER_GENDERS.includes(l));
function filterShape() {
  if (plpMode.type !== 'search') return { beauty: isBeautyPlp(), gender: plpGender(), heel: heelSection(), search: false, key: '' };
  const g = searchGenders();
  const one = g.length === 1 ? g[0] : null;
  const gender = one === 'Nam' || one === 'Nữ' ? one : null;
  return { beauty: one === 'Làm đẹp', gender, heel: gender === 'Nữ', search: true, key: g.join('+') };
}
