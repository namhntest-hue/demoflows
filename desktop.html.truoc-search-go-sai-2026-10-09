const orderToneMod = o => o.tone === 'cancel' ? ' is-off' : o.tone === 'muted' ? ' is-ok' : o.tone === 'pay' ? ' is-wait' : '';

/* THANH TOÁN LẠI (brief trang 55). 01/10/2026 — KHÁCH / USER CHỐT: thanh toán thất bại ở bên thứ 3 KHÔNG có trạng thái lỗi riêng, đơn vẫn "Chờ thanh toán" và chỉ có MỘT nút "Thanh toán lại" mở lại trang bên thứ 3.
