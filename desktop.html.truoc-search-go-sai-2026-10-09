/* Dừng cú hẹn "đang chuyển cổng" ở MỌI đường ra khỏi màn (xem khối MÀN CỔNG THANH TOÁN trong wire) — không dọn thì nó chạy ngầm rồi
   chốt thanh toán / quăng người dùng trở lại cổng khi họ đã ở màn khác (bấm Back giữa chừng). */
function payStopTimer() { if (payTimer) { clearTimeout(payTimer); payTimer = null; } }

/* Hết "đang chuyển cổng": ra kết cục theo công tắc paySim của bảng cài đặt demo — KHÔNG còn màn mã QR + nút "Tôi đã thanh toán" ở giữa (07/10/2026).
   Thất bại / hết phiên → màn tương ứng. Thành công → các đơn của nhóm sang "Đang xử lý": vừa đặt hàng → màn Hoàn tất; "Thanh toán lại" ở chi tiết đơn → về chi tiết đơn đó. */
function payResolve() {
  payTimer = null;
  if (current !== 'pay') return;
  if (paySim === 'fail')    { payStage = 'fail';    go('pay', { force: true }); return; }
  if (paySim === 'timeout') { payStage = 'timeout'; go('pay', { force: true }); return; }
  payMarkPaid(payFor); payStage = '';
  if (payFrom === 'checkout') { go('done'); return; }
  currentOrder = payFor[0] || currentOrder;
  toast('Đã thanh toán qua cổng Payoo');
  go('order', { force: true });
}

/* Bấm "Đặt hàng": trạng thái ĐANG XỬ LÝ rồi mới rẽ nhánh. Quãng chờ này có thật
   (máy chủ tạo đơn), và nó là chỗ duy nhất chặn cú bấm thứ hai. */
function startPayment(btn) {
  const root = document.querySelector('[data-screen="checkout"]');
  const sel = root && root.querySelector('#payOpts .opt.on');
  const method = sel ? sel.dataset.opt : 'cc';
  document.querySelectorAll('[data-nav="done"]').forEach(b => {
    b.disabled = true; b.dataset.busy = '1'; b.innerHTML = 'Đang xử lý…';
  });
  ckOrderEmail = ckEmail || (ckAuth ? PROFILE.email : '');
  setTimeout(() => {
    /* COD không đi qua cổng: đơn ra ngay ở "Đang xử lý", tiền thu lúc giao. 02/10/2026: đơn ghi đúng phương thức "Thanh toán khi nhận hàng" (trước đây mọi đơn mới ghi cứng thẻ tín dụng, nên đơn COD ra chi tiết đơn lại hiện "Thẻ tín dụng/Ghi nợ"). */
    if (method === 'cod') { placeOrder(false, 'Thanh toán khi nhận hàng'); go('done'); return; }
    /* Thanh toán online: đơn ra NGAY ở "Chờ thanh toán" rồi mới sang cổng (khách chốt 01/10/2026) — bỏ ngang / thất bại / hết phiên thì đơn vẫn nằm đó chờ "Thanh toán lại". */
    placeOrder(true);
    payEnter(ckOrderIds, 'checkout');
  }, 700);
}

/* Sang cổng thanh toán (bên thứ 3, mô phỏng bằng màn #pay) cho một nhóm đơn. `from`: 'checkout' (vừa đặt hàng → thành công sang màn Hoàn tất) hoặc 'order' ("Thanh toán lại" ở chi tiết đơn → thành công về chi tiết đơn). */
function payEnter(ids, from) {
  payFor = ids.slice(); payFrom = from;
  payStage = 'redirect';
  go('pay', current === 'pay' ? { force: true } : {});   // đứng sẵn ở #pay (Thử lại / Thanh toán lại ở trang thất bại, hết phiên) thì dựng LẠI chính màn đó
  payStopTimer();
  payTimer = setTimeout(payResolve, 1400);
}

/* Trả xong: các đơn của nhóm sang chặng 2 "Đang xử lý", giờ chặng 2 = lúc trả thật. */
function payMarkPaid(ids) {
  ids.forEach(id => {
    const o = ORDERS.find(x => x.id === id);
    if (!o || o.tone !== 'pay') return;
    o.status = 'Đang xử lý'; o.tone = 'info'; o.steps = 2;
    o.log = (o.log || []).slice(0, 1).concat(vnStamp());
  });
}

/* Đơn vừa đặt còn chờ thanh toán không — màn checkout đã đặt xong đọc để nói đúng trạng thái khi khách bấm Back từ cổng thanh toán. */
function ckPlacedUnpaid() {
  return ckOrderIds.some(id => { const o = ORDERS.find(x => x.id === id); return !!o && o.tone === 'pay'; });
}

/* Chốt đơn từ giỏ. `unpaid` = true: thanh toán online, đơn ra ở "Chờ thanh toán" (chặng 1) và còn phải qua cổng (startPayment → payEnter); mặc định (COD) ra thẳng "Đang xử lý" (chặng 2). `payName` (THÊM 02/10/2026, tuỳ chọn) = tên phương thức ghi vào đơn: COD truyền "Thanh toán khi nhận hàng", bỏ trống thì vẫn ghi "Thẻ tín dụng/Ghi nợ" như trước.
   01/10/2026 — KHÁCH CHỐT: giỏ có CẢ hàng có sẵn lẫn hàng đặt trước thì hệ thống TỰ TÁCH thành hai ĐƠN CON, một lần thanh toán: "<mã>-01" hàng có sẵn (nhận phí giao nhanh nếu chọn giao nhanh, quà kèm hàng có sẵn
   + quà theo mốc đơn / thương hiệu) và "<mã>-02" hàng đặt trước (giao thường miễn phí, quà kèm hàng đặt trước). Ưu đãi (điểm + giảm giá) chia theo tỉ lệ tạm tính (điểm chia theo điểm nguyên), phần dư dồn về đơn -02, nên tổng hai đơn con
   luôn bằng tổng giỏ. Giỏ chỉ có một loại hàng thì ra MỘT đơn, mã không hậu tố. Mã gốc ở ckOrderId (màn cổng thanh toán dùng làm "nội dung"), các mã đơn con ở ckOrderIds. */
function placeOrder(unpaid, payName) {
  ckPlaced = true;
  const baseId = 'DAFC1029' + (39 + ORDERS.length - 3);
  /* Chốt tổng NGAY lúc này: ngay dưới đây giỏ bị dọn rỗng nên cartSubtotal()
     sẽ về 0 — màn Hoàn tất phải in con số của đơn vừa đặt, không phải 0đ. */
  const orderSub = cartSubtotal(), orderDisc = cartDiscountTotal(), orderTotal = ckTotalNow();
  /* 28/09/2026 (rà soát brief trang 56) — tách tiền ĐIỂM khỏi "Giảm giá": khối tổng màn chi
     tiết đơn có hàng "Điểm thưởng" riêng, đọc `pointsUsed`. cartDiscountTotal() gộp điểm +
     voucher + PBH rồi chặn trần theo tạm tính, nên tiền điểm lấy không quá tổng đó; phần còn
     lại mới là "Giảm giá" — Tạm tính − Giảm giá − Điểm + Phí cộng ra đúng Tổng. Tiền điểm
     giữ ĐÚNG số giỏ đã trừ (rewardAmount): khi trần 10% tạm tính chặn thì nó không tròn
     nghìn nên pointsUsed có thể lẻ — nơi đọc duy nhất in TIỀN (pointsUsed × 1.000), không in
     số điểm; làm tròn xuống thì vài trăm đồng tiền điểm lại rơi sang dòng Giảm giá. */
  const orderPtsVnd = (ckAuth && cartReward === 'points') ? Math.min(rewardAmount('points'), orderDisc) : 0;
  /* Phí giao chốt ngay cùng tổng — sau dòng này giỏ bị dọn nên ckShipFee() vẫn đúng
     (nó không đọc giỏ) nhưng ckMode/ckShipFast thì lượt sau sẽ reset. */
  const pickup = ckMode === 'pickup', shipFee = ckShipFee();
  const orderShip = pickup ? 'Nhận tại cửa hàng' : (shipFee > 0 ? vndDot(shipFee) : 'Miễn phí');
  ckOrderTotal = vndCom(orderTotal);
  ckOrderPoints = rewardPointsEarned().toLocaleString('vi-VN');
  ckOrderGifts = activeGifts().map(pk => ({ pk, key: giftKeyOf(pk), g: giftOf(pk) }));
  ckOrderPre = (cartSelected().find(c => c.preorder) || {}).preorder || '';
  const a = (ckAuth && ckAddr !== 'new') ? (ADDRESSES[ckAddr] || null) : null;
  const st = storeInfo(ckStore);
  /* 02/10/2026 — người nhận của đơn giữ HỌ và TÊN tách riêng (last / first), không còn `name`; màn Chi tiết đơn + Theo dõi đơn ghép lúc in qua personName(). */
  const addr = pickup
    ? { ...(ckFirst || ckLast ? { last: ckLast, first: ckFirst } : { last: '', first: 'Khách nhận tại cửa hàng' }), phone: ckPhone, line: st ? `${st.name} · ${st.addr}` : '' }
    : { last: a ? a.last : ckShipLast, first: a ? a.first : ckShipFirst, phone: a ? a.phone : ckShipPhone,
        line: a ? addrLine(a) : [ckShipLine, ckWard, ckProvince].filter(Boolean).join(', ') };
  const stamp = vnStamp();
  /* Tách theo hàng đặt trước. Hàng sẵn ĐỨNG ĐẦU (-01), hàng đặt trước -02. Quà kèm sản phẩm theo món của nó; quà theo mốc đơn / thương hiệu đi với đơn -01. */
  const sel = cartSelected();
  const stdSel = sel.filter(c => !c.preorder), preSel = sel.filter(c => c.preorder);
  const split = stdSel.length > 0 && preSel.length > 0;
  const parts = split ? [stdSel, preSel] : [sel];
  const preGifts = new Set(preSel.map(c => c.gift).filter(Boolean));
  const subs = parts.map(list => list.reduce((n, c) => n + vndNum(c.now) * (c.qty || 1), 0));
  /* Chia ưu đãi: ĐIỂM chia theo số điểm NGUYÊN (1 điểm = REWARD_POINT_VALUE ₫, không có "756,4 điểm"), phần giảm giá còn lại (mã · phiếu · hạng) chia riêng theo tỉ lệ tạm tính; phần dư dồn về đơn -02. */
  const orderRestVnd = orderDisc - orderPtsVnd;
  const pts = [orderPtsVnd], rest = [orderRestVnd];
  if (split) {
    const r0 = subs[0] / (orderSub || 1);
    pts[0] = Math.round(orderPtsVnd / REWARD_POINT_VALUE * r0) * REWARD_POINT_VALUE; pts[1] = orderPtsVnd - pts[0];
    rest[0] = Math.round(orderRestVnd * r0); rest[1] = orderRestVnd - rest[0];
  }
  const ids = split ? [`${baseId}-01`, `${baseId}-02`] : [baseId];
  const built = parts.map((list, i) => {
    const first = i === 0, fee = first ? shipFee : 0, dsc = pts[i] + rest[i];
    return {
      /* 28/09/2026 (brief trang 55) — bộ chặng mới: đơn thanh toán online ra ở chặng 1 "Chờ thanh toán" (qua cổng xong mới sang "Đang xử lý"), đơn COD ra thẳng chặng 2; log ghi giờ tới từng chặng đã qua.
         `price: c.now` là ĐƠN GIÁ (cartSubtotal nhân qty) — đúng nghĩa it.price của ORDERS. */
      id: ids[i], status: unpaid ? 'Chờ thanh toán' : 'Đang xử lý', tone: unpaid ? 'pay' : 'info', date: stamp.split(' ')[0],
      items: list.map(c => ({ img: c.img, name: c.name, variant: c.variant, qty: c.qty, price: c.now, preorder: c.preorder })),
      /* Quà chốt lúc đặt hàng nay đi THEO ĐƠN, không chỉ hiện một lần ở màn Hoàn tất. */
      gifts: ckOrderGifts.filter(({ pk }) => !split || preGifts.has(pk) !== first).map(({ pk, key }) => ({ pk, key })),
      sub: vndDot(subs[i]), ship: first ? orderShip : (pickup ? 'Nhận tại cửa hàng' : 'Miễn phí'),
      discount: rest[i] ? '− ' + vndDot(rest[i]) : '', pointsUsed: pts[i] / REWARD_POINT_VALUE, total: vndDot(subs[i] - dsc + fee),
      payment: payName || 'Thẻ tín dụng/Ghi nợ',
      method: pickup ? 'Nhận tại cửa hàng' : (first ? (ckShipFast ? SHIP_NAME_FAST : SHIP_NAME_STD) : SHIP_NAME_STD),
      address: { ...addr },
      steps: unpaid ? 1 : 2, log: unpaid ? [stamp] : [stamp, vnStamp(2)],
      /* 01/10/2026 — VAT khách chọn ở checkout đi THEO ĐƠN (null = không xuất): màn Chi tiết đơn có mục "Thông tin VAT". */
      vat: orderVatSnapshot(),
    };
  });
  ORDERS.unshift(...built);   // -01 đứng trước -02: ORDERS[0] (nút "Xem chi tiết đơn hàng") là đơn hàng có sẵn
  ckOrderId = baseId; ckOrderIds = ids;
  // dọn giỏ: badge về 0 và màn Giỏ hàng hiện trạng thái rỗng
  CART.length = 0;
  cartQty = 0;
  document.querySelectorAll('.cart-badge').forEach(b => b.textContent = 0);
}

/* Tóm tắt bước giao hàng — đọc từ sổ địa chỉ hoặc từ chữ khách vừa gõ, thay
   cho chuỗi chết "User name - 0 1234 5678" trước đây (dù gõ gì cũng hiện y
   như vậy). Dùng chung cho lúc render màn và lúc cập nhật tại chỗ. */
function ckShipDoneHTML() {
  const a = (ckAuth && ckAddr !== 'new') ? (ADDRESSES[ckAddr] || null) : null;
  const name = a ? `${personName(a)} · ${a.phone}` : [personName({ last: ckShipLast, first: ckShipFirst }), ckShipPhone].filter(Boolean).join(' · ');
  const line = a ? addrLine(a) : [ckShipLine, ckWard, ckProvince].filter(Boolean).join(', ');
  return `
    <p class="t-multiline font-medium text-foreground">${name || 'Chưa có thông tin người nhận'}</p>
    ${line ? `<p class="t-multiline text-foreground">${line}</p>` : ''}`;
}

/* Cập nhật TẠI CHỖ phần tóm tắt khi người dùng đổi sang cửa hàng khác — thay
   vì dựng lại cả màn, để không mất chữ đang gõ ở ô họ tên/SĐT/email. */
function paintStore(root) {
  const done = root.querySelector('#ckStoreDone');
  if (done) { done.innerHTML = ckStoreDoneHTML(); localizeNew(done); }
}

function wireAddressPickers(root) {
  root.querySelectorAll('[data-pick]').forEach(btn => {
    btn.addEventListener('click', () => {
      /* ── Nhận tại cửa hàng: thành phố -> cửa hàng ──
         Cùng ràng buộc phụ thuộc như tỉnh -> phường: đổi thành phố là bỏ cửa
         hàng đang chọn, vì cửa hàng cũ không thuộc thành phố mới. */
      if (btn.dataset.pick === 'city') {
        window.__openPickDD(btn, DAFC_STORES.map(([c]) => c), ckCity, picked => {
          if (picked === ckCity) return;
          ckCity = picked; ckStore = '';
          // đổi thành phố -> danh sách cửa hàng đổi theo, khối thông tin thu lại
          // (chữ đã gõ vẫn còn vì 3 ô người nhận đọc/ghi vào state)
          rerenderCheckout(root);
          const cityBtn = root.querySelector('[data-pick="city"]');
          if (cityBtn) cityBtn.focus({ preventScroll: true });
        });
        return;
      }
      /* Tỉnh/thành người nhận đang sinh sống — chỉ có ở luồng nhận tại cửa
         hàng, dùng lại đúng danh sách tỉnh của địa chỉ giao hàng. */
      if (btn.dataset.pick === 'home') {
        window.__openPickDD(btn, VN_LOCATIONS.map(([pv]) => pv), ckHome, picked => {
          ckHome = picked;
          setPickLabel(btn, picked, 'Chọn tỉnh / thành phố');
        });
        return;
      }
      if (btn.dataset.pick === 'province') {
        window.__openPickDD(btn, VN_LOCATIONS.map(([pv]) => pv), ckProvince, picked => {
          ckProvince = picked; ckWard = '';
          setPickLabel(btn, picked, 'Chọn tỉnh / thành phố');
          const w = root.querySelector('[data-pick="ward"]');
          if (w) setPickLabel(w, '', 'Chọn phường / xã');
        });
        return;
      }
      if (!ckProvince) { toast('Chọn tỉnh / thành phố trước'); return; }
      const wards = (VN_LOCATIONS.find(([pv]) => pv === ckProvince) || ['', []])[1];
      /* 02/10/2026 (lệnh user: "thêm box Search ở Phường Xã tương tự thành phố") — { search: true }: ô Phường / xã LUÔN
         có ô Tìm kiếm như ô Tỉnh / thành phố (phường chỉ 4–7 mục nên luật "dài hơn 8" của dropdown không bật nó). */
      window.__openPickDD(btn, wards, ckWard, picked => {
        ckWard = picked;
        setPickLabel(btn, picked, 'Chọn phường / xã');
      }, { search: true });
    });
  });
}

