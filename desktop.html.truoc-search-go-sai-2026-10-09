/* 28/09/2026 — brief trang 55: bộ chặng theo đúng 4 chặng khách vẽ. Chặng đầu là "Chờ thanh toán" (không còn "Đã đặt hàng"): đơn qua cổng thanh toán bên thứ 3 có thể dừng ở đây.
   01/10/2026 — KHÁCH CHỐT QUY TRÌNH ĐẶT HÀNG (sơ đồ _notes/FLOWCHART-ORDER-STEP-2026-10-01.html): MỌI đơn đi đúng 4 chặng này, kể cả đơn hàng đặt trước — không có chặng riêng "Chờ hàng về" (đơn đứng ở "Đang xử lý" tới khi
   hàng về, thẻ giao hàng chỉ thêm dòng "Dự kiến giao"). Bộ 5 chặng ORDER_STEPS_PRE (06/09) đã gỡ. */
const ORDER_STEPS = ['Chờ thanh toán', 'Đang xử lý', 'Đang giao hàng', 'Đơn hàng hoàn tất'];

/* Timeline của đơn: mỗi chặng một dòng { label, time, state }. state: 'done' đã qua ·
   'cur' chặng hiện tại · 'todo' chưa tới · 'cancel'. Đơn huỷ giữ các chặng ĐÃ qua rồi
   thêm dòng "Đã huỷ" kèm giờ huỷ — các chặng chưa tới bỏ hẳn vì đơn không đi tiếp.
   time dạng 'dd/mm/yyyy hh:mm' — tách ngày/giờ bằng split(' ') khi vẽ. */
const orderTimeline = o => {
  const log = o.log || [];
  if (o.tone === 'cancel') return ORDER_STEPS.slice(0, o.steps)
    .map((label, i) => ({ label, time: log[i] || '', state: 'done' }))
    .concat({ label: 'Đã huỷ', time: o.cancelAt || '', state: 'cancel' });
  /* 29/09 từng có nhánh "đơn giao MỘT PHẦN" làm chặng "Chờ hàng về" mang chấm chạy song song với "Đang giao hàng"; gỡ 01/10/2026 — không đơn nào còn chặng đó (xem ORDER_STEPS). */
  return ORDER_STEPS.map((label, i) => ({
    label, time: i < o.steps ? (log[i] || '') : '',
    state: i < o.steps - 1 ? 'done' : (i === o.steps - 1 ? 'cur' : 'todo'),
  }));
};
/* Đơn đã tới chặng "Đang giao hàng" chưa — điều kiện hiện link "Xem chi tiết vận chuyển"
   (chưa giao thì chưa có mã vận đơn, màn tra cứu không có gì để mở). */
const orderShipped = o => o.tone !== 'cancel' && ORDER_STEPS.indexOf('Đang giao hàng') < o.steps;

