    if (!String(ckLast).trim())  miss.push([fld('plast'),  'Nhập họ người nhận']);
    if (!String(ckPhone).trim()) miss.push([fld('phone'), 'Nhập số điện thoại']);
  } else if (!(ckAuth && ckAddr !== 'new')) {
    if (!String(ckShipFirst).trim()) miss.push([fld('sfirst'), 'Nhập tên người nhận']);
    if (!String(ckShipLast).trim())  miss.push([fld('slast'),  'Nhập họ người nhận']);
