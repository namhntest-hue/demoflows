/* Pane "đang gõ" — BLOCK SẢN PHẨM dưới cùng (mobile + bản sao FLOW desktop): DANH SÁCH DỌC, mỗi hàng = ảnh + hãng + tên + giá, ĐÚNG khuôn
   hàng mini cart desktop (Figma 413:18646, hàm ccRow bên desktop.html): ảnh 79×106 đặt INLINE (utility w-[79px] không có trong tailwind.css
   build sẵn — cùng bẫy class chết đã dính 28/08), align-self:flex-start để cột chữ không kéo ảnh cao thêm; khe 12, đệm dọc 12; cột chữ cao tối
   thiểu bằng ảnh để GIÁ GHIM ĐÁY; hãng mượn hook .pc-brand (Libre ở skin-li, cùng vai tên hãng trên thẻ), tên t-multiline mực phụ + badge
   "Đặt trước" đứng trước như thẻ; giá .pc-price (đỏ khi giảm) + giá gạch + chip % như thẻ PLP. Kẻ ngăn giữa hàng thụt 16 (li mang mx-4, rule
   .search-prow + .search-prow) như #ccList. Lệnh user 06/10 lượt 7: "sản phẩm gợi ý là hình sản phẩm luôn nhé, xếp dọc giống cái mini cart cho
   bản mobile" — thay dải thẻ ngang 170 của lượt 6. Theo từ khoá ≤ 5 hàng; không khớp gì thì sản phẩm "gần với gợi ý" (searchRelated),
   rồi chip "Danh mục liên quan" XẾP CUỐI pane (07/10/2026, thứ tự user chốt). Tiêu đề + liên kết "Xem tất cả (N)" (= Enter với cụm tương ứng; không có cụm thì không có liên kết). Trả { key, html } —
   renderSearchSug() bỏ qua khi khoá không đổi để ảnh không nhấp nháy. Bấm hàng → PDP qua wireProductCards (data-product). */
function searchSugProductsHTML() {
  const q = searchQuery.trim();
  let prods = searchProducts(q), more = q, cats = [];
  if (!prods.length) { const r = searchRelated(q); prods = r.prods; more = r.query; cats = r.cats; }
  const list = prods.slice(0, 5);
  const key = `${LANG}|${more}|${prods.length}|${list.map(x => x.i).join(',')}|${cats.join(',')}`;
  const html = `
  <section class="flex flex-col py-4">
    <div class="flex items-center justify-between gap-2 px-4 py-2">
      <h2 class="t-single text-muted-foreground">Sản phẩm gợi ý</h2>
      ${more ? hmLink(`Xem tất cả (${prods.length})`, `data-suggest="${SEARCH_ESC(more)}"`) : ''}
    </div>
    <ul class="flex flex-col">${list.map(it => searchProductRowHTML(it)).join('')}</ul>
  </section>${cats.length ? `
  <section class="flex flex-col gap-3 py-4">
    <h2 class="t-single px-4 text-muted-foreground">Danh mục liên quan</h2>
    <div class="flex flex-wrap gap-2 px-4">${cats.map(searchChipHTML).join('')}</div>
  </section>` : ''}`;
  return { key, html };
}
function searchHistoryHTML() {
  if (!searchHistory.length) return '';
  return `
