/* Cụm tóm tắt (avatar · tên · số che) nằm NGOÀI `#accBody` nên không được vẽ lại
   theo tab; lưu thông tin xong phải sơn lại nó tại chỗ, nếu không màn hình vẫn
   nói tên cũ ngay phía trên bảng vừa sửa. */
function paintAccUser(root) {
  const box = (root || document).querySelector('#accUser');
  if (!box) return;
  box.innerHTML = accUserHTML();
  localizeNew(box);
}

/* Mở danh sách cho một Ô CHỌN của trang Tài khoản. Đây là DÒNG DUY NHẤT của khối
   này khác nhau giữa 2 file: mobile trượt bottom sheet #pickSheet lên (`__openPicker`),
