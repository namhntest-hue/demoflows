  const rule = /(?:type|inputmode)="email"/.test(attrs) ? 'email'
             : /(?:type|inputmode)="tel"/.test(attrs) ? 'phone'
             : /autocomplete="bday"/.test(attrs) ? 'dob' : '';
  return `
