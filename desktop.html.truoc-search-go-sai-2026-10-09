  html.skin-mt.theme-dplus { --unofficial-accent: #0a0a0a; --general-muted-foreground: #595959; --focus-ring: #595959; }
  /* `.cc-drop` phải đi kèm `.dk-modal`: tấm "Đã thêm vào giỏ" từ 19/08/2026 KHÔNG
