  /* ── 1. Token: đơn sắc trắng–đen–xám ── */
  html.skin-mt {
    --unofficial-body-background: #ffffff;
    --general-background: #ffffff;
    --general-background-blur: #fffffff2;
    --general-secondary: #f5f5f5;
    --general-muted: #f5f5f5;
    --unofficial-accent-0: #fafafa;
    --unofficial-border-0: #f2f2f2;
    --unofficial-secondary-hover: #e6e6e6;
    --unofficial-secondary-active: #ececec;
    --unofficial-accent-2: #ececec;
    --popover-popover: #0a0a0a;
    --popover-popover-foreground: #ffffff;
    /* mực ĐEN THẬT — nét khác rõ nhất so với bộ da MR PORTER (#1a1a1a) */
    --general-foreground: #0a0a0a;
    --general-primary: #0a0a0a;
    --general-primary-foreground: #ffffff;
    --general-primary-hover: #272727;
    /* 16/09/2026 — TRƯỚC #0a0a0a, nay #171717. Nền nghỉ của .btn-p CŨNG là #0a0a0a
       nên nhấn xuống không đổi gì: phản hồi duy nhất là lúc RỜI hover (#333333 về
       đen). Trên màn cảm ứng không có hover, tức nhấn hoàn toàn không phản hồi.
       #171717 lấy từ bảng gốc trong tokens.css, đủ khác để thấy mà không nhảy tông.
       (Phản hồi nhấn chỉ bằng màu — xem luật cấm hiệu ứng nhún khi nhấn.) */
    --general-primary-active: #171717;
    --general-secondary-foreground: #404040;
    --unofficial-foreground-alt: #0a0a0a;
    --unofficial-foreground-alt-2: #333333;
    --general-body-text: #0a0a0a;
    --unofficial-ghost-foreground: #333333;
    --unofficial-mid-alt: #666666;
    /* #666666 = 5.74:1 trên trắng, đạt AA cả chữ nhỏ */
    --general-muted-foreground: #727272;
    --unofficial-mid-deprecated: #666666;
    --unofficial-contrast: #0a0a0a;
    --general-border: #d3d3d3;
    --unofficial-border-1: #e6e6e6;
    /* 18/09/2026 — token `border-subtle` (gray/200) của bộ Color mới. Code trước
       nay chỉ có `--unofficial-border-1`, mà biến đó bị một rule phía sau ghim về
       #ececec CÓ CHỦ Ý (vách hàng danh sách + hàng danh mục trong menu). Figma
       cũng tách hai thứ: vách để #ececec, còn hộp khuyến mãi #e6e6e6. Nên khai
       riêng thay vì đi sửa chốt cũ. */
    --general-border-subtle: #e6e6e6;
    --unofficial-border-3: #cfcfcf;
    --unofficial-border-4: #999999;
    --unofficial-border-5: #666666;
    --unofficial-accent: #0a0a0a;
    --unofficial-accent-foreground: #ffffff;
    --unofficial-accent-3: #cfcfcf;
