  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes ringIn { from { transform: scale(.6); opacity: 0 } to { transform: scale(1); opacity: 1 } }
  .screen.active #ring { animation: ringIn .5s cubic-bezier(.22,1,.36,1) both; }
  .screen.active #tick { stroke-dasharray: 40; stroke-dashoffset: 40; animation: draw .5s .35s ease forwards; }
