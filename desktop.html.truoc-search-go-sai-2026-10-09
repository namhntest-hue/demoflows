/* Đích của một ô hub -> lưới PLP của hãng. 'all' · 'cate:<nhãn>' · 'scent:<từ>' · 'flag:<nhãn cờ>'. */
function brandHubGo(brand, go) {
  const [kind, ...rest] = String(go || 'all').split(':');
  const arg = rest.join(':');
  const mode = { type: 'brand', brand, all: true, filters: (kind === 'cate' || kind === 'flag') ? [arg] : [] };
  if (kind === 'scent') mode.scent = arg;
  /* Gắn ảnh chụp plpMode của HUB vào entry lịch sử đang đứng (state cũ + `plp`) TRƯỚC khi sang lưới — popstate đọc nó để Back từ
     lưới về đúng hub. replaceState chứ không pushState: không đẻ thêm entry. */
  try { window.history.replaceState({ screen: 'plp', plp: { ...plpMode } }, ''); } catch (e) { /* file:// hoặc iframe chặn */ }
  goPlp(mode);
}

/* Dải Bán chạy nhất: cùng khuôn hmRail (track + 2 mũi tên) nhưng badge theo TỪNG thẻ ("Mới về" cho SP cờ New arrival) nên không gọi
   hmRail được — hàm đó áp MỘT bộ option cho cả dải. Bỏ dòng hãng (cả trang đã là hãng đó); quick add rê chuột GIỮ để mua nhanh. */
