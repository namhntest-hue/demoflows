function toast(msg, act) {
  if (LANG === 'en') { const _t = tr(String(msg), 'en'); if (_t) msg = _t; }
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  let btn = document.getElementById('toastAct');
  if (btn) {
    const fresh = btn.cloneNode(false);
    fresh.id = 'toastAct';
    btn.replaceWith(fresh);
    btn = fresh;
    if (act && act.fn) {
      btn.textContent = LANG === 'en' ? (tr(act.label, 'en') || act.label) : act.label;
      btn.className = 'flex items-center pl-2 ml-1 border-l border-white/30 font-medium underline press';
      btn.addEventListener('click', () => { t.classList.add('hidden'); clearTimeout(toastT); act.fn(); });
    } else {
      btn.textContent = '';
      btn.className = 'hidden';
    }
  }
  t.classList.remove('hidden'); t.classList.remove('show'); void t.offsetWidth; t.classList.add('show');
  clearTimeout(toastT);
  toastT = setTimeout(() => t.classList.add('hidden'), act && act.fn ? 5000 : 1800);
}
/* ── Fly to cart ── */
function flyToCart(srcImg) {
  const target = document.querySelector('.cart-badge');
  if (!target || !srcImg) return;
  const s = srcImg.getBoundingClientRect(), t = target.getBoundingClientRect();
  const clone = srcImg.cloneNode();
  clone.className = 'fly';
  Object.assign(clone.style, { left: s.left + 'px', top: s.top + 'px', width: s.width + 'px', height: s.height + 'px' });
  clone.style.setProperty('--dx', (t.left - s.left + t.width / 2 - s.width / 2) + 'px');
  clone.style.setProperty('--dy', (t.top - s.top + t.height / 2 - s.height / 2) + 'px');
  document.body.appendChild(clone);
  setTimeout(() => clone.remove(), 760);
}
