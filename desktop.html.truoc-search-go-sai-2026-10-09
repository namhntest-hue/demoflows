}

/* MỘT handler UỶ QUYỀN gắn MỘT LẦN lên `#accBody`, không phải một listener cho mỗi
   nút. Lý do rất cụ thể: `wire()` được gọi lại trên nguyên `root` mỗi lần đổi tab,
   nên gắn thẳng vào nút thì cứ mỗi lượt lại chồng thêm một listener (bấm một cái
   chạy hai lần). `#accBody` thì chỉ bị thay `innerHTML`, bản thân nó sống suốt màn,
   nên cờ `dataset.accWired` chặn được việc gắn hai lần; đổi màn -> `#accBody` bị xoá
   -> cờ mất theo, không cần dọn tay. */
function wireAccount(root) {
  const body = root.querySelector('#accBody');
  if (!body || body.dataset.accWired) return;
  body.dataset.accWired = '1';

  /* Vẽ lại RIÊNG thân tab. Không gọi `wire(root)` như handler đổi tab đang làm: ở đây
     mọi thứ trong thân đều chạy bằng uỷ quyền, chỉ nút con mắt của ô mật khẩu là cần
     listener thật (nút cũ đã bị `innerHTML` xoá cùng node nên không sợ chồng). */
  const repaint = () => {
    body.innerHTML = accountBody();
    wirePasswordToggles(body);
    localizeNew(body);
  };

  const inp = k => body.querySelector(`[data-af="${k}"]`);
  const val = k => { const el = inp(k); return el ? el.value.trim() : ''; };
  /* Chạy lần lượt các luật, tô đỏ MỌI ô sai nhưng chỉ nhảy con trỏ tới ô sai ĐẦU
     TIÊN — đúng cách `validatePickup()` của checkout đang làm, dùng lại luôn cặp
     `setFieldErr` / `clearFieldErr` chứ không đẻ kiểu báo lỗi thứ hai. */
  const check = rules => {
    let first = null;
    rules.forEach(([k, ok, msg]) => {
      const el = inp(k);
      if (!el) return;
      if (ok(el.value)) { clearFieldErr(el); return; }
      setFieldErr(el, msg);
      if (!first) first = el;
    });
    if (first) { first.focus({ preventScroll: true }); first.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
    return !first;
  };
  /* 21/09/2026 — trỏ thẳng vào FIELD_RULE, không khai lại regex: một luật một nguồn. */
  const isPhone = FIELD_RULE.phone[0];
  const isEmail = FIELD_RULE.email[0];
  const isDob   = FIELD_RULE.dob[0];
  /* Ô tích vẽ bằng `.chk` chứ không phải `<input type=checkbox>`, nên trạng thái
     phải tự lật: class `.on` + `aria-checked`. Lật TẠI CHỖ chứ không repaint — repaint
     một cái ô tích là dựng lại cả thân tab. */
  const flip = (btn, on) => {
    btn.setAttribute('aria-checked', String(on));
    const box = btn.querySelector('.chk');
    if (box) box.classList.toggle('on', on);
  };

  body.addEventListener('click', e => {
    const btn = e.target.closest('[data-acc]');
    if (!btn) return;
    const act = btn.dataset.acc;
    const i = Number(btn.dataset.i);

    /* ── Mở / đóng form ──
       Mở form nào cũng dọn trạng thái của form kia trước: đang hỏi xoá một địa chỉ mà
       bấm "Sửa" thì câu hỏi xoá phải biến mất, không nằm lại ở hàng khác. */
    if (act === 'edit-info') { accResetForms(); accEdit = 'info'; accDraft.gender = PROFILE.gender; repaint(); return; }
    if (act === 'edit-pass') { accResetForms(); accEdit = 'pass'; repaint(); return; }
    if (act === 'cancel')    { accResetForms(); repaint(); return; }

    /* ── Nhận bản tin ── */
    if (act === 'news') {
      PROFILE.news = !PROFILE.news;
      flip(btn, PROFILE.news);
      toast(PROFILE.news ? 'Đã bật nhận bản tin' : 'Đã tắt nhận bản tin');
      return;
    }

    /* ── Lưu thông tin ── */
    if (act === 'save-info') {
      /* 20/09/2026 (brief trang 47) — chỉ còn HỌ và TÊN sửa được; 4 ô kia đã khoá
         nên không đọc, không kiểm và không ghi đè — kiểm một ô không tồn tại là
         `check` tự trượt và form không bao giờ lưu được. */
      if (!check([
        ['first', v => !!v.trim(), 'Vui lòng nhập tên'],
        ['last',  v => !!v.trim(), 'Vui lòng nhập họ'],
      ])) return;
      PROFILE.first = val('first');
      PROFILE.last  = val('last');
      PROFILE.name  = (PROFILE.last + ' ' + PROFILE.first).trim();
      accResetForms(); repaint();
      paintAccUser(root);        // tên + số che ở cụm tóm tắt phải đổi theo
      toast('Đã lưu thông tin');
      return;
    }

    /* ── Đổi mật khẩu ──
       Đọc `.value` THÔ (không trim) vì khoảng trắng là ký tự hợp lệ trong mật khẩu.
       Luật "khác mật khẩu hiện tại" tách ra ngoài `check()`: hai luật cùng gắn vào một
       ô thì luật sau chạy `clearFieldErr` và xoá mất lời báo của luật trước. */
    if (act === 'save-pass') {
      const cur = inp('cur') ? inp('cur').value : '';
      const nw  = inp('new') ? inp('new').value : '';
      const nw2 = inp('new2') ? inp('new2').value : '';
      if (!check([
        ['cur',  () => !!cur.trim(), 'Vui lòng nhập mật khẩu hiện tại'],
        ['new',  () => nw.length >= 8 && /[a-zA-Z]/.test(nw) && /\d/.test(nw), 'Mật khẩu cần tối thiểu 8 ký tự, gồm cả chữ và số'],
        ['new2', () => !!nw2 && nw2 === nw, 'Hai lần nhập chưa khớp'],
      ])) return;
      if (nw === cur) {
        setFieldErr(inp('new'), 'Mật khẩu mới phải khác mật khẩu hiện tại');
        inp('new').focus({ preventScroll: true });
        return;
      }
      accResetForms(); repaint(); toast('Đã đổi mật khẩu');
      return;
    }

    /* ── Sổ địa chỉ ── */
    if (act === 'addr-new') {
      accResetForms(); addrEdit = 'new'; accDraft = { province: '', ward: '', def: false };
      repaint(); return;
    }
    if (act === 'addr-edit') {
      const a = ADDRESSES[i];
      if (!a) return;
      accResetForms(); addrEdit = i; accDraft = { province: a.province, ward: a.ward, def: !!a.def };
      repaint(); return;
    }
    if (act === 'addr-del')    { addrDel = i;    repaint(); return; }
    if (act === 'addr-del-no') { addrDel = null; repaint(); return; }
    if (act === 'addr-del-yes') {
      const gone = ADDRESSES.splice(i, 1)[0];
      /* Xoá đúng địa chỉ mặc định thì phải có địa chỉ khác lên thay: sổ không còn cờ
         mặc định nào là checkout mở ra không chọn sẵn gì. */
      if (gone && gone.def && ADDRESSES.length) ADDRESSES[0].def = true;
      /* `ckAddr` trỏ theo VỊ TRÍ trong mảng, nên xoá xong phải kéo nó về trong tầm —
         nếu không, bước giao hàng của checkout đọc phải `undefined`. */
      if (typeof ckAddr === 'number') ckAddr = Math.min(ckAddr, Math.max(0, ADDRESSES.length - 1));
      addrDel = null; repaint(); toast('Đã xoá địa chỉ');
      return;
    }
    if (act === 'addr-def') {
      ADDRESSES.forEach((x, k) => { x.def = k === i; });
      repaint(); toast('Đã đặt địa chỉ mặc định');
      return;
    }
    if (act === 'addr-def-toggle') { accDraft.def = !accDraft.def; flip(btn, accDraft.def); return; }

    if (act === 'save-addr') {
      if (!check([
        ['afirst',  v => !!v.trim(), 'Vui lòng nhập tên'],
        ['alast',   v => !!v.trim(), 'Vui lòng nhập họ'],
        ['aphone',  isPhone,         'Số điện thoại chưa đúng'],
        ['aemail',  v => !!v.trim() && isEmail(v), 'Email chưa đúng'],   // 02/10/2026: bắt buộc như ô Email ở bước giao hàng (validateShipping), cùng câu báo lỗi
        ['astreet', v => !!v.trim(), 'Vui lòng nhập số nhà, tên đường'],
      ])) return;
      /* 2 ô CHỌN là <button> nên không gắn được `.fld-err` (class đó tô viền ô nhập) —
         báo bằng toast rồi trả con trỏ về đúng ô, cùng cách checkout đang chặn khi
         chưa chọn tỉnh. */
      const miss = !accDraft.province ? ['aprovince', 'Vui lòng chọn tỉnh / thành phố']
                 : !accDraft.ward     ? ['award',     'Vui lòng chọn phường / xã'] : null;
      if (miss) {
        toast(miss[1]);
        const el = body.querySelector(`[data-apick="${miss[0]}"]`);
        if (el) el.focus({ preventScroll: true });
        return;
      }
      const isNew = addrEdit === 'new';
      const keepDef = !isNew && !!(ADDRESSES[addrEdit] || {}).def;
      const rec = {
        first: val('afirst'), last: val('alast'), phone: val('aphone'), email: val('aemail'), street: val('astreet'),
        ward: accDraft.ward, province: accDraft.province, def: false,
      };
      if (isNew) ADDRESSES.push(rec); else ADDRESSES[addrEdit] = rec;
      const idx = isNew ? ADDRESSES.length - 1 : addrEdit;
      /* Cờ mặc định bật khi: đang sửa chính địa chỉ mặc định (giữ nguyên) · khách tích
         ô · hoặc đây là địa chỉ ĐẦU TIÊN của sổ (không có lựa chọn nào khác). */
      if (keepDef || accDraft.def || ADDRESSES.length === 1) ADDRESSES.forEach((x, k) => { x.def = k === idx; });
      accResetForms(); repaint(); toast(isNew ? 'Đã thêm địa chỉ' : 'Đã lưu địa chỉ');
      return;
    }
  });

  /* Ô CHỌN. Phường phụ thuộc tỉnh nên đổi tỉnh là XOÁ phường đang chọn — giữ lại sẽ ra
     một địa chỉ không tồn tại; ràng buộc này sao y `wireAddressPickers()` của checkout. */
  body.addEventListener('click', e => {
    const btn = e.target.closest('[data-apick]');
    if (!btn) return;
    const k = btn.dataset.apick;
    if (k === 'gender') {
      accOpenPick(btn, 'Chọn giới tính', GENDERS, accDraft.gender || '', v => {
        accDraft.gender = v;
        setPickLabel(btn, v, 'Chọn giới tính');
      });
      return;
    }
    if (k === 'aprovince') {
      accOpenPick(btn, 'Chọn tỉnh / thành phố', VN_LOCATIONS.map(([pv]) => pv), accDraft.province || '', v => {
        if (v === accDraft.province) return;
        accDraft.province = v; accDraft.ward = '';
        setPickLabel(btn, v, 'Chọn tỉnh / thành phố');
        const w = body.querySelector('[data-apick="award"]');
        if (w) setPickLabel(w, '', 'Chọn phường / xã');
      });
      return;
    }
    if (k === 'award') {
      if (!accDraft.province) { toast('Chọn tỉnh / thành phố trước'); return; }
      const wards = (VN_LOCATIONS.find(([pv]) => pv === accDraft.province) || ['', []])[1];
      /* 02/10/2026 — { search: true }: như ô phường của checkout, xem wireAddressPickers. */
      accOpenPick(btn, 'Chọn phường / xã', wards, accDraft.ward || '', v => {
        accDraft.ward = v;
        setPickLabel(btn, v, 'Chọn phường / xã');
      }, { search: true });
    }
  });
}

function wire(root) {
  /* 21/09/2026 — kiểm định dạng ngay khi rời ô; xem FIELD_RULE. */
  wireBlurCheck(root);
  wirePromoPeek(root);
  wirePasswordToggles(root);
  wireAddressPickers(root);
  wireAccount(root);
  // "Bảng kích thước" ở PDP / quick add -> mở bảng size thật trong info dialog
  // (03/09/2026 bỏ mũi tên "→" khỏi nhãn theo lệnh user; nút nay có underline)
  root.querySelectorAll('[data-size-chart]').forEach(b =>
    b.addEventListener('click', e => { e.stopPropagation(); openSizeChart(); }));

  // images fade-in
  wireLazy(root);

  // ── Search screen ──
  const searchInput = root.querySelector('#searchInput');
  if (searchInput) {
    const sugEl = root.querySelector('#searchSug');
    const prodEl = root.querySelector('#searchSugProducts');   // 06/10/2026: block thẻ dưới cùng (thay pane không-kết-quả)
    const emptyEl = root.querySelector('#searchEmpty');
    const clearBtn = root.querySelector('#searchClear');
    // hiện/ẩn pane có fade-rise nhẹ; gõ tiếp trong pane đang mở thì không chạy lại animation
    const setShown = (el, show) => {
      if (!el) return;
      if (!show) { el.style.display = 'none'; return; }
      if (el.style.display === 'none') {
        el.style.display = '';
        el.classList.remove('search-pane');
        void el.offsetWidth;
        el.classList.add('search-pane');
      }
    };
    // 3 khối theo Figma: gõ có kết quả → Gợi ý; gõ không kết quả → Gợi ý
    // ("Không tìm thấy kết quả") + Sản phẩm nổi bật; rỗng → lịch sử + trending
    const updatePanes = () => {
      const q = searchQuery.trim();
      if (clearBtn) clearBtn.style.display = searchInput.value ? '' : 'none';
      if (q) renderSearchSug(root);
      setShown(sugEl, !!q);
      setShown(prodEl, !!q);
      setShown(emptyEl, !q);
    };
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value;
      updatePanes();
    });
    // Enter -> màn kết quả tìm kiếm (PLP search; rỗng -> PLP-Mobile-07-Search-Empty)
    searchInput.addEventListener('keydown', e => {
      if (e.key !== 'Enter') return;
      const q = searchInput.value.trim();
      if (!q) return;
      searchHistoryAdd(q);
      searchQuery = q;
      goPlp({ type: 'search', query: q, title: `Kết quả tìm kiếm của “${q}”` });
    });
    if (clearBtn) clearBtn.addEventListener('click', () => {
      searchQuery = '';
      searchInput.value = '';
      updatePanes();
      searchInput.focus({ preventScroll: true });
    });
    searchInput.focus({ preventScroll: true });
    root.querySelectorAll('.search-tab').forEach(t => {
      t.addEventListener('click', () => {
        searchTab = +t.dataset.tab;
        root.querySelectorAll('.search-tab').forEach(x => {
          const on = x === t;
          x.style.borderBottom = `2px solid ${on ? 'var(--general-primary)' : 'transparent'}`;
          x.classList.toggle('font-medium', on);
          x.classList.toggle('text-foreground', on);
          x.classList.toggle('font-light', !on);
          x.classList.toggle('text-muted-foreground', !on);
        });
      });
    });
    wireSearchPane(root, sugEl);
    wireSearchPane(root, prodEl);
    wireSearchPane(root, emptyEl);
  }

  // promo banner slider (PLP) — tự trượt từng dòng mỗi 4s
  clearInterval(window.__promoTimer);
  const slider = root.querySelector('#promoSlider');
  if (slider) {
    let pIdx = 0;
    const n = PROMO_MESSAGES.length;
    window.__promoTimer = setInterval(() => {
      pIdx = (pIdx + 1) % n;
      slider.style.transform = `translateX(-${pIdx * 100}%)`;
    }, 4000);
  }

  // cart badges
  root.querySelectorAll('.cart-badge').forEach(b => b.textContent = cartQty);

  /* ── RÊ CHUỘT VÀO ICON GIỎ -> mở tấm tóm tắt giỏ (28/08/2026, lệnh user) ─────
     Gắn ở wire() vì navBar() DỰNG LẠI mỗi lần đổi màn, gắn một lần ở ngoài là
     mất listener ngay lần điều hướng đầu. Bấm vào icon vẫn sang màn giỏ như cũ
     (handler [data-nav] ngay dưới) — chỉ thêm việc đóng tấm để nó không đứng đè
     lên màn giỏ vừa mở. */
  root.querySelectorAll('[data-nav="cart"]').forEach(btn => {
    /* 25/09/2026 — rê từ icon Tài khoản sang là đóng NGAY tấm Tài khoản (lỗi user báo:
       sang icon giỏ mà tấm kia "vẫn còn hiện" — nó chờ 350ms mới đóng nên hai tấm chồng
       nhau). Không chờ nhịp trễ vì con trỏ đã chọn icon khác, không còn đang bắc cầu. */
    btn.addEventListener('mouseenter', () => { window.__closeAP && window.__closeAP(); window.__openCartPeek && window.__openCartPeek(btn); });
    btn.addEventListener('mouseleave', () => window.__closeCartPeek && window.__closeCartPeek());
    btn.addEventListener('click', () => window.__closeCartConfirm && window.__closeCartConfirm());
  });

  /* ── RÊ CHUỘT VÀO ICON TÀI KHOẢN -> mở panel đăng nhập/menu tài khoản
     (brief PDF trang 36, cùng kỹ thuật với mini-cart ngay trên — xem IIFE
     `#accPeek` gần cuối file). Bấm vào icon vẫn sang thẳng màn account/login
     như cũ (handler [data-nav] ngay dưới), chỉ thêm việc đóng panel lại.
     TRỪ khi đang Ở NGAY màn login/register (yêu cầu user 14/09/2026: "ở màn
     đăng nhập/đăng ký thì giữ nguyên cái header mặc định") — đứng sẵn trên
     đúng cái form đó rồi mà rê icon lại xổ thêm 1 bản rút gọn CỦA CHÍNH form
     đang xem là thừa/rối. `current === 'login'` gộp cả 2 vì đăng nhập lẫn
     đăng ký đều chung MỘT tên màn (`authView` mới là cái phân biệt 2 tab). */
  root.querySelectorAll('[data-acc-icon]').forEach(btn => {
    /* Chiều ngược của ghi chú ở icon giỏ ngay trên (25/09/2026): đóng NGAY tấm giỏ. */
    btn.addEventListener('mouseenter', () => { window.__closeCartConfirm && window.__closeCartConfirm(); if (current !== 'login') window.__openAccPeek && window.__openAccPeek(btn); });
    btn.addEventListener('mouseleave', () => window.__closeAccPeek && window.__closeAccPeek());
    /* 25/09/2026 (user): hover vẫn xổ panel như cũ, còn BẤM icon (đã đăng nhập) là
       vào thẳng tab "Thông tin cá nhân" — không giữ tab đứng lần trước. Chạy TRƯỚC
       handler [data-nav] bên dưới (đăng ký trước) nên go('account') đọc đúng tab;
       đang đứng sẵn ở màn account thì go thường sẽ nuốt lệnh nên phải force. */
    btn.addEventListener('click', () => {
      window.__closeAP && window.__closeAP();
      if (!ckAuth) return;
      accountTab = 'info'; memberView = ''; accResetForms();
      if (current === 'account') go('account', { force: true });
    });
  });

  // navigation
  /* THEO DÕI ĐƠN HÀNG — khai giống hệt bản mobile, xem ghi chú bên index.html.
     Vào từ nút "Theo dõi đơn hàng" của màn đơn thì mở THẲNG kết quả, không bắt gõ
     lại mã vừa nhìn thấy. */
  root.querySelectorAll('[data-track-open]').forEach(el => {
    el.addEventListener('click', () => {
      const id = el.dataset.trackOpen;
      trackQuery = id;
      const r = trackLookup(id);
      trackFound = r.order || null;
      trackErr = r.err || '';
      go('track');
    });
  });
  root.querySelectorAll('[data-track-go]').forEach(el => {
    el.addEventListener('click', () => {
      const inp = document.getElementById('trackInput');
      trackQuery = inp ? inp.value : '';
      const r = trackLookup(trackQuery);
      trackFound = r.order || null;
      trackErr = r.err || '';
      go('track', { force: true });
    });
  });
  root.querySelectorAll('[data-track-reset]').forEach(el => {
    el.addEventListener('click', () => {
      trackQuery = ''; trackFound = null; trackErr = '';
      go('track', { force: true });
    });
  });
  const trackInp = root.querySelector('#trackInput');
  if (trackInp && !trackInp.dataset.bound) {
    trackInp.dataset.bound = '1';
    trackInp.addEventListener('keydown', e => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const b = document.querySelector('[data-track-go]');
      if (b) b.click();
    });
  }

  root.querySelectorAll('[data-nav]').forEach(el => {
    el.addEventListener('click', e => {
      e.stopPropagation();
      const t = el.dataset.nav;
      /* 22/09/2026 — data-auth-view trên phần tử MÀN (vd nút "Tạo tài khoản" ở màn Hoàn tất):
         cùng quy ước với handler của menu sheet, để go('login') mở đúng tab thay vì luôn rơi
         về tab Đăng nhập (đo 22/09: nút đó mở tab login). */
      if (el.dataset.authView) { authView = el.dataset.authView; authViewIntent = true; }
      // Đổi dept phải ghi TRƯỚC khi điều hướng: navBar() dựng lại ngay trong go()
      // và subheader đọc dkDept để chọn bộ danh mục (thời trang vs làm đẹp).
      if (el.dataset.dkdept) dkDept = el.dataset.dkdept;
      /* ĐỨNG Ở TRANG CHỦ thì hàng ngành hàng đổi TRANG CHỦ, không nhảy sang PLP
         (07/09/2026 — cửa duy nhất vào trang chủ ngành Nữ).
         Vì sao đúng chứ không phải tiện: ở trang chủ, bấm một NGÀNH HÀNG nghĩa là "tôi
         đang xem hàng nữ", không phải "cho tôi danh sách sản phẩm". Ở PLP/PDP thì nút này
         vẫn là cửa PLP như đã chốt — nhánh này chỉ mở khi `current === 'home'`.
         Phải `force` vì tên màn không đổi; xem ghi chú trong `go()`. */
      if (current === 'home' && el.dataset.dkdept) { go('home', { force: true }); return; }
      /* Link trong mega panel / breadcrumb không có data-dkdept, nhưng crumbs[0]
         LÀ ngành hàng -> đồng bộ dept đang sáng. Trước đây bấm 'Quần áo' dưới cột
         'Nứ' mà hàng dept vẫn sáng 'Nam'; state đang chọn càng nổi thì cái lệch này
         càng lộ. Phải ở TRƯỚC goPlp()/go() vì navBar() dựng lại trong go() và đọc dkDept. */
      else {
        const c0 = (el.dataset.plpCrumbs || '').split('|')[0];
        if (DK_DEPTS.includes(c0)) dkDept = c0;
      }
      /* Reset để lặp lại demo: KHÔNG đụng ckAuth nữa — trước đây nút "Tiếp tục
         mua sắm" ở màn Hoàn tất âm thầm đăng xuất người đang đăng nhập. */
      if (el.hasAttribute('data-reset')) {
        cartQty = CART_BASE.length; CART.length = 0; CART.push(...CART_BASE.map(c => ({ ...c })));
        history = []; ckStep = 0; ckMaxStep = 0; ckMode = 'ship';
        ckShipPicked = false; ckShipFast = false;   // 04/10/2026 — chạy lại demo: dòng Phí vận chuyển về "--", dòng chọn sẵn về Giao hàng thông thường
        ckCity = ''; ckStore = ''; ckHome = ''; ckFirst = ''; ckLast = ''; ckPhone = ''; ckEmail = '';
        ckAddr = 0; ckAddrEdit = null; ckShipFirst = ''; ckShipLast = ''; ckShipPhone = ''; ckShipLine = '';
        ckPlaced = false; ckOrderId = ''; ckOrderIds = []; payFor = []; ckOrderTotal = ''; ckOrderPoints = ''; ckOrderGifts = []; ckOrderPre = '';
