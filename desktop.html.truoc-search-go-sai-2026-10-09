/* Size của từng SẢN PHẨM, lấy ĐÚNG BỘ CỦA PDP tương ứng (chốt 19/08/2026, yêu
   cầu user: "demo thực tế size theo bên trong pdp luôn").
   Trước đây dải size hover trên card dùng chung `SIZES` (39-44) cho mọi SP —
   sai với 3 SP: pdp2 là khăn (nay demo S / M / L — đổi 27/08), pdp3 là Onesize.
   `PDP_DATA[*].idx` chính là index trong PRODUCTS nên map thẳng được, KHÔNG đẻ
   thêm bảng size thứ hai — một nguồn duy nhất, sửa PDP là card đổi theo.
   SP#7-10 và hàng làm đẹp không có PDP riêng: xem `pcSizesOf` bên dưới. */
const SIZES_BY_PRODUCT = Object.fromEntries(Object.values(PDP_DATA).map(d => [d.idx, d.sizes]));
/* Trả về [{label, oos}] cho card index `i`:
     · hàng làm đẹp -> dung tích trong PRODUCTS[i].sizes, không có hàng nào hết;
     · SP có PDP    -> đúng bộ của PDP đó;
     · còn lại      -> bộ mặc định THEO LOẠI HÀNG (sizesOf): giày trong danh sách
       "Show more" cũng ra đủ 9 bậc như 3 màn giày, hàng may vẫn bộ SIZES. */
function pcSizesOf(p, i) {
  /* capSizes: lớp size hover trên card cũng chịu trần SIZE_MAX_SHOWN của luật
     28/08. Lưới của nó vẫn 4 cột (.pc-sizes) — hẹp hơn trần 5 ô/dòng nên KHÔNG
     phạm luật; đổi 4 -> 5 ở đây phải tính lại bề rộng ô trong tấm hover, nói
     một tiếng nếu muốn ép cả tấm đó về đúng 5. */
  if (p.sizes && p.sizes.length) return capSizes(p.sizes).map(label => ({ label, oos: '' }));
  return capSizes(SIZES_BY_PRODUCT[i] || pdpSizes(sizesOf(p)));
}

/* TRẢ GÓP — "Trả trước từ … /tháng · Xem chi tiết" nằm NGAY DƯỚI nút Thêm vào
   giỏ hàng và CĂN GIỮA (chốt 18/08/2026, yêu cầu user; trước đó khối này nằm
   sát dưới giá trong header). Áp dụng cho MỌI loại PDP.
   Chỉ sản phẩm KHÔNG pre-order mới hiện — đặt trước không áp dụng trả góp, nên
   nhánh preorder của `cta` không gọi hàm này (PDP_DATA.pdp cũng để installment
   rỗng, 2 lớp chặn cùng chiều).
   Khối BẮT BUỘC là con trực tiếp của #pdpCta: setCta() tìm nó bằng cách quét
   [...cta.children] theo chữ "Trả trước" để ẩn khi size chọn đang hết hàng. */

/* ── TRẢ GÓP: ngưỡng + công thức (brief khách 30/09) ──
   Hàng "Trả góp từ …/tháng" chỉ hiện khi giá hiện hành > 3.000.000 ₫ và SP không
   pre-order. Số tiền = giá / kỳ hạn (làm tròn nghìn) — nguồn DUY NHẤT là PRODUCTS.price,
   không còn bộ số demo cứng. Popup chi tiết: #instSheet (bottom sheet mobile · drawer phải desktop). */
const INST_MIN = 3000000;
const INST_TERMS = [[3, false], [6, false], [9, true], [12, true]];   // [số tháng, có thể phát sinh phí]
const instPriceOf = p => parseInt(String(p.price).replace(/\D/g, ''), 10) || 0;
const instMonthly = (price, n) => Math.round(price / n / 1000) * 1000;
const instFmt = n => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, '.') + ' ₫';
const payOfferRow = idx => {
  const p = PRODUCTS[idx];
  if (!p || p.preorder) return '';
  const price = instPriceOf(p);
  if (price <= INST_MIN) return '';
  return `
      <div class="t-single flex items-center justify-center gap-1 pt-2">
        <span class="text-foreground-alt">Trả góp từ <b class="font-medium">${instFmt(instMonthly(price, 12))}</b>/tháng</span>
        <button data-inst="${idx}" class="text-foreground underline press">Xem chi tiết</button>
      </div>`;
};

