  .tier-cond { max-width: 420px; opacity: .8; }
  .tier-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .tier-lb  { opacity: .7; letter-spacing: 1px; }
  .tier-sub { opacity: .7; }

