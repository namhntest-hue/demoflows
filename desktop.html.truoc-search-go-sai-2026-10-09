/* NHÁNH A: ô thương hiệu nhỏ. ẢNH DÙNG LẠI ĐÚNG CẶP `hero` + `pos` của trang thương hiệu,
   có chủ ý: cặp đó đã được canh tay cho dải NGANG 1377x320 (~4,3/1) ở màn brand. Ô đây cao
   160 nên ở khổ 1440 ra 676x160 = 4,2/1 — gần như CÙNG một phép cắt, `pos` chuyển sang là
   dùng được luôn, không phải canh lại một crop mới.
   VÌ SAO KHÔNG lấy ảnh người mẫu 3/4 như ô spotlight: ô 676 mà cao 3/4 là 901 — cao hơn cả
   ảnh spotlight (613), tức "brands nhỏ nhỏ" lại to hơn thứ nó phụ thuộc. Ô cao 160 + 16 khe
   + 22 wordmark = ~198, đúng vai phụ.
   TRẦN WORDMARK 22px là SỐ TUYỆT ĐỐI (chốt khách 27/08) — dùng lại y nguyên của hàng 5 thẻ
   nên 2 hàng thương hiệu trên trang đứng chung một trục quang học.
   Dòng đếm đi luật i18n có sẵn [/^(\d+) sản phẩm$/, '$1 products'] — không thêm khoá. */
/* BẢNG ĐÈ ẢNH cho ô thương hiệu (đồng bộ bản mobile 08/09). Để rỗng một hãng là hãng đó rơi
   về `BRAND_PAGES`. `brand-spotlight-2` là tấm BALMAIN, `-3` là VERSACE (tấm khắc chữ VERSACE
   trên món kim khí). Có ảnh Ferragamo thì thêm MỘT dòng vào đây.
   (Bảng LOGO đi kèm đã gỡ 15/09 — xem ghi chú ngay dưới.) */
/* 28/09/2026 — THEO VỊ TRÍ Ô, không theo tên hãng: ô 1 (đang là Balmain) = ...-brand-01, ô 2 (Versace) =
   ...-brand-02. Đổi hãng trong HM_SPOT_BRANDS thì chỉ thay file, không sửa bảng này. */
const HM_SPOT_BRAND_IMG = [
  'home-{nganh}-spotlight-brand-01.jpg',
  'home-{nganh}-spotlight-brand-02.jpg',
];

/* ĐÃ GỠ 15/09/2026 — `HM_SPOT_BRAND_LOGO` (bảng đè file logo cho ô thương hiệu). Lệnh user:
   *"k dùng png nữa dùng font ghi chữ như mục cate ở trên của homepage luôn"*. Khối này nay
   LUÔN vẽ tên hãng bằng chữ, hết nhánh <img>, nên bảng đó là một cửa cắm không dẫn đi đâu.
   Bảng ẢNH `HM_SPOT_BRAND_IMG` ngay trên VẪN dùng — đó là chỗ cắm ảnh nền của ô. */

function hmSpotBrands(avoidImg) {
  /* MỘT ROSTER CHO CẢ 2 NGÀNH (09/09/2026 — lượt clone bản Nữ từ bản Nam). Trước đây nhánh
     Nữ đọc `HM_SPOT_BRANDS_NU` và thêm class lưới 3 cột; cả hai đã hết việc: 2 bảng hãng
     TRÙNG NHAU từ 08/09 (cùng `['Balmain', 'Versace']`), nên trên bản Nữ đo được 2 ô nằm
     trong lưới 3 cột — hàng bỏ trống đúng một phần ba bề ngang. */
  const tiles = hmSpotBrandList().map((name, i) => {
    /* Chốt chặn chỉ đòi ẢNH (đồng bộ bản mobile 08/09): hãng chưa có trong `BRAND_PAGES` và
       chưa có sản phẩm vẫn dựng được ô. Tên hãng LUÔN vẽ bằng chữ từ 15/09 nên `B.logo`
       thôi được đọc ở đây. */
    const B = brandPage(name);
    const hero = HM_SPOT_BRAND_IMG[i] ? hmFile(HM_SPOT_BRAND_IMG[i]) : B.hero;
    if (!hero) return '';
    /* Ô KHÔNG ĐƯỢC ĐI ĐÚNG TẤM ẢNH CỦA SPOTLIGHT. Bẫy thật: `BRAND_PAGES['Versace'].hero`
       là `p1-1.jpg`, đúng tấm mà spotlight đang dùng — nên ở bản Nữ (có ô Versace) hai tầng
       của cùng một mục sẽ vẽ cùng một ảnh. Rơi về ảnh người mẫu KHÁC của chính hãng đó. */
    let img = hero;
    if (avoidImg && img === avoidImg) {
      const alt = PRODUCTS.find(p => p.brand === name && p.model && p.model !== avoidImg);
      if (alt) img = alt.model;
    }
    return `<a data-nav="plp" data-plp-brand="${name}" class="hm-spot-brand block cursor-pointer press">
              <img src="${A}${img}" alt="${B.name}" class="hm-spot-brand-photo w-full object-cover lazy" style="object-position:${B.pos || '50% 50%'}">
              <span class="hm-spot-brand-veil" aria-hidden="true"></span>
              <!-- Ô CHỈ CÓ WORDMARK (đồng bộ bản mobile 08/09, theo mock user): bỏ dòng
                   "N sản phẩm" — và đó cũng là điều kiện để bày được hãng chưa có dữ liệu SP. -->
              <div class="hm-spot-brand-cap">
                <!-- LUÔN VẼ TÊN HÃNG BẰNG CHỮ (15/09/2026, lệnh user: k dùng png nữa,
                     dùng font ghi chữ như mục cate ở trên của trang chủ). Nhánh img đã gỡ
                     cùng bảng HM_SPOT_BRAND_LOGO, nên ô Versace — hãng DUY NHẤT còn file
                     logo trong kho — nay cũng đọc ra cùng một hệ chữ với 2 ô kia.
                     Mặt chữ và cỡ do rule .hm-brand-text lo: Libre Bodoni chữ thường, đúng
                     bậc nhãn ô danh mục của từng khổ. Lý lẽ đầy đủ ghi ở rule đó. -->
                <p class="hm-brand-text text-primary-foreground">${B.name}</p>
              </div>
            </a>`;
  }).filter(Boolean);
  if (tiles.length < 2) return '';
  return `<div class="hm-spot-brands">${tiles.join('')}</div>`;
}

function hmMaison() {
  const B = brandPage(hmMaisonName());
  const all = PRODUCTS.map((p, i) => ({ p, i }))
    .filter(({ p }) => p.brand === hmMaisonName() && p.model);
  const spot = all[0], list = all.slice(1, 4);
  /* Điều kiện dựng phải THEO NHÁNH đang bật. Trước đây luôn đòi 3 sản phẩm, kể cả khi tầng 2
     là 2 ô thương hiệu — bẫy ngủ: đổi HM_MAISON sang một hãng chỉ có 1-2 ảnh người mẫu là cả
     khối biến mất im lặng dù nhánh 'brands' không dùng tới `list`. Ảnh spotlight thì vẫn cần
     `all[0]` nên `spot` là điều kiện chung. */
  /* Ảnh spotlight: ưu tiên `HM_SPOT_IMG` (hãng chưa có SP trong kho vẫn dựng được khối). */
  const spotImg = HM_SPOT_IMG ? hmFile(HM_SPOT_IMG) : (spot && spot.p.model);
  const spotAlt = HM_SPOT_IMG ? hmMaisonName() : (spot && spot.p.name);
  if (!spotImg || (HM_SPOT_BELOW !== 'brands' && list.length < 3)) return '';
  const attrs = `data-nav="plp" data-plp-brand="${hmMaisonName()}"`;
  /* KHỐI SPOTLIGHT THÔI CÓ TIÊU ĐỀ VÀ NÚT (07/09/2026, lệnh user: *"bỏ title Brands of
     the moment và button view all ra"*). Không đi qua `hmSec` nữa — giữ đúng nhịp dọc của
     nó để khoảng cách với 2 mục kề không đổi.
     Đọc ra được vì sao: sau lượt đưa chữ VÀO TRONG ảnh, khối đã tự có wordmark + nhãn
     "Bộ sưu tập chính" + headline nằm trên tấm; thêm một dòng tiêu đề bên trên là khối nói
     tên mình hai lần. Đây là khối thứ BA trên trang bỏ đầu mục theo cùng lý lẽ (sau dải
     danh mục và khối Lựa chọn theo mùa). */
  return `
      <!-- flex flex-col gap-6 là BẮT BUỘC, không phải trang trí: nó là khe 24 giữa các
           con của một mục, và mọi mục đi qua hmSec đều có. Lượt bỏ đầu mục 07/09 chép lại
           pt-8 mà rơi mất 3 class này -> tấm spotlight và hàng ô thương hiệu DÍNH NHAU
           (đo được khe = 0, user báo). Khối danh mục và khối theo mùa không lộ vì chỉ có
           MỘT con — nhưng đã vá luôn cả hai, kẻo thêm con thứ hai là dính y hệt. -->
      <div class="px-6 py-8 reveal">
      <!-- DAU MUC CANH GIUA 'Brand Spotlights' (09/09/2026, lenh user). KHONG di qua
           hmSec duoc: khung cua hmSec cap gap-6 cho moi con, ma RUOT khoi nay phai giu
           khe 4px (chot 07/09) giua anh spotlight va hang o thuong hieu. Nen khung ngoai
           doi sang gap-6 (= khe dau muc -> noi dung, dung con so cua moi muc khac tren
           trang) roi BOC RIENG phan ruot vao mot cot gap-1. Chu thi lay tu hmSecHead,
           tuc dung y mot khuon voi cac muc di qua hmSec. -->
        <div class="pt-8 flex flex-col gap-6">
      <!-- CTA "Xem tất cả" TRẢ LẠI 24/09/2026 (lệnh user kèm ảnh + khung Figma 491:19560:
           *"thêm CTA xem tất cả ở thương hiệu và danh mục"*). Đảo lệnh 07/09 vốn bỏ cả tiêu
           đề lẫn nút; lượt 09/09 đã trả tiêu đề, lượt này trả nốt nút.
           Dùng lại hmLink — KHÔNG dựng nút mới: đó đúng khuôn "Xem tất cả" mà mục
           "Hàng mới về" ngay trên đang dùng (12/18 gạch chân, không phải nút viền), nên ba
           mục của trang đọc ra cùng một hạng.
           ⚠ CTA NÀY TRỎ CÙNG ĐÍCH VỚI 2 NÚT ANH EM trong khối (ảnh + "Mua ngay"), tức
           lọc theo HM_MAISON. Đo 24/09/2026: HM_MAISON là Ferragamo mà kho có 0 sản phẩm của
           hãng này (Versace 19 · Dolce&Gabbana 14 · Zimmermann 12 · Montblanc 2 · Moschino 1),
           nên cả BA chỗ bấm đều rơi vào PLP RỖNG. Khối dựng được là nhờ HM_SPOT_IMG — một ảnh
           chọn tay — chứ không nhờ dữ liệu SP.
           Đây là LỖI CÓ SẴN của khối, không phải của CTA: nút "Mua ngay" đã rơi vào đó từ
           trước. ĐÃ THỬ cho riêng CTA né sang PLP thường rồi BỎ — né một chỗ mà hai chỗ kia
           vẫn rỗng thì chỉ làm khối tự mâu thuẫn. Cách chữa đúng là ở DỮ LIỆU: hoặc thêm SP
           Ferragamo, hoặc đổi HM_MAISON sang hãng đã có SP. Đã báo user 24/09. -->
        ${hmSecHead(HM_SPOT_TITLE, hmLink('Xem tất cả', attrs), 'h2', 'Tâm điểm thương hiệu')}
          <!-- CAP O: 1 DOC + 2 NGANG dat CANH NHAU (10/09/2026, lenh user). Khe 4px giua
               hai cot nay la grid-gap cua .hm-spot-pair, khong con la gap-1 cua mot cot
               flex (khe 4px chot 07/09, lenh user: *"highlight brand cach 2 brand nho ben
               duoi 4px"*).
               VAN GIU nhanh flex cho truong hop HM_SPOT_BELOW = products: nhanh do bay 3
               the san pham thay cho 2 o thuong hieu, va 3 the thi phai nam DUOI mot tam
               spotlight rong chu khong ep vao mot cot 743 duoc. -->
        <div class="${HM_SPOT_BELOW === 'brands' ? 'hm-spot-pair' : 'flex flex-col gap-1'}">
          <div class="hm-spot">
            <a ${attrs} class="hm-spot-photo overflow-hidden bg-secondary cursor-pointer press">
              <!-- KHONG CON object-position (10/09/2026): khung 3/4 dung bang ti le tep
                   1080x1440 nen object-cover cat 0 pixel, tuc khong con phep cat nao de
                   canh. Bo luon chu thich "canh TREN" cua ban 1377x360 — do la so do cua
                   bang ngang cu, chi giu 19,6% chieu cao nen phai ngam vao mat va vai. -->
              <img src="${A}${spotImg}" alt="${spotAlt}" class="w-full h-full object-cover lazy">
            </a>
            <span class="hm-spot-veil" aria-hidden="true"></span>
            <div class="hm-spot-copy">
              <div class="flex flex-col gap-2">
                <p class="t-single text-primary-foreground">${HM_SPOT_EYEBROW}</p>
                <!-- Tên hãng LUÔN bằng chữ từ 15/09/2026 (nhánh img h-7 w-[149px] đã gỡ) —
                     xem ghi chú ở ô thương hiệu nhỏ, hmSpotBrands. -->
                <p class="hm-brand-text text-primary-foreground">${B.name}</p>
              </div>
              <!-- DONG NAY LA INTER, khong phai Libre (08/09/2026, lenh user: *"subtitle cua
                   brand highlight Ferragamo o ban desktop cho chu inter thoi, hien tai dang
                   libre toan bo"*).
                   Vi sao truoc no ra Libre: chuoi text-[18px] font-medium leading-7 la HOOK
                   duy nhat dan len bac trung bay cua bo da, nen no keo ca mat chu Libre 24/32.
                   Dong nay khong phai tieu de — no la cau mo ta duoi wordmark, tuc THAN BAI.
                   Nay dung t-lead (14/20 Inter) — DUNG class ban mobile dang dung cho cung
                   dong nay, nen 2 ban thoi lech nhau. Wordmark FERRAGAMO thi VAN Libre. -->
              ${hmBeauty() ? '' : `<p class="t-lead text-primary-foreground">${HM_SPOT_HEADLINE}</p>`}
              ${HM_MAISON_COPY ? `<p class="t-multiline text-primary-foreground">${HM_MAISON_COPY}</p>` : ''}
              <button ${attrs} class="t-lead h-12 px-8 w-fit border border-border bg-background text-foreground btn-o btn-oi press">Mua ngay</button>
            </div>
          </div>
          <!-- Tầng 2 của khối. Brief khách cho chọn 1 trong 2; xem HM_SPOT_BELOW.
               Nhánh B = sản phẩm CỦA CHÍNH bộ spotlight, không phải hãng khác. -->
          ${HM_SPOT_BELOW === 'brands' ? '' : `
          <div class="hm-spot-row">
            ${list.map(({ p, i }) => productCard(p, i, { noColors: true, noName: true, noQuick: !HM_SHOW.quickAdd, quickPerRow: HM_QUICK_PER_ROW, quickMaxRows: HM_QUICK_MAX_ROWS, model: true })).join('')}
          </div>`}
          ${HM_SPOT_BELOW === 'products' ? '' : hmSpotBrands(spotImg)}
        </div>
        </div>
      </div>`;
}

/* ── 5 THẺ THƯƠNG HIỆU 259×128 ─────────────────────────────────────────────────
   Tên viết Y HỆT `PRODUCTS[].brand` — nhánh `brand` của `plpProducts()` lọc THẬT nên
   đây là 5 cửa duy nhất trên trang nói đúng dữ liệu (19 + 14 + 12 + 2 + 1 = 48 SP).
   Kho CHỈ có 3 wordmark; Montblanc và Moschino đi bằng CHỮ, không mượn logo hãng khác
   gán vào (đó là sai dữ liệu, không phải sai đẹp). Cả 5 ô cùng trần 22px nên hàng đứng
