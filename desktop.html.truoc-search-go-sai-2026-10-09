function splitByHeader(items) {
  const out = [];
  let cur = { title: '', items: [] };
  for (const it of items) {
    if (it && it.header) { if (cur.items.length) out.push(cur); cur = { title: it.header, items: [] }; }
    else cur.items.push(it);
  }
  if (cur.items.length) out.push(cur);
  return out;
}

/* Panel mega menu cho 1 mục subheader — cột nội dung + teaser ảnh phải.
   `id` khớp với data-mega của nút tương ứng: panel render tách khỏi thanh cuộn
   nên không còn quan hệ cha-con để CSS :hover bắt được, phải nối bằng id. */
/* ẢNH CỦA MEGA PANEL — 02/10/2026, theo Figma "Section 2" (1078:59576) của user.
   Panel CỐ ĐỊNH 440 cao, lưới 4 cột đều 330 khe 24, đệm ngang 24; ảnh chạy suốt chiều cao panel, không CTA.
     3 cột chữ        -> 1 hình DỌC 3:4 (330x440) ở cột 4
     2 cột chữ        -> 2 hình dọc ở cột 3 và 4
     ≤1 cột chữ       -> NGẪU NHIÊN: 1 hình ngang lớn (684x440, cột 3-4) hoặc 2 hình dọc
     ≥4 cột chữ       -> không ảnh (Chăm sóc cơ thể & tóc: 5 cột 259)
   Ảnh lấy NGẪU NHIÊN từ bộ ảnh trang chủ cho đỡ lặp; chọn một lần rồi nhớ (DK_MEGA_PICK) để panel không đổi ảnh mỗi lần mở. */
const DK_MEGA_POOL_PORT = [];
const DK_MEGA_POOL_LAND = [];
['men', 'women', 'beauty'].forEach(n => {
  [1, 2, 3].forEach(k => DK_MEGA_POOL_PORT.push(`home-${n}-occasion-0${k}.jpg`));
  [1, 2, 3, 4].forEach(k => DK_MEGA_POOL_PORT.push(`home-${n}-category-0${k}.jpg`));
  [1, 2].forEach(k => { DK_MEGA_POOL_LAND.push(`home-${n}-hero-0${k}-desktop.jpg`); DK_MEGA_POOL_LAND.push(`home-${n}-spotlight-brand-0${k}.jpg`); });
});
const DK_MEGA_PICK = {};
function dkMegaPick(key, pool, avoid) {
  if (!DK_MEGA_PICK[key]) {
    const rest = pool.filter(f => f !== avoid);
    DK_MEGA_PICK[key] = rest[Math.floor(Math.random() * rest.length)];
  }
  return DK_MEGA_PICK[key];
}
function dkMegaTile(item, file, col) {
  return `
      <button ${dkCatAttrs(item.label)} class="dk-mega-hero block text-left press group h-full" style="grid-column:${col};max-height:440px">
        <span class="block w-full h-full overflow-hidden bg-secondary">
          <img src="${A}${file}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" alt="${item.label}">
        </span>
      </button>`;
}
/* 08/10/2026 (user giao thư mục Drive "Menu"): ảnh CỐ ĐỊNH cho 3 menu Làm đẹp — thay ảnh ngẫu nhiên của kho trang chủ. Khoá = `${ngành}|${nhãn mục}`. 2 ảnh ⇒ hai hình dọc; 1 ảnh ⇒ hình dọc ở cột 4 (panel 3 cột) hoặc hình ngang cột 3-4 (panel 1 cột). */
const DK_MEGA_FIXED = {
  'Làm đẹp|Nước hoa': ['megamenu-mb-perfume.jpg'],
  'Làm đẹp|Dành cho nam': ['megamenu-mb-men-2.jpg', 'megamenu-mb-men-3.jpg'],
  'Làm đẹp|Hương thơm không gian': ['megamenu-mb-home-fragrance.jpg'],
  'Làm đẹp|Bộ sưu tập': ['megamenu-mb-collection-1.jpg', 'megamenu-mb-collection-2.jpg'],   // 08/10: Collection 1 + 2 (Drive, vuông 594/681 — cắt dọc 3:4 theo ô)
};
function dkMegaImages(item, ncols) {
  const k = `${dkDept}|${item.label}`;
  const fx = DK_MEGA_FIXED[k];
  if (fx) {
    if (fx.length >= 2) return dkMegaTile(item, fx[0], '3') + dkMegaTile(item, fx[1], '4');
    return dkMegaTile(item, fx[0], ncols >= 3 ? '4' : '3 / span 2');
  }
  const port = (slot, avoid) => dkMegaPick(`${k}|p${slot}`, DK_MEGA_POOL_PORT, avoid);
  if (ncols >= 3) return dkMegaTile(item, port(1), '4');
  let mode = '2';
  if (ncols <= 1) {
    if (!DK_MEGA_PICK[`${k}|mode`]) DK_MEGA_PICK[`${k}|mode`] = Math.random() < 0.5 ? '1' : '2';
    mode = DK_MEGA_PICK[`${k}|mode`];
  }
  if (mode === '1') return dkMegaTile(item, dkMegaPick(`${k}|l`, DK_MEGA_POOL_LAND), '3 / span 2');
  const a = port(1);
  return dkMegaTile(item, a, '3') + dkMegaTile(item, port(2, a), '4');
}

function dkMegaPanel(item, id) {
  let cols = '';
  let nc = 0;   // số cột nội dung của panel này (>3 thì lưới nới ra, xem style ở dk-mega-grid)
  let ncols = 3;   // số cột CHỮ của panel (quyết định cách đặt ảnh, xem dkMegaImages)
  if (item.newIn) {
    /* 01/10/2026 (lệnh user): "Sản phẩm mới" chỉ vẽ cột của NGÀNH ĐANG SÁNG (Nam hoặc Nữ), bỏ cột giới tính kia —
       hàng ngành ở trên đã chọn giới tính, giống 5 danh mục thời trang. Còn 2 cột nội dung (Bộ sưu tập mới + ngành)
       nên panel này dùng khối ảnh lớn theo khung Figma 981:84578 (2 hình 3:4) / 983:84658 (1 hình 4:3). */
    ncols = 2;
    /* Sản phẩm mới — theo menu thật shop.dafc.com.vn: [Bộ sưu tập mới] + cột
       NAM + cột NỮ. Mobile bỏ tầng giới tính vì tab đã là giới tính; desktop
       GIỮ vì subheader không gắn giới tính và mọi mục khác cũng dựng 2 cột
       Nam/Nữ. Nguồn data vẫn là MENU_DATA dùng chung với mobile. */
    /* 02/10/2026 (lệnh user: "trong menu, ở tab Sản phẩm mới ở subheader, đổi cái title theo gender thành
       WHAT'S NEW cho 3 gender"): tiêu đề CỘT NGÀNH đổi từ tên ngành (Nam / Nữ) thành "What’s new" — chuỗi
       TIẾNG ANH giữ nguyên ở cả 2 ngôn ngữ (đúng khung Figma của user). Chữ hoa vẫn do class `uppercase` ở
       dkMegaCol nên chuỗi gõ chữ thường; dấu nháy là ’ (kiểu in) như khung. Đường dẫn của từng mục KHÔNG đổi:
       `dept` vẫn đi vào crumbs [dept, 'Sản phẩm mới'] nên bấm "Quần áo" vẫn ra PLP đúng giới.
       Ngành Làm đẹp KHÔNG có panel này (['Sản phẩm mới', null] = link phẳng sang PLP) → trong "3 ngành" chỉ Nam
       và Nữ có tiêu đề để đổi. */
    const subOf = dept => MENU_DATA[dept].cats.find(([lb]) => lb === 'Sản phẩm mới')[1];
    const colls = splitByHeader(subOf('Nam').items).find(g => g.title === 'Bộ sưu tập mới');
    cols = dkMegaCol('Bộ sưu tập mới', '', '', colls ? colls.items : [], it => dkCatAttrs(it, ['Sản phẩm mới']))
      + (dkDept === 'Nữ' ? ['Nữ'] : ['Nam']).map(dept => {
          const sub = subOf(dept);
          const cats = splitByHeader(sub.items).find(g => g.title === 'Danh mục');
          return dkMegaCol('What’s new', sub.all, dkCatAttrs(sub.all, [dept, 'Sản phẩm mới']),
            cats ? cats.items : [], it => dkCatAttrs(it, [dept, 'Sản phẩm mới']));
        }).join('');
  } else if (item.brands) {
    /* 25 thương hiệu chia ĐỀU 3 cột (9/8/8) — trước đây là 1 cột tiêu đề +
       3 cột chữ = 4 cột, cộng ảnh thành 5, không vừa lưới 4 cột. Cột 1 mang
       luôn tiêu đề + "Tất cả thương hiệu" nên 2 cột sau phải `pt-6` cho thẳng
       hàng với dòng chữ đầu của cột 1. */
    nc = 3;
    const n = 3, split = [[], [], []];
    MENU_BRANDS.forEach((b, i) => split[i % n].push(b));
    const brandAttrs = b => `data-nav="plp" data-plp-brand="${b}"`;   // 02/09: mỗi hãng dẫn về trang của chính nó
    cols = `
      ${dkMegaCol('Thương hiệu', 'Tất cả thương hiệu', 'data-nav="plp"', split[0], brandAttrs)}
      ${split.slice(1).map(col => dkMegaCol('', '', '', col, brandAttrs)).join('')}`;
  } else if (item.beauty) {
    /* Nhánh này hiện KHÔNG mục nào trong DK_NAV_CATS dùng — "Làm đẹp" đã lên
       hàng dept dạng link phẳng. Giữ lại để bật lại panel beauty ở subheader
       chỉ bằng cách thêm { label:'Làm đẹp', beauty:true } vào DK_NAV_CATS. */
    const cats = MENU_DATA['Làm đẹp'].cats.filter(([, sub]) => sub);
    cols = cats.map(([, sub]) =>
      dkMegaCol(sub.title, sub.all, dkCatAttrs(sub.all, ['Làm đẹp', sub.title]),
        sub.items, it => dkCatAttrs(it, ['Làm đẹp', sub.title]))
    ).join('');
  } else if (item.sub || item.cat) {
    /* 29/09/2026 — MỘT NGÀNH MỘT PANEL, cột cắt theo {header} trong data: Danh mục · Thương hiệu
       nổi bật · Khám phá (thời trang) hoặc các cột của sheet Beauty. Trước đây danh mục thời
       trang dựng 2 cột Nam + Nữ; nay hàng ngành ở trên đã chọn giới tính nên chỉ vẽ ngành đang
       sáng (dkDept). Panel được dựng lại mỗi lần header dựng (bấm ngành là dựng lại trang). */
    const dept = item.sub ? item.dept : (dkDept === 'Nữ' ? 'Nữ' : 'Nam');
    const sub  = item.sub || (MENU_DATA[dept].cats.find(([lb]) => lb === item.cat) || [])[1];
    if (!sub) return '';
    const groups = splitByHeader(sub.items);
    nc = groups.length;
    ncols = nc;   // 01/10/2026: panel ít cột (Làm đẹp: Dành cho nam · Bộ sưu tập · Hương thơm không gian = 1 cột) cũng dùng khối ảnh lớn, ảnh vẫn ở cột 3-4
    const attrs = it => it && it.brand
      ? `data-nav="plp" data-plp-brand="${it.brand}"`
      : dkCatAttrs(it, [dept, sub.title]);
    cols = groups.map(g => dkMegaCol(g.title, '', '', g.items, attrs)).join('');
  } else {
    return '';
  }
  return `
  <!-- glass-95 + backdrop-blur ĐÚNG BẰNG thanh nav (.navbar, .dk-sub) để panel
       đọc ra là phần nối dài của thanh chứ không phải một tấm trắng đè lên
       (yêu cầu user 17/08/2026). Trước đó panel dùng bg-background đặc, tụt
       xuống dưới thanh kính là thấy rõ mối nối.
       LƯU Ý: khối này nằm trong template literal — comment TUYỆT ĐỐI không
       được chứa dấu backtick, dính vào là đứt chuỗi, cả file không chạy. -->
  <div class="dk-mega absolute left-0 right-0 top-full glass-95 backdrop-blur-[7.5px] z-50" data-mega="${id}">
    <!-- 4 cột đều nhau: tối đa 3 cột nội dung + ảnh ghim ở cột 4 (.dk-mega-grid).
         Mục nào ít nhóm hơn (vd Túi xách chỉ Nam/Nữ) thì bỏ trống cột 3, KHÔNG
         kéo giãn cột — mọi panel phải cùng một lưới. -->
    <div class="max-w-[1440px] mx-auto px-6 pt-8 pb-10 dk-mega-grid" style="height:440px;padding:0 24px;align-items:stretch;grid-template-columns:repeat(${nc > 3 ? nc : 4},minmax(0,1fr));gap:24px">
      ${cols}
${nc > 3 ? '' : dkMegaImages(item, ncols)}
    </div>
  </div>`;
}

