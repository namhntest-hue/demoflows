  });

  localizeNew(bar); localizeNew(md);
  if (COOKIE_AUTO) setTimeout(openBar, 700);
})();

/* ── Dropdown chọn 1 giá trị NEO VÀO Ô (tỉnh/thành, phường/xã, thành phố) ──
   21/08/2026 (yêu cầu user): bỏ popup #pickSheet giữa màn — bấm ô là xổ
   listbox NGAY DƯỚI ô (khuôn từng dùng chung với ô chọn size PDP, nay PDP đã
   về chip 28/08); viền 1px + không bóng ăn theo khối KHUÔN CHUNG CHO MỌI
   LỚP NỔI qua [data-pick-list]. Danh sách dài hơn 8 mục có ô tìm kiếm ở đầu
   (giữ tính năng gõ không dấu + tô đậm khớp của popup cũ). Chỉ 1 dropdown mở
   tại một thời điểm; bấm lại chính ô đang mở là đóng. Listener bấm-ra-ngoài
   gắn MỘT lần ở document (không qua wire() nên không nhân bản mỗi lần render;
   dropdown sống trong DOM của màn nên rerenderCheckout tự dọn nó). */
(() => {
  /* Bỏ dấu + đ→d để gõ "da nang" vẫn ra "TP. Đà Nẵng" — người dùng hiếm khi
     gõ đủ dấu khi đang điền địa chỉ. */
  const norm = t => t.normalize('NFD').replace(/[̀-ͯ]/g, '')
                     .replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase();

  const tick = '<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--general-primary)" class="shrink-0"><path d="M8.41,21c-.59,0-1.144-.229-1.561-.646L.026,13.53l.707-.707,6.823,6.823c.457,.455,1.25,.455,1.707,0L23.288,5.622l.707,.707-14.024,14.024c-.417,.417-.971,.646-1.561,.646Z"/></svg>';

  let cur = null;   // { wrap, btn, box } của dropdown đang mở
  const close = () => {
    if (!cur) return;
    cur.box.remove();
    cur.btn.setAttribute('aria-expanded', 'false');
    const c = cur.wrap.querySelector('[data-pick-caret]');
    if (c) c.style.transform = '';
    cur = null;
  };
  document.addEventListener('click', e => { if (cur && !cur.wrap.contains(e.target)) close(); });

  /* 02/10/2026 (lệnh user: "trong các mục có phường xã — thêm box Search ở Phường Xã tương tự thành phố") —
     tham số `cfg`: cfg.search === true ÉP hiện ô Tìm kiếm dù danh sách ngắn. Mặc định giữ nguyên luật cũ (chỉ hiện
     khi danh sách dài hơn 8 mục): tỉnh / thành có 11 mục nên có ô tìm, còn phường chỉ 4–7 mục nên trước đây không có —
     ô Phường / xã (checkout + sổ địa chỉ Tài khoản) nay truyền { search: true }. Các danh sách ngắn khác (giới tính,
     thành phố có cửa hàng) KHÔNG đổi. */
  const openDD = (btn, opts, current, cb, cfg) => {
    if (cur && cur.btn === btn) { close(); return; }   // bấm lần 2 vào chính ô = đóng
    close();
    const wrap = btn.closest('[data-pick-dd]') || btn.parentElement;
    const box = document.createElement('div');
    box.setAttribute('data-pick-list', '');
    box.setAttribute('role', 'listbox');
    box.className = 'absolute left-0 right-0 top-full mt-1 bg-background rounded-sm z-40 flex flex-col';
    box.style.maxHeight = '260px';
    const withSearch = (cfg && cfg.search === true) || opts.length > 8;
    box.innerHTML = `
      ${withSearch ? `
      <label class="flex items-center gap-2 h-10 px-3 border-b border-border shrink-0">
        <span class="w-4 h-4 flex items-center justify-center shrink-0 [&_svg]:w-4 [&_svg]:h-4">${I.search}</span>
        <input data-pk-search type="search" placeholder="Tìm kiếm" autocomplete="off"
               class="t-multiline flex-1 min-w-0 outline-none text-foreground placeholder:text-muted-foreground"
               style="background:transparent;border:0;padding:0;-webkit-appearance:none;appearance:none">
      </label>` : ''}
      <div data-pk-rows class="flex-1 min-h-0 overflow-y-auto no-scrollbar"></div>`;
    const rows = box.querySelector('[data-pk-rows]');
    const search = box.querySelector('[data-pk-search]');

    const paint = () => {
      const raw = search ? search.value.trim() : '';
      const q = norm(raw);
      const shown = q ? opts.filter(o => norm(o).includes(q)) : opts;
      rows.innerHTML = shown.length ? shown.map(o => `
        <button type="button" role="option" aria-selected="${o === current}" data-pk-opt="${o}"
                class="w-full min-h-11 flex items-center gap-2 px-3 py-2 text-left transition-colors press ${o === current ? 'bg-secondary' : 'ghost-hover'}">
          <span class="t-multiline flex-1 min-w-0 text-foreground">${highlightMatch(o, raw)}</span>
          ${o === current ? tick : ''}
        </button>`).join('')
        : '<p class="t-multiline px-3 py-4 text-muted-foreground">Không tìm thấy kết quả</p>';
      rows.querySelectorAll('[data-pk-opt]').forEach(b => b.addEventListener('click', () => {
        const v = b.dataset.pkOpt;
        close();
        cb(v);
      }));
      rows.scrollTop = 0;
      localizeNew(rows);
    };
    if (search) search.addEventListener('input', paint);
    paint();
    wrap.appendChild(box);
    localizeNew(box);   // placeholder "Tìm kiếm"; tên địa giới không có trong I18N nên giữ nguyên
    btn.setAttribute('aria-expanded', 'true');
    const caret = wrap.querySelector('[data-pick-caret]');
    if (caret) caret.style.transform = 'translateY(-50%) rotate(180deg)';
    if (search) search.focus();
    cur = { wrap, btn, box };
  };
  window.__openPickDD = openDD;
})();

/* Popup đăng nhập nhanh nằm ngoài .screen nên wire() không chạm tới */
wirePasswordToggles(document.getElementById('loginPop'));

wireFilter();

/* ── NGỮ CẢNH MÀN ĐI QUA HASH KHI ĐỔI BẢN (04/10/2026) ───────────────────────────────────────────────────────────────
   Cầu nối RESP chỉ mang TÊN màn (+ ngôn ngữ, phông, giao diện, dải trang chủ). Màn `plp` thì tên không đủ: hãng đang xem, hub hay lưới,
   bộ lọc đang áp đều nằm ở biến toàn cục (plpMode / plpFilters) — kéo cửa sổ qua mốc 768 là bản kia dựng `plp` với mặc định, tức trang
   VERSACE (đo 04/10: đứng ở trang Molton Brown mà đổi bản là ra Versace). PDP cũng vậy: pdpIdx rơi về 0. navCarry() đóng gói phần đó
   thành MỘT chuỗi JSON (tham số `ctx` của hash), navRestore() đọc lại TRƯỚC khi dựng màn đầu tiên.
   Hash là dữ liệu từ ngoài nên navRestore() chỉ nhận đúng các khoá đã biết, hãng phải là hãng có thật, nhãn lọc bị pruneFilters() rụng nếu lạ,
   chuỗi tự do (tiêu đề, từ khoá) bị bỏ dấu < > — hỏng chỗ nào thì bỏ cả lượt và rơi về mặc định như cũ. */
function navCarry() {
  try {
    if (current === 'plp') return JSON.stringify({ m: plpMode, f: plpFilters });
    if (current === 'pdp') return JSON.stringify({ i: pdpIdx });
  } catch (e) { /* không đóng gói được thì thôi, bản kia dựng mặc định */ }
  return '';
}
function navRestore(screen, raw) {
  try {
    const o = JSON.parse(raw);
    if (!o || typeof o !== 'object') return;
    if (screen === 'pdp') {
      const i = +o.i;
      if (Number.isInteger(i) && PRODUCTS[i]) pdpIdx = i;
      return;
    }
    if (screen !== 'plp') return;
    const m = o.m;
    if (!m || !['brand', 'category', 'search'].includes(m.type)) return;
    const txt = v => (typeof v === 'string' ? v.replace(/[<>]/g, '').slice(0, 200) : '');
    const strs = v => (Array.isArray(v) ? v.filter(x => typeof x === 'string').map(txt).slice(0, 40) : []);
    const next = { type: m.type };
    if (m.type === 'brand') {
      const known = new Set([...PRODUCTS.map(p => p.brand), ...MENU_BRANDS, ...Object.keys(BRAND_PAGES)]);
      if (m.brand !== undefined && !known.has(m.brand)) return;   // tên hãng lạ: bỏ cả lượt
      if (m.brand) next.brand = m.brand;
      if (m.all === true) next.all = true;
      if (typeof m.scent === 'string' && /^[A-Za-z0-9\u00C0-\u1EF9 &'’.\-]{1,40}$/.test(m.scent)) next.scent = m.scent;
      if (Array.isArray(m.filters)) next.filters = strs(m.filters);
    } else {
      if (m.title) next.title = txt(m.title);
      if (Array.isArray(m.crumbs)) next.crumbs = strs(m.crumbs);
      if (m.type === 'search') next.query = txt(m.query);
    }
    plpMode = next;
    plpFilters = strs(o.f);
    pruneFilters();   // nhãn lạ / không hợp ngành của PLP này thì rụng
  } catch (e) { /* hash hỏng: bỏ qua */ }
}

/* ── Khởi động: nhận trạng thái từ bản kia (nếu vừa đổi bản qua mốc 768) ──
   RESP dựng ở <head>. Khi trang đang bị chuyển sang file kia thì KHÔNG dựng
   màn hình nào nữa — đỡ vẽ thừa một trang sắp bị bỏ.
   Ngôn ngữ/phông lặp lại đúng các bước của nút trong bảng Cài đặt, chỉ bỏ
   toast vì đây là khôi phục trạng thái chứ không phải người dùng vừa bấm.
   Đặt LANG trước go() nên nhãn đổi ngôn ngữ trên header desktop (render theo
   LANG) cũng ra đúng chiều, không cần sửa tay. */
if (!RESP.swapped) {
  const st = RESP.read();

  if (st.lang === 'en') {
    applyLang(document.body, 'en');
    LANG = 'en';
    document.querySelectorAll('#settingsPanel [data-lang]').forEach(x => {
      x.className = 'langopt flex-1 h-8 rounded-full text-[13px] leading-5 transition-colors press '
        + (x.dataset.lang === 'en' ? 'bg-background text-foreground font-medium shadow-sm' : 'text-muted-foreground');
    });
  }

  if (st.theme) applyTheme(st.theme);

  /* 29/09/2026 — dải sản phẩm trang chủ (Hàng mới về / Khuyến mãi) đi qua hash như ngôn ngữ và giao
     diện: kéo cửa sổ qua mốc 768 sang file kia mà lựa chọn không mất. Mặc định 'new' không ghi hash. */
  if (st.hm === 'sale') { hmBlock = 'sale'; paintHmBlockUI(); }

  /* 04/10/2026 — ngữ cảnh màn (hãng + hub/lưới + bộ lọc ở PLP · chỉ số SP ở PDP) đi qua hash; phải đặt TRƯỚC go(first) bên dưới. */
  if (st.ctx) navRestore(st.screen, st.ctx);

  const f = FONTS.find(x => x[0] === st.font);
  if (f) {
    currentFont = f[0];
    document.documentElement.style.setProperty('--font-app', f[2]);
    document.documentElement.classList.add('font-override');
    document.querySelectorAll('#settingsPanel [data-font]').forEach(x =>
      x.querySelector('.fo-tick').classList.toggle('opacity-0', x.dataset.font !== f[0]));
  }

  /* hasOwnProperty chứ không phải RENDER[...] trực tiếp: hash là dữ liệu ngoài,
     mà key kế thừa từ Object.prototype (#screen=__proto__, =constructor) cũng
     "truthy" — lọt vào go() là ném lỗi giữa boot, trang trắng và mất luôn
     RESP.watch() bên dưới (hết chuyển bản khi kéo cửa sổ). */
  const first = Object.prototype.hasOwnProperty.call(RENDER, st.screen) ? st.screen : 'home';
  window.history.replaceState({ screen: first }, '');
  /* fromPopstate: chặn go() push thêm một entry TRÙNG với replaceState vừa rồi
     — nếu không, mỗi lần tải trang để lại 2 entry cùng state và cú bấm back
     đầu tiên không làm gì (go() thoát sớm vì name === current). */
  go(first, { fromPopstate: true });
  /* 21/09/2026 — wire() chỉ chạy trên cây của MÀN vừa dựng, mà mấy lớp phủ (sheet báo
     hàng về, popup đăng nhập ở giỏ, panel tài khoản) được bắn thẳng vào body từ đầu và
     KHÔNG BAO GIỜ dựng lại — chúng nằm ngoài mọi lượt wire(). Quét cả document đúng một
     lượt ở đây là đủ; cờ data-blurWired lo phần không gắn chồng. Xem FIELD_RULE. */
  wireBlurCheck(document);

  /* Hash chỉ là kênh chuyển giao MỘT LẦN — dọn ngay sau khi nhận, để lát nữa
     người dùng đi sang màn khác rồi tải lại trang thì không bị kéo ngược về
     màn cũ. Bọc try vì một số trình duyệt chặn đổi URL trên file://. */
  if (location.hash) {
    try { window.history.replaceState({ screen: first }, '', location.pathname + location.search); } catch (e) {}
  }

  /* Thu cửa sổ hẹp < 768 -> sang bản mobile, mang theo màn + cài đặt */
  RESP.watch(() => [current, LANG, currentFont, currentTheme, hmBlock, navCarry()]);

  /* BỀ RỘNG THANH CUỘN -> biến `--sbw` (25/09/2026).
     Sinh ra cho dải "Gợi ý mua kèm" tràn mép: CSS ở đó cần `100vw` để thoát trần
     `max-w-[1440px]`, mà `100vw` lại tính cả thanh cuộn nên thừa ra và đẻ thanh cuộn
     NGANG. Không có cách thuần CSS nào đọc được con số này.
     Đo bằng hiệu innerWidth − clientWidth: ra 0 trên máy dùng thanh cuộn phủ (macOS,
     mobile) và ~15 trên Windows. Cập nhật lại khi đổi khổ vì thanh cuộn có thể xuất
     hiện/biến mất theo chiều cao nội dung. */
  const capNhatSbw = () => document.documentElement.style.setProperty(
    '--sbw', (window.innerWidth - document.documentElement.clientWidth) + 'px');
  capNhatSbw();
  window.addEventListener('resize', capNhatSbw);
}
</script>
