    });
  });

  /* ── MÀN CỔNG THANH TOÁN ── */
  if (root.querySelector('[data-pay-redirect], [data-pay-retry]')) {
    payStopTimer();
    /* 22/09/2026 — dừng hẹn giờ ở MỌI đường ra khỏi màn (logo, header, back...): go() chạy scrollCleanups trước khi dựng màn mới.
       07/10/2026: trước đây đó là đồng hồ đếm ngược 15 phút của màn QR; nay là cú hẹn 1,4 s của "đang chuyển cổng" (payEnter đặt, payResolve đọc). */
    scrollCleanups.push(payStopTimer);
    /* Thử lại / Thanh toán lại: MỘT phiên cổng mới — chuyển cổng rồi ra kết cục theo công tắc, y như lần đầu. */
    root.querySelectorAll('[data-pay-retry]').forEach(b => b.addEventListener('click', () => payEnter(payFor, payFrom)));
    /* Ra khỏi cổng mà chưa trả: về chi tiết đơn, đơn vẫn "Chờ thanh toán" với nút "Thanh toán lại". */
    root.querySelectorAll('[data-pay-back]').forEach(b => b.addEventListener('click', () => {
      payStage = '';
      currentOrder = payFor[0] || currentOrder;
      go('order', { force: true });
    }));
  }

  // toast buttons
  root.querySelectorAll('[data-toast]').forEach(b => b.addEventListener('click', e => { e.stopPropagation(); toast(b.dataset.toast); }));

  // checkout: chuyển section (không chuyển trang)
  if (root.querySelector('#ckSections')) {
    paintCheckout(root);
    /* Danh sách sản phẩm của panel (#ckSumAcc) đóng/mở qua hàng trigger
       "Giỏ hàng của bạn" — đi qua wiring .acc-trigger chung, không cần handler riêng. */
    const scrollTo = (i) => {
      const sec = root.querySelector(`.ck-sec[data-sec="${i}"]`);
      if (sec) window.scrollTo({ top: sec.getBoundingClientRect().top + window.scrollY - 56, behavior: 'smooth' });
    };
    /* Các ô người nhận (Tên · Họ · SĐT · Email) ghi thẳng vào state mỗi lần gõ — nhờ vậy đổi thành phố /
       cửa hàng (dựng lại phần thân) không làm mất chữ, và phần tóm tắt sau khi
       Xác nhận có dữ liệu để nhắc lại. */
    const CKF = { pfirst: v => ckFirst = v, plast: v => ckLast = v, phone: v => ckPhone = v, email: v => ckEmail = v,
                  sfirst: v => ckShipFirst = v, slast: v => ckShipLast = v, sphone: v => ckShipPhone = v, saddr: v => ckShipLine = v,
                  note: v => ckNote = v };
    root.querySelectorAll('[data-ckf]').forEach(inp => {
      inp.addEventListener('input', () => {
        CKF[inp.dataset.ckf] && CKF[inp.dataset.ckf](inp.value);
        clearFieldErr(inp);
      });
    });

    /* EMAIL ĐÃ CÓ TÀI KHOẢN (11/09/2026) — mời đăng nhập thay vì im lặng để họ
       đặt tiếp dưới dạng khách vãng lai rồi mất luôn lịch sử đơn.
       Kiểm lúc RỜI Ô (blur), không phải lúc gõ: gõ dở "user" đã bắn lời mời là
       chen ngang. Và chỉ MỜI, KHÔNG chặn — họ có quyền đặt với tư cách khách. */
    const emailInp = root.querySelector('[data-ckf="email"]');
    const known = root.querySelector('#ckEmailKnown');
    if (emailInp && known) emailInp.addEventListener('blur', () => {
      const hit = String(emailInp.value).trim().toLowerCase() === PROFILE.email.toLowerCase();
      known.classList.toggle('hidden', !hit);
      if (!hit) { known.innerHTML = ''; return; }
      known.innerHTML = `<p class="t-single text-foreground-alt">Email này đã có tài khoản. <button data-nav="login" class="underline font-medium text-foreground press">Đăng nhập</button> để dùng địa chỉ đã lưu và cộng điểm cho đơn này.</p>`;
      wire(known);
    });

    root.querySelectorAll('.ck-next').forEach(btn => {
      btn.addEventListener('click', () => {
        // Bước nhận tại cửa hàng: chưa chọn cửa hàng thì không cho đi tiếp
        if (btn.dataset.require === 'store') {
          if (!ckStore) { toast('Chọn cửa hàng nhận hàng'); return; }
          if (!validatePickup(root)) return;
          paintStore(root);   // đồng bộ tóm tắt với chữ vừa gõ trước khi thu gọn
        }
        if (btn.dataset.require === 'ship' && !validateShipping(root)) return;
        /* 23/09/2026 — đang SỬA một mục có sẵn thì GHI NGƯỢC vào sổ rồi mới đóng bước.
           Sửa TẠI CHỖ (ADDRESSES[i].first = ...) chứ không thay cả object: `ckAddr` và
           nhiều chỗ khác trỏ theo VỊ TRÍ trong mảng, còn cờ `def` thì không nằm trong
           form nên phải giữ nguyên — gán object mới là mất nó. */
        if (ckAddrEdit !== null && btn.dataset.require === 'ship') {
          const a = ADDRESSES[ckAddrEdit];
          if (a) {
            a.first = ckShipFirst; a.last = ckShipLast; a.phone = ckShipPhone; a.street = ckShipLine;
            a.province = ckProvince; a.ward = ckWard;
          }
          ckAddr = ckAddrEdit;
          ckAddrEdit = null;
        }
        // bước giao hàng: đồng bộ tóm tắt với địa chỉ/chữ vừa nhập
        const shipDone = root.querySelector('#ckShipDone');
        if (shipDone) { shipDone.innerHTML = ckShipDoneHTML(); localizeNew(shipDone); }
        // đang sửa lại một bước đã xong -> nhảy thẳng về bước xa nhất
        const editing = ckMaxStep > ckStep;
        ckStep = editing ? ckMaxStep : +btn.dataset.next;
        ckMaxStep = Math.max(ckMaxStep, ckStep);
        paintCheckout(root);
        setTimeout(() => scrollTo(ckStep), 120);
      });
    });
    /* Đổi hình thức nhận hàng: dựng lại đúng màn checkout tại chỗ (số section
       khác nhau giữa 2 chế độ nên không thể chỉ ẩn/hiện). */
    root.querySelectorAll('[data-ck-mode]').forEach(btn => {
      btn.addEventListener('click', () => {
        if (ckMode === btn.dataset.ckMode) return;
        ckMode = btn.dataset.ckMode;
        ckStep = 0; ckMaxStep = 0; ckShipPicked = false;
        rerenderCheckout(root);
        window.scrollTo(0, 0);
      });
    });
    /* Brief PDF trang 31: danh sách địa chỉ dời vào sheet #addrSheet, thân
       accordion chỉ còn "+ Thêm địa chỉ mới" (dựng lại vì form xổ ra) và nút
       "Sửa"/"Chọn địa chỉ đã lưu" mở sheet. Chọn xong trong sheet (bấm Áp
       dụng) luôn dựng lại — tóm tắt thẻ + form xổ/thu đều là THAY ĐỔI CẤU TRÚC
       chứ không phải cùng một khuôn như dãy radio cũ, nên không còn đường tắt
       "chỉ đổi thẻ đang chọn" như bản trước. */
    root.querySelectorAll('#addrOpts [data-addr="new"]').forEach(o => {
      o.addEventListener('click', () => {
        if (ckAddr === 'new') return;
        ckAddrEdit = null;
        if (typeof ckAddr === 'number') ckAddrPrev = ckAddr;   // chỗ để "Huỷ" quay về
        ckAddr = 'new';
        rerenderCheckout(root);
      });
    });
    /* "Thay đổi" trong ô địa chỉ = SỬA NỘI DUNG mục đang chọn (không phải đổi sang mục
       khác — việc đó là của "Xem tất cả địa chỉ"). Nạp 5 biến form từ mục đó rồi dựng
       lại để `addrForm` hiện ra với dữ liệu cũ. */
    root.querySelectorAll('#addrOpts [data-addr-edit]').forEach(b => {
      b.addEventListener('click', () => {
        const a = ADDRESSES[ckAddr];
        if (!a) return;
        ckAddrEdit = ckAddr;
        ckShipFirst = a.first; ckShipLast = a.last; ckShipPhone = a.phone; ckShipLine = a.street;
        ckProvince = a.province; ckWard = a.ward;
        rerenderCheckout(root);
      });
    });
    /* KHÔNG bám `#addrOpts` nữa: từ 23/09 nút "Huỷ" nằm cạnh nút Xác nhận, tức NGOÀI
       khối #addrOpts. Một handler lo cả hai đường thoát (đang sửa / đang thêm mới). */
    root.querySelectorAll('[data-addr-cancel]').forEach(b => {
      b.addEventListener('click', () => {
        if (ckAddrEdit !== null) ckAddrEdit = null;
        else if (ckAddr === 'new') ckAddr = ADDRESSES[ckAddrPrev] ? ckAddrPrev : 0;
        rerenderCheckout(root);
      });
    });
    /* ĐÃ GỠ 23/09/2026 (đợt 5) — handler bấm chọn thẻ ([data-addr] số) và handler link
       "Sửa" ([data-addr-edit], nhảy sang Tài khoản). Khối nay chỉ còn MỘT ô địa chỉ
       đang chọn, đổi bằng sheet qua [data-open-addrbook] — không còn thẻ nào để bấm
       chọn, cũng không còn link Sửa.
       ⚠ SỬA ĐỊA CHỈ nay CHỈ vào được từ trang Tài khoản > Sổ địa chỉ. Đó là hệ quả
       của lệnh (ô chỉ còn nút "Thay đổi" = đổi sang địa chỉ khác, không phải sửa nội
       dung địa chỉ). Muốn có lối sửa tại checkout thì phải thêm lại link riêng. */
    if (window.__openAddrSheet) {
      root.querySelectorAll('[data-open-addrbook]').forEach(btn => {
        btn.addEventListener('click', () => {
          window.__openAddrSheet(ckAddr === 'new' ? null : ckAddr, picked => {
            if (picked === ckAddr) return;
            ckAddr = picked;
            rerenderCheckout(root);
          });
        });
      });
    }

    /* Danh sách cửa hàng: lần chọn ĐẦU TIÊN phải dựng lại để lộ khối thông tin
       người nhận; các lần đổi sau chỉ chuyển thẻ đang chọn — giữ nguyên chữ
       người dùng đã gõ ở ô SĐT/email. */
    root.querySelectorAll('#storeOpts [data-opt]').forEach(o => {
      o.addEventListener('click', () => {
        const name = o.dataset.opt.slice(6);      // bỏ tiền tố "store:"
        if (name === ckStore) return;
        const first = !ckStore;
        ckStore = name;
        if (first) {
          // lần đầu: khối người nhận mới mọc ra -> đưa con trỏ vào ô đầu tiên
          rerenderCheckout(root);
          const inp = root.querySelector('#ckRecipient input');
          if (inp) inp.focus({ preventScroll: true });
          const box = root.querySelector('#ckRecipient');
          if (box) setTimeout(() => window.scrollTo({ top: box.getBoundingClientRect().top + window.scrollY - 56, behavior: 'smooth' }), 60);
          return;
        }
        root.querySelectorAll('#storeOpts [data-opt]').forEach(x => {
          x.classList.remove('on'); x.setAttribute('aria-checked', 'false');
          x.querySelector('.radio').classList.remove('on');
        });
        o.classList.add('on'); o.setAttribute('aria-checked', 'true');
        o.querySelector('.radio').classList.add('on');
        paintStore(root);
      });
    });
    root.querySelectorAll('.ck-change').forEach(btn => {
      btn.addEventListener('click', () => {
        ckStep = +btn.dataset.goto;
        paintCheckout(root);
        setTimeout(() => scrollTo(ckStep), 120);
      });
    });
    /* Bước Xuất hoá đơn VAT: 3 lựa chọn dạng radio (19/09/2026). Chọn "Không xuất"
       thì gỡ luôn bộ field bên dưới — không để form trống nằm đó. */
    root.querySelectorAll('#vatOpts [data-vat-mode]').forEach(o => {
      o.addEventListener('click', () => {
        const m = o.dataset.vatMode;
        if (m === vatMode) return;
        vatMode = m;
        root.querySelectorAll('#vatOpts [data-vat-mode]').forEach(x => {
          const on = x.dataset.vatMode === vatMode;
          x.classList.toggle('on', on);
          x.querySelector('.radio').classList.toggle('on', on);
        });
        const rows = root.querySelector('#vatFieldRows');
        if (rows) { rows.innerHTML = vatMode === 'none' ? '' : vatFieldRows(vatMode); localizeNew(rows); }
        const done = root.querySelector('#ckVatDone');
        if (done) { done.textContent = vatLabel(vatMode); localizeNew(done); }
      });
    });

    // đổi tóm tắt vận chuyển theo lựa chọn
    root.querySelectorAll('#shipOpts [data-opt]').forEach(o => {
      o.addEventListener('click', () => {
        ckShipFast = o.dataset.opt === 'fast';
        /* 04/10/2026 (lệnh user: "khi khách điền xong thông tin vận chuyển và chọn phương thức thì mình show luôn") — bấm là hiện phí
           + tổng ở khối tóm tắt NGAY, không đợi nút Xác nhận. Bấm lại đúng dòng đang chọn cũng tính là chọn (khách chấp nhận dòng
           chọn sẵn Giao hàng thông thường). */
        ckShipPicked = true;
        paintCkMoney(root);
        const lbl = root.querySelector('#shipDoneLabel');
        if (lbl) { lbl.textContent = ckShipFast ? SHIP_NAME_FAST : SHIP_NAME_STD; localizeNew(lbl); }
        /* 02/10/2026 — dòng dự kiến đổi theo phương thức (hai câu khác nhau). localizeNew để chuỗi vừa ghi vẫn
           được dịch khi đang ở bản EN. */
        const eta = root.querySelector('#shipDoneEta');
        if (eta) { eta.textContent = ckShipFast ? SHIP_ETA_FAST : SHIP_ETA_STD; localizeNew(eta); }
      });
    });
  }

  // accordions
  root.querySelectorAll('.acc-trigger').forEach(t => {
    t.addEventListener('click', e => {
      e.stopPropagation();
      const me = t.closest('.acc');
      const wasOpen = me.classList.contains('open');
      // đóng mọi mục cùng nhóm (cùng phần tử cha) trước
      [...me.parentElement.children].forEach(sib => {
        if (sib !== me && sib.classList && sib.classList.contains('acc')) sib.classList.remove('open');
      });
      me.classList.toggle('open', !wasOpen);
    });
  });

  // (28/08: PDP không còn kiểu chọn size nào ngoài CHIP — khối dropdown inline
  //  [data-size-dd] đã gỡ cùng cờ PDP_DATA.dropdown)

  // checkbox
  root.querySelectorAll('[data-check]').forEach(c => {
    c.addEventListener('click', e => {
      e.preventDefault(); e.stopPropagation();
      c.classList.toggle('on');
      /* Riêng ô tick trong giỏ: tick = "sản phẩm này nằm trong đơn". Bỏ tick là
         rời tạm tính -> quà kèm sản phẩm rút theo và quà theo đơn tính lại
         (có thể rớt mốc). Các màn khác không có .cart-row nên không dính. */
      const row = c.closest('.cart-row');
      if (!row) return;
      const item = CART[+row.dataset.row];
      if (!item) return;
      item.sel = c.classList.contains('on');
      refreshCartAll(root);
    });
  });

  // radio option groups
  /* Chỉ bật/tắt class .on — màu viền thẻ do .opt.on cấp, vòng radio giữ nguyên
     viền 1px ở cả 2 trạng thái. Trước đây còn tráo border-primary/border-border
     bằng tay, vừa trùng việc với CSS vừa vẽ vòng radio dày 2px đổi đen. */
  root.querySelectorAll('#shipOpts, #payOpts, #giftOpts').forEach(group => {
    group.querySelectorAll('[data-opt]').forEach(o => {
      o.addEventListener('click', () => {
        group.querySelectorAll('[data-opt]').forEach(x => {
          x.classList.remove('on');
          x.querySelector('.radio').classList.remove('on');
          const d = x.parentElement.querySelector('.pay-detail');
          if (d) { d.classList.remove('max-h-40', 'mt-2'); d.classList.add('max-h-0'); }
        });
        o.classList.add('on');
        o.querySelector('.radio').classList.add('on');
        const d = o.parentElement.querySelector('.pay-detail');
        if (d) { d.classList.remove('max-h-0'); d.classList.add('max-h-40', 'mt-2'); }
      });
    });
  });

  // PDP: sizes / swatches / gallery
  // (28/08: chỉ còn MỘT kiểu chọn size — chip grid cho cả 6 kind)
  const sizeBtns = [...root.querySelectorAll('[data-size]')];
  if (sizeBtns.length) {
    // dòng cảnh báo dưới chips (Figma: Regular 12 #d62845)
    const chipRow = sizeBtns[0].parentElement;
    let note = root.querySelector('#sizeNote');
    if (!note) {
      note = document.createElement('p');
      note.id = 'sizeNote';
      note.className = 'text-[12px] leading-4 text-destructive hidden pt-2';
      note.textContent = '*Tạm hết hàng';
      chipRow.insertAdjacentElement('afterend', note);
    }
    const cta      = root.querySelector('#pdpCta');
    const mainBtn  = cta ? cta.querySelector('button[data-add]') : null;
    const payOffer = cta ? [...cta.children].find(c => c.textContent.includes('Trả góp')) : null;
    const stickyBtn = document.querySelector('#pdpStickyCta button[data-add]');
    const NORMAL = mainBtn ? mainBtn.innerHTML : '';
    const stickyNormal = stickyBtn ? stickyBtn.innerHTML : '';

    // state: '' bình thường | 'oos' Tạm hết hàng | 'notify' Nhận thông báo | 'done' đã đăng ký
    const lowStock = root.querySelector('#lowStock');
    function setCta(state, size) {
      if (!mainBtn) return;
      const LABEL = { oos: 'Tạm hết hàng', notify: 'Nhận thông báo khi có hàng', done: 'Đã đăng ký nhận thông báo' };
      if (state) {
        mainBtn.dataset.oosState = state;
        mainBtn.innerHTML = LABEL[state];
        if (stickyBtn) { stickyBtn.dataset.oosState = state; stickyBtn.innerHTML = LABEL[state]; }
        if (payOffer) payOffer.classList.add('hidden');   // Figma: Payment Offer ẩn khi hết hàng
        if (lowStock) lowStock.classList.add('hidden');   // hết hàng / đã đăng ký thì không hiện "Chỉ còn 01 sản phẩm"
        if (state === 'oos') {
          // Tạm hết hàng: không còn hành động nào khả dụng -> disable hẳn nút, bỏ dòng cảnh báo đỏ (dư thừa)
          note.classList.add('hidden');
          mainBtn.disabled = true; mainBtn.style.opacity = '.4'; mainBtn.style.pointerEvents = 'none';
          if (stickyBtn) { stickyBtn.disabled = true; stickyBtn.style.opacity = '.4'; stickyBtn.style.pointerEvents = 'none'; }
        } else {
          note.classList.remove('hidden');
          mainBtn.disabled = false; mainBtn.style.opacity = ''; mainBtn.style.pointerEvents = '';
          if (stickyBtn) { stickyBtn.disabled = false; stickyBtn.style.opacity = ''; stickyBtn.style.pointerEvents = ''; }
        }
      } else {
        delete mainBtn.dataset.oosState;
        mainBtn.innerHTML = NORMAL;
        mainBtn.disabled = false; mainBtn.style.opacity = ''; mainBtn.style.pointerEvents = '';
        if (stickyBtn) { delete stickyBtn.dataset.oosState; stickyBtn.innerHTML = stickyNormal; stickyBtn.disabled = false; stickyBtn.style.opacity = ''; stickyBtn.style.pointerEvents = ''; }
        note.classList.add('hidden');
        if (payOffer) payOffer.classList.remove('hidden');
        // "Chỉ còn 01 sản phẩm" chỉ hiện khi size vừa chọn nằm trong SIZE_LOW_STOCK
        // (size mang tiền tố hệ đo "IT 42" -> bóc về số thô trước khi tra)
        if (lowStock) lowStock.classList.toggle('hidden', !SIZE_LOW_STOCK[sizeRaw(size)]);
      }
    }

    sizeBtns.forEach(b => {
      b.addEventListener('click', () => {
        sizeBtns.forEach(x => { x.classList.remove('on'); x.classList.replace('border-primary', 'border-border'); });
        b.classList.add('on'); b.classList.replace('border-border', 'border-primary');
        setCta(b.dataset.oos || '', b.dataset.size);   // '' | 'oos' | 'notify' — lấy thẳng từ size
        /* Đổi dung tích là đổi GIÁ (11/09/2026, sản phẩm làm đẹp): cập nhật tại
           chỗ, không dựng lại màn — dựng lại là mất vị trí cuộn và đóng hết
           accordion người ta đang mở. */
        const pNow = PRODUCTS[screenProductIdx()];
        const priceEl = root.querySelector('#pdpPrice');
        if (priceEl && pNow) priceEl.textContent = pdpPriceNow(pNow, root);
        pdpInCartSync(root);       // biến thể đổi -> dòng "đã có trong giỏ" đổi theo
      });
    });

    /* (Khối "Dropdown chọn size (pdp2/3/5/6)" đã gỡ 28/08 — mọi kind chọn size
       bằng chip grid ở trên, cùng đường setCta.) */

    // 'notify' -> mở form điền email + SĐT
    [mainBtn, stickyBtn].forEach(btn => {
      if (!btn) return;
      btn.addEventListener('click', () => {
        if (btn.dataset.oosState === 'notify' && window.__openNotify) window.__openNotify(() => setCta('done'));
      });
    });
  }
  root.querySelectorAll('[data-sw]').forEach(b => {
    b.addEventListener('click', () => {
      root.querySelectorAll('[data-sw]').forEach(x => { x.classList.remove('on'); x.classList.add('border-transparent'); });
      b.classList.add('on'); b.classList.remove('border-transparent');
      const cn = root.querySelector('#colorName'); if (cn) cn.textContent = b.dataset.color;
      const g = root.querySelector('#pdpGallery');
      if (g) g.scrollTo({ left: g.clientWidth * (+b.dataset.sw), behavior: 'smooth' });
    });
  });
  const gal = root.querySelector('#pdpGallery');
  if (gal) {
    gal.addEventListener('scroll', () => {
      const i = Math.round(gal.scrollLeft / gal.clientWidth);
      root.querySelectorAll('#pdpDots span').forEach((d, j) => {
        d.className = `h-1 rounded-full transition-all duration-300 ${j === i ? 'w-6 bg-primary' : 'w-4 bg-border-3'}`;
      });
    }, { passive: true });
  }

  // Info tabs -> đẩy bottom sheet (versace b-drawer)
  root.querySelectorAll('.sheet-trigger').forEach(btn => {
    btn.addEventListener('click', () => {
      const tabs = window.__pdp4Tabs || [];
      const t = tabs[+btn.dataset.sheetIdx];
      /* asHTML=true: thân tab PDP nay là HTML có cấu trúc (26/08), gọi 2 tham số
         thì openS dùng textContent và sheet in ra nguyên thẻ. Nhánh này hiện
         KHÔNG có markup nào kích hoạt (PDP4 đã đổi từ bottom sheet sang
         accordion tại chỗ) — vá cho đúng, không phải vì đang lỗi. */
      if (t && window.__openInfoSheet) window.__openInfoSheet(t[0], t[1], true);
    });
  });

  // Zoom khi chạm ảnh gallery (versace) — dragScroll đã chặn nếu vừa kéo
  root.querySelectorAll('.zoomable').forEach(btn => {
    btn.addEventListener('click', e => { if (window.__openZoom) window.__openZoom(btn.dataset.zoom); });
  });

  // WEAR IT WITH: counter "i / n" chạy theo cuộn
  const wiw = root.querySelector('#wiwRow'), wc = root.querySelector('#wiwCounter');
  if (wiw && wc) {
    const cards = wiw.querySelectorAll('[data-product]');
    wiw.addEventListener('scroll', () => {
      const i = Math.min(cards.length, Math.round(wiw.scrollLeft / (cards[0].offsetWidth + 4)) + 1);
      wc.textContent = i + ' / ' + cards.length;
    }, { passive: true });
  }

  // Cart (thành viên): Ưu đãi DAFC Rewards — radio đúng nghĩa, chọn 1 trong 2
  const rewardGroup = root.querySelector('#rewardOpts');
  if (rewardGroup) {
    const pointsWrap = rewardGroup.querySelector('#pointsInputWrap');
    rewardGroup.querySelectorAll('[data-reward]').forEach(b => {
      b.addEventListener('click', () => {
        if (b.dataset.reward === cartReward) return;
        cartReward = b.dataset.reward;
        rewardGroup.querySelectorAll('[data-reward]').forEach(x => {
          const on = x === b;
          // .opt/.on nay nằm trên div bọc ngoài (data-reward-card) — xem chú
          // thích đầy đủ ở bản mobile (index.html, cùng hook).
          const card = x.closest('[data-reward-card]');
          if (card) card.classList.toggle('on', on);   // viền thẻ do .opt.on cấp
          x.querySelector('.radio').classList.toggle('on', on);
        });
        if (pointsWrap) pointsWrap.classList.toggle('hidden', cartReward !== 'points');
        refreshCartSummary(root);
        toast('Đã áp dụng: ' + (cartReward === 'member' ? 'Giảm giá thành viên' : 'Điểm thưởng'));
      });
    });

    /* 20/09/2026 (lệnh user) — ĐIỂM CHỈ TRỪ TIỀN KHI BẤM "ÁP DỤNG".
       Trước đây nghe sự kiện `input` nên gõ tới đâu tổng tiền nhảy tới đó: gõ "1" là
       đã trừ 1 điểm, gõ tiếp "2" thành 12… — không có lúc nào là "đang gõ, chưa chốt",
       và cũng lệch hẳn với hai hàng nhập còn lại của panel (mã giảm giá · phiếu mua
       hàng) vốn đều phải bấm nút.
       Enter trong ô = bấm nút, cho người gõ phím không phải rời tay sang chuột.
       Vẫn kẹp [0, maxUsablePoints()] và ghi lại vào ô sau khi kẹp, để con số trong ô
       luôn là con số THẬT đang được trừ. */
    const pointsInput = rewardGroup.querySelector('#pointsInput');
    const applyPoints = rewardGroup.querySelector('#applyPoints');
    if (pointsInput && applyPoints) {
      const apDungDiem = () => {
        const maxPts = maxUsablePoints();
        const v = Math.round(Number(pointsInput.value) || 0);
        cartPointsUsed = Math.max(0, Math.min(v, maxPts));
        pointsInput.value = cartPointsUsed;
        /* 23/09 đợt 6 — dòng phụ nay nói TRẦN dùng được, không phải số đã dùng. (02/10/2026: số tiền quy đổi #pointsMoneyVal đã gỡ cùng chữ cũ.) */
        const val = rewardGroup.querySelector('#pointsUsedVal');
        if (val) val.textContent = `${maxPts.toLocaleString('vi-VN')} điểm`;
        refreshCartSummary(root);
        toast(cartPointsUsed > 0
          ? `Đã áp dụng ${cartPointsUsed.toLocaleString('vi-VN')} điểm`
          : 'Đã bỏ dùng điểm thưởng');
      };
      applyPoints.addEventListener('click', apDungDiem);
      pointsInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') { e.preventDefault(); apDungDiem(); }
      });
    }
  }

  /* ── HẠNG THÀNH VIÊN & ƯU ĐÃI (brief 50-52, 20/09/2026) ─────────────────
     Bấm một hạng: chỉ ĐỔI CLASS chứ không dựng lại thân tab — dựng lại là mất chuyển
     động mở/đóng, mà chuyển động đó chính là thứ brief mô tả ("đóng card hiện tại,
     mở card khách chọn"). */
  root.querySelectorAll('[data-tier-pick]').forEach(b => {
    b.addEventListener('click', () => {
      tierOpen = b.dataset.tierPick;
      root.querySelectorAll('.tier').forEach(x => x.classList.toggle('is-open', x.dataset.tier === tierOpen));
    });
  });
  /* "Xem lịch sử điểm" trên thẻ hạng — lớp con của cùng tab, không phải tab riêng. */
  root.querySelectorAll('[data-member-view]').forEach(b => {
    b.addEventListener('click', () => {
      memberView = b.dataset.memberView;
      /* Tra #accBody từ DOCUMENT chứ không từ `root`: sau lượt vẽ lại đầu tiên, wire()
         được gọi VẮI CHÍNH #accBody nên `root` LÀ nó — querySelector chỉ tìm trong HẬU
         DUỆ, trả null, và nút "quay lại" bấm không ra gì (biến đổi nhưng màn không vẽ
         lại). Đã dính đúng lỗi này lúc kiểm. */
      const host = document.querySelector('#accBody');
      if (host) { host.innerHTML = accountBody(); localizeNew(host); wire(host); }
    });
  });
  root.querySelectorAll('[data-tier-jump]').forEach(b => {
    b.addEventListener('click', () => {
      const t = root.querySelector('#tierAcc');
      if (t) t.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  /* Cart: "Chương trình khuyến mãi" — LỊCH SỬ: 18/09/2026 nút này thôi xổ tại chỗ để mở
     drawer trượt phải, nên handler cũ phải gỡ khỏi đây (nút mang cả hai đường thì một cú bấm
     chạy cả hai, vừa xổ chữ vừa trượt drawer).
     ⚠ 25/09/2026 — drawer ĐÃ XOÁ HẲN, nút quay lại xổ TẠI CHỖ qua listener
     [data-promo-toggle] ở cuối file. Chỗ này vẫn KHÔNG có handler riêng, nhưng lý do nay
     khác: đường duy nhất nằm ở listener chung.
     Khối .promo-peek vẫn giữ nguyên vai trò xem mấp mé trong hộp. */

  // Cart: qty steppers — số lượng là STATE (CART[i].qty), không chỉ chữ trong DOM
  root.querySelectorAll('.qty-btn').forEach(b => {
    b.addEventListener('click', () => {
      const row = b.closest('.cart-row'), el = row.querySelector('.qty');
      const it0 = CART[+row.dataset.row];
      let v = parseInt(el.textContent, 10) + parseInt(b.dataset.step, 10);
      /* Trần là TỒN KHO nếu món có khai, không thì 99 như cũ. Kẹp ở đây chứ không
         chỉ khoá nút: bàn phím (Enter trên nút) và i18n vẫn đi qua đúng nhánh này. */
      const cap = it0 && it0.stock != null ? Math.min(it0.stock, 99) : 99;
      const hit = v > cap;
      v = Math.max(1, Math.min(cap, v));
      if (hit) toast(`Chỉ còn ${cap} sản phẩm`);
      el.textContent = String(v).padStart(2, '0');
      el.classList.remove('pop'); void el.offsetWidth; el.classList.add('pop');
      const item = CART[+row.dataset.row];
      if (!item) return;
      item.qty = v;
      /* Nút trừ phải ĐỔI THEO ngay tại đây, không chỉ lúc dựng màn (11/09/2026):
         markup sinh ra đã khoá đúng ở số lượng 01, nhưng bấm + lên 02 mà không
         mở lại thì người mua không giảm xuống được nữa. Cùng một luật, hai chỗ
         phải nói giống nhau. */
      syncQtyBtns(row, item);
      /* Ghi chú "Chỉ còn N" bật/tắt ngay theo số lượng vừa đổi — nó nằm dưới dòng
         phân loại nên thay tại chỗ, không phải dựng lại cả dòng. */
      const noteOld = row.querySelector('.cart-note');
      const noteNew = cartRowNote(item);
      if (noteOld) noteOld.remove();
      if (noteNew) {
        const anchor = row.querySelector('.t-single.text-muted-foreground');
        if (anchor) anchor.parentElement.insertAdjacentHTML('beforeend', noteNew);
      }
      cartBusy(root);            // khối tiền mờ đi trong lúc tính lại
      refreshCartAll(root);      // tăng đủ mốc là quà theo đơn hiện ngay ở đây
    });
  });

  // Cart: delete row
  root.querySelectorAll('.del').forEach(b => {
    b.addEventListener('click', () => {
      const row = b.closest('.cart-row');
      /* Đánh dấu removed NGAY (không chờ animation xong) để tạm tính + điều kiện
         quà phản ánh đúng lúc người dùng thấy dòng bắt đầu trượt đi. Không splice
         khỏi CART vì các dòng sau còn tham chiếu chỉ số qua data-row. */
      const item = CART[+row.dataset.row];
      /* Nhớ trạng thái tick CŨ trước khi dọn (11/09/2026): hoàn tác mà trả món về
         với sel = true trong khi trước đó người ta đã cố ý bỏ tick nó là sửa thêm
         một thứ người dùng không nhờ. */
      const wasSel = item ? item.sel : undefined;
      if (item) { item.removed = true; item.sel = false; }
      const giftEl = row.nextElementSibling;   // dòng quà kèm của chính item này
      if (giftEl && giftEl.dataset.giftOf === row.dataset.row) giftEl.remove();
      row.style.transition = 'opacity .28s ease, transform .28s ease, max-height .32s ease, padding .32s ease';
      row.style.maxHeight = row.offsetHeight + 'px';
      requestAnimationFrame(() => {
        row.style.opacity = '0'; row.style.transform = 'translateX(-24px)';
        row.style.maxHeight = '0'; row.style.paddingTop = '0'; row.style.paddingBottom = '0';
      });
      setTimeout(() => { row.remove(); refreshCartCount(root); }, 330);
      refreshCartAll(root);
      /* HOÀN TÁC (11/09/2026, user chốt "chỉ hoàn tác", không hỏi xác nhận trước).
         Xoá trong giỏ là thao tác lặp nhiều lần nhất của màn này — chặn tay mỗi
         lần bằng một lớp hỏi là đổi một cú bấm thành ba. Ở đây cứ cho xoá, rồi
         chừa 5 giây để lấy lại.
         Dựng LẠI cả màn khi hoàn tác: dòng vừa xoá đã biến khỏi DOM, và dòng quà
         kèm của nó cũng đi theo — refreshCartAll() chỉ cập nhật số, không dựng
         lại được hai thứ đó. */
      toast('Đã xóa sản phẩm', { label: 'Hoàn tác', fn: () => {
        if (!item) return;
        item.removed = false;
        if (wasSel !== undefined) item.sel = wasSel;
        rerenderCart();
        toast('Đã khôi phục sản phẩm');
      } });
    });
  });

  /* Cart: đổi quà — UỶ QUYỀN ở gốc màn vì nhóm quà bị chèn/dựng lại lúc chạy,
     bind trực tiếp thì nút của nhóm dựng sau không có handler. Cờ trên root để
     không gắn chồng nếu wire() chạy lại. */
  if (root.querySelector('#cartList') && !root.dataset.giftWired) {
    root.dataset.giftWired = '1';
    root.addEventListener('click', e => {
      /* Hàng "Quà tặng theo đơn hàng" ở cuối giỏ -> mở lớp trượt, gom TẤT CẢ
         chương trình đang đủ điều kiện vào cùng một lớp (18/09/2026). */
      if (e.target.closest('[data-gift-order-open]') && window.__openGiftSheet) {
        const pks = [
          ...brandGiftEarned().map(t => t.program),
          ...orderGiftState().earned.map(t => t.program),
        ];
        /* Callback nay nhan MOT MANG {pk, key} — lop truot gom moi thay doi lai
           roi bao ve MOT LAN luc bam Xac nhan, nen chi ve lai gio dung mot lan. */
        if (pks.length) window.__openGiftSheet(pks, ds => {
          ds.forEach(x => { giftPick[x.pk] = x.key; });
          refreshCartGifts(root);
          toast('Đã chọn quà tặng');
        });
        return;
      }
      const sw = e.target.closest('[data-gift-swap]');
      if (!sw || !window.__openGiftSheet) return;
      const pk = sw.dataset.giftSwap;
      /* 21/09/2026 — cùng một nút nay làm HAI việc: "Chọn quà" khi chưa có gì và
         "Đổi quà" khi đã có. Phải đọc trạng thái TRƯỚC khi mở lớp trượt, vì lúc
         callback chạy thì giftPick đã bị ghi rồi, đọc lúc đó lúc nào cũng ra "đã có". */
      const coTruoc = !!giftKeyOf(pk);
      window.__openGiftSheet(pk, ds => {
        ds.forEach(x => { giftPick[x.pk] = x.key; });
        refreshCartGifts(root);
        toast(coTruoc ? 'Đã đổi quà tặng' : 'Đã chọn quà tặng');
      });
    });
  }

  /* Cart: chọn tất cả — trước đây KHÔNG tự đổi trạng thái ô tick của chính nó
     nên bấm mấy lần cũng chỉ tick lại tất cả, không bỏ tick được. Giờ đảo trạng
     thái rồi mới áp xuống các dòng (bỏ qua dòng đã xoá). */
  const selAll = root.querySelector('#selectAll');
  if (selAll) selAll.addEventListener('click', () => {
    /* Trạng thái đích suy từ STATE (không đọc class của chính ô tổng): đang
       chọn hết -> bỏ hết, còn lại -> chọn hết. Đọc class thì sau khi bỏ tick 1
       dòng, cú bấm đầu tiên lại đi bỏ tick nốt phần còn lại. */
    /* Món hết hàng đứng NGOÀI luật "chọn tất cả": nó không mua được nên không
       tính vào "tất cả", và cũng không được tick lên theo. */
    const items = cartItems().filter(c => c.stock !== 0);
    const on = !(items.length && items.every(c => c.sel !== false));
    root.querySelectorAll('.cart-row:not(.is-oos) .chk').forEach(c => c.classList.toggle('on', on));
    items.forEach(c => { c.sel = on; });
    cartBusy(root);
    refreshCartAll(root);
  });
  /* Nút #delSelected — nhãn nay chỉ còn "Xoá" (rút gọn 25/09/2026); trước là
     "Xóa sản phẩm đã chọn". Hành vi KHÔNG đổi: nó vẫn xoá đúng các món ĐANG TÍCH,
     chứ không phải xoá cả giỏ — nhãn ngắn đi nhưng phạm vi thì không.
     (11/09/2026) — KHÔNG còn bấm hộ từng nút xoá nữa.
     Cách cũ đẻ ra N toast chồng nhau, mà cái cuối cùng chỉ hoàn tác được đúng
     một món. Nay: dọn cả nhóm trong một lượt, vẽ lại màn, và MỘT toast hoàn tác
     trả về nguyên nhóm kèm đúng trạng thái tick của từng món. */
  const delSel = root.querySelector('#delSelected');
  if (delSel) delSel.addEventListener('click', () => {
    const picked = cartItems().filter(c => c.sel !== false);
    if (!picked.length) { toast('Chưa chọn sản phẩm nào'); return; }
    const snap = picked.map(c => ({ c, sel: c.sel }));
    picked.forEach(c => { c.removed = true; c.sel = false; });
    rerenderCart();
    toast(`Đã xóa ${picked.length} sản phẩm`, { label: 'Hoàn tác', fn: () => {
      snap.forEach(({ c, sel }) => { c.removed = false; c.sel = sel; });
      rerenderCart();
      toast('Đã khôi phục ' + snap.length + ' sản phẩm');
    } });
  });

  // Cart: Đặt hàng — khách -> popup đăng nhập nhanh (2858:42899); đã đăng nhập -> checkout
  // (dùng data-checkout riêng, KHÔNG dùng chung data-order với nút "Chi tiết" đơn
  // hàng ở Account — trước đây trùng attribute nên bấm "Đặt hàng" cũng bị dính
  // luôn handler go('order') ở dưới, đẩy sang sai trang chi tiết đơn hàng.)
  root.querySelectorAll('[data-checkout]').forEach(b => b.addEventListener('click', () => {
    /* Không còn món nào được tick thì không cho sang thanh toán: trước khi giỏ
       có state thật, tạm tính là hằng số nên chuyện này không xảy ra được; giờ
       bỏ tick hết là đơn 0 đ với đủ 4 món in ra. */
    if (root.querySelector('#cartList') && !cartSelected().length) {
      toast('Hãy chọn ít nhất 1 sản phẩm');
      return;
    }
    /* Ép mở lại bước "Vận chuyển" mỗi lần vào checkout — kể cả lượt quay lại
       giỏ rồi vào lại. Không có dòng này thì ckStep còn giữ giá trị của lượt
       trước và rơi thẳng vào bước giữa. ckMaxStep GIỮ NGUYÊN nên các bước đã
       xong vẫn ở dạng tóm tắt, không mất dữ liệu. Xem ghi chú ở screenCHECKOUT. */
    ckStep = 0;
    if (ckAuth) go('checkout');
    else if (window.__openLoginPop) window.__openLoginPop();
  }));

  // Nút "Áp dụng" chỉ active khi input có nội dung (giống pattern szAdd ở size sheet)
  const bindApplyGate = (inputEl, btnEl) => {
    if (!inputEl || !btnEl) return;
    const update = () => {
      const has = (inputEl.value || '').trim().length > 0;
      btnEl.disabled = !has;
      btnEl.style.opacity = has ? '1' : '.4';
    };
    inputEl.addEventListener('input', update);
    update();
  };
  bindApplyGate(root.querySelector('#pbh'), root.querySelector('#applyPbh'));

  // Phiếu mua hàng: mỗi mã cộng dồn vào tổng (pbhAmount demo) + có dòng riêng
  // trong summary (theo Figma 3428:55499) — hỗ trợ nhiều mã cùng lúc, xoá qua ×.
  const renderPbhList = () => {
    const list = root.querySelector('#pbhList');
    if (!list) return;
    // Ẩn hẳn khi rỗng, tránh flex gap tạo khoảng trống thừa dưới ô input
    list.className = cartPbh.length ? 'flex gap-2 flex-wrap' : 'hidden';
    list.innerHTML = cartPbh.map((p, i) => `
      <span class="pbh-badge bg-secondary rounded flex items-center gap-1.5 px-2 py-0.5 h-6" data-pbh-idx="${i}">
        <span class="t-single font-medium text-secondary-foreground truncate max-w-[140px]">${p.code}</span>
        <button class="pbh-del w-3 h-3 flex items-center justify-center shrink-0 press [&_svg]:w-3 [&_svg]:h-3">${IcoCross}</button>
      </span>`).join('');
    list.querySelectorAll('.pbh-del').forEach(b => b.addEventListener('click', e => {
      e.stopPropagation();
      const idx = Number(b.closest('.pbh-badge').dataset.pbhIdx);
      const removed = cartPbh.splice(idx, 1)[0];
      renderPbhList();
      refreshCartSummary(root);
      toast('Đã gỡ ' + (removed ? removed.code : 'phiếu mua hàng'));
    }));
  };
  const pbhBtn = root.querySelector('#applyPbh');
  if (pbhBtn) pbhBtn.addEventListener('click', () => {
    const inp = root.querySelector('#pbh');
    const v = inp.value.trim();
    if (!v) return;
    cartPbh.push({ code: v, amount: pbhAmount(v) });
    inp.value = '';
    pbhBtn.disabled = true; pbhBtn.style.opacity = '.4';
    renderPbhList();
    refreshCartSummary(root);
    toast('Đã thêm ' + v);
  });
  renderPbhList();

  /* Cart: ưu đãi — Ô NHẬP MÃ GÕ TAY (chốt khách 09/09/2026, thay hàng thu gọn +
     panel trượt của 17/08). Dùng lại bindApplyGate ngay trên: nút chỉ sáng khi ô có
     chữ. Mã sai / chưa đủ điều kiện báo NGAY TẠI Ô bằng setFieldErr chứ không bằng
     toast — toast bay đi mất, mà đây là lỗi người mua phải sửa trong chính ô đó.
     GIỐNG HỆT index.html — sửa 1 file nhớ sửa cả 2. */
  const vcInp = root.querySelector('#cartCode');
  const vcBtn = root.querySelector('#applyCode');
  bindApplyGate(vcInp, vcBtn);
  if (vcInp) vcInp.addEventListener('input', () => clearFieldErr(vcInp));   // gõ lại thì lỗi cũ hết nghĩa
  const useCartCode = () => {
    if (!vcInp) return;
    /* Luật nằm ở cartApplyCode() — cùng một hàm với ô nhập mã ở màn thanh toán. */
    const res = cartApplyCode(vcInp.value);
    if (res.err) { setFieldErr(vcInp, res.err); return; }
    if (!res.ok) return;
    const code = res.code, old = res.replaced;
    vcInp.value = '';
    if (vcBtn) { vcBtn.disabled = true; vcBtn.style.opacity = '.4'; }
    clearFieldErr(vcInp);
    cartBusy(root);
    refreshCartSummary(root);        // gọi luôn renderVoucherUI -> hàng chip vẽ lại
    toast(old ? `Đã thay ${old} bằng ${code}` : `Đã áp dụng ${code}`);
  };
  if (vcBtn) vcBtn.addEventListener('click', useCartCode);
  if (vcInp) vcInp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); useCartCode(); } });
  renderVoucherUI(root);

  /* Ô nhập mã ở MÀN THANH TOÁN (11/09/2026) — cùng luật, khác chỗ báo và khác
     cách vẽ lại: ở đây phải dựng lại cả màn vì khối tiền của checkout được sinh
     một lần lúc dựng, không có hàm cập nhật tại chỗ như refreshCartSummary(). */
  const ckInp = root.querySelector('#ckCode'), ckBtn = root.querySelector('#ckApplyCode');
  if (ckInp) {
    bindApplyGate(ckInp, ckBtn);
    ckInp.addEventListener('input', () => clearFieldErr(ckInp));
    const useCkCode = () => {
      const res = cartApplyCode(ckInp.value);
      if (res.err) { setFieldErr(ckInp, res.err); return; }
      if (!res.ok) return;
      clearFieldErr(ckInp);
      const scr = document.querySelector('[data-screen="checkout"]');
      if (scr) rerenderCheckout(scr);
      toast(res.replaced ? `Đã thay ${res.replaced} bằng ${res.code}` : `Đã áp dụng ${res.code}`);
    };
    if (ckBtn) ckBtn.addEventListener('click', useCkCode);
    ckInp.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); useCkCode(); } });
  }
  renderCkCodes(root);

  // Show more → skeleton then append
  const sm = root.querySelector('#showMore');
  if (sm) {
    /* Bộ lọc ra 0 kết quả thì ẩn cả cụm nút (và updatePlpProgress ẩn thanh tiến
       độ): không còn gì để nối thêm, nút đứng dưới khối "không khớp bộ lọc" là
       một ngõ cụt. renderPlpGrid toggle lại mỗi lần áp/xoá bộ lọc; dòng này lo
       cho lượt render màn đầu tiên khi bộ lọc cũ vẫn đang ra 0. */
    syncShowMore(root);
    sm.addEventListener('click', () => {
    /* Lượt kế tiếp = PLP_PER_PAGE sản phẩm NGAY SAU chỗ đang dừng. Đọc từ
       sortedProducts() (đã lọc + đúng ngành), KHÔNG phải PRODUCTS thô: bản
       trước nhồi 4 sản phẩm Versace thời trang vào mọi lưới, kể cả khi bộ lọc
       đang ra 0 kết quả -> 4 thẻ nằm ngay dưới câu "không khớp bộ lọc".
       Hết hàng thì thoát — nút đáng lẽ đã ẩn qua syncShowMore, đây là chốt chặn. */
    const from = plpShownCount(root);
    const more = sortedProducts().slice(from, from + PLP_PER_PAGE);
    if (!more.length) return;
    const grid = root.querySelector('#plpGrid') || sm.closest('[data-scroller]').querySelector('.grid');
    sm.innerHTML = `<svg class="spin" width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="var(--general-primary)" stroke-opacity=".2" stroke-width="2"/><path d="M14.5 8A6.5 6.5 0 0 0 8 1.5" stroke="var(--general-primary)" stroke-width="2" stroke-linecap="round"/></svg> Đang tải`;
    localizeNew(sm);
    /* Số ô xám = ĐÚNG số thẻ sắp nối. Đổ cứng 24 ô rồi chỉ trả về 16 thẻ là
       lưới tụt một nhịp ngay trước mắt người xem. */
    const skels = Array(more.length).fill(`<div class="flex flex-col"><div class="skel w-full" style="aspect-ratio:189/252"></div><div class="px-1 py-2 flex flex-col gap-1"><div class="skel h-3 w-2/3 rounded"></div><div class="skel h-3 w-full rounded"></div><div class="skel h-3 w-1/2 rounded"></div></div></div>`).join('');
    grid.insertAdjacentHTML('beforeend', skels);
    setTimeout(() => {
      grid.querySelectorAll('.skel').forEach(s => s.closest('.flex-col').remove());
      /* Thẻ append dựng CÙNG options với renderPlpGrid (badge + pillBadges):
         bản trước chỉ truyền {w:'reveal'} nên SP#4 xuất hiện lần 2 mất nhãn
         New Season/La Vacanza — cùng một SP hai kiểu thẻ trên một lưới. */
      more.forEach(({ p, i }) => {
        grid.insertAdjacentHTML('beforeend', productCard(p, i, { w: 'reveal', badge: p.preorder ? 'Pre-order' : '', pillBadges: pcCollectionBadges(i) }));
      });
      sm.innerHTML = 'Xem thêm';
      localizeNew(sm);
      /* CHỈ wire phần vừa thêm, KHÔNG gọi wire(root): wire(root) gắn CHỒNG
         listener toàn màn — đo được sau 2 lượt bấm: menu Sắp xếp không mở nổi
         (toggle chạy nhiều lần/click) và lượt sau append 8 thẻ thay vì 4.
         wireProductCards tự bỏ qua thẻ đã wired (data-wired). */
      wireProductCards(grid);
      localizeNew(grid);   // EN mode: badge "Đặt trước" trên thẻ mới phải ra "Pre-order"
      observeReveal(root);
      syncShowMore(root);   // nối tới thẻ cuối thì nút tự ẩn — không còn ngõ cụt
      updatePlpProgress(root);
    }, 900);
    });
  }

  // brand description expand / collapse
  const bToggle = root.querySelector('#brandToggle');
  if (bToggle) {
    const para = root.querySelector('#brandDesc p');
    let open = false;
    const apply = () => {
      para.style.display = '-webkit-box';
      para.style.webkitBoxOrient = 'vertical';
      para.style.overflow = 'hidden';
      para.style.webkitLineClamp = open ? 'unset' : '3';
      bToggle.textContent = open ? 'Thu gọn' : 'Xem thêm';
      localizeNew(bToggle);   // EN mode: gán động xong phải dịch lại, không thì bấm 1 lần là nút quay về tiếng Việt
    };
    apply();
    bToggle.addEventListener('click', () => { open = !open; apply(); });
  }

  // category cards -> PLP chế độ danh mục
  root.querySelectorAll('[data-cate]').forEach(b =>
    b.addEventListener('click', () => goPlp({ type: 'category', title: b.dataset.cate, crumbs: [] })));

  // (Đã xoá 12/08/2026: handler .brand-chip — không có element nào mang class
  //  này trong markup desktop, handler mồ côi từ fork mobile.)

  // Bộ lọc -> bottom sheet ; Sắp xếp -> dropdown thật
  root.querySelectorAll('[data-sheet]').forEach(b =>
    b.addEventListener('click', () => { if (b.dataset.sheet === 'filter') openFilter(); }));

  const sortBtn = root.querySelector('#sortBtn');
  const sortMenu = root.querySelector('#sortMenu');
  if (sortBtn && sortMenu) {
    sortBtn.addEventListener('click', e => {
      e.stopPropagation();
      sortMenu.classList.toggle('hidden');
    });
    sortMenu.querySelectorAll('[data-sort]').forEach(opt => {
      opt.addEventListener('click', () => {
        plpSort = opt.dataset.sort;
        sortMenu.classList.add('hidden');
        sortMenu.querySelectorAll('[data-sort]').forEach(o => {
          const isOn = o.dataset.sort === plpSort;
          o.classList.toggle('font-medium', isOn);
          o.classList.toggle('text-foreground', isOn);
          o.classList.toggle('text-foreground-alt', !isOn);
          const tick = o.querySelector('svg');
          if (isOn && !tick) o.insertAdjacentHTML('beforeend', '<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--general-primary)"><path d="M8.41,21c-.59,0-1.144-.229-1.561-.646L.026,13.53l.707-.707,6.823,6.823c.457,.455,1.25,.455,1.707,0L23.288,5.622l.707,.707-14.024,14.024c-.417,.417-.971,.646-1.561,.646Z"/></svg>');
          if (!isOn && tick) tick.remove();
        });
        // nhãn nút = giá trị đang chọn (Figma: "Giá : Tăng dần"), mặc định vẫn là "Sắp xếp"
        const sLabel = root.querySelector('#sortBtnLabel');
        if (sLabel) {
          sLabel.textContent = plpSort === 'relevance' ? 'Sắp xếp' : (SORT_OPTIONS.find(([id]) => id === plpSort) || [, 'Sắp xếp'])[1];
          localizeNew(sLabel);
        }
        renderPlpGrid(root, { skeleton: true });
      });
    });
    const closeSortMenu = () => sortMenu.classList.add('hidden');
    document.addEventListener('click', closeSortMenu);
    scrollCleanups.push(() => document.removeEventListener('click', closeSortMenu));
  }

  // (đã bỏ khối toggle class .merged — navbar không còn viền dưới nên không còn
  //  điểm tách cần giấu khi thanh Bộ lọc dính sát đáy nav)

  // scroll-driven behaviour (cuộn theo body — như website thật)
  {
    const pdpSticky = root.querySelector('#pdpStickyCta');
    const pdpCta    = root.querySelector('#pdpCta');
    const cartSticky= root.querySelector('#cartStickyCta');
    const cartCta   = root.querySelector('#cartCta');

    if (pdpSticky || cartSticky) {
      const onScroll = () => {
        const vh = window.innerHeight;
        if (pdpSticky && pdpCta) {
          const r = pdpCta.getBoundingClientRect();
          const show = r.bottom < 0 || r.top > vh;      // nút gốc ra khỏi màn hình
          pdpSticky.style.opacity = show ? '1' : '0';
          pdpSticky.style.transform = `translateY(${show ? 0 : 10}px)`;
          pdpSticky.style.pointerEvents = show ? 'auto' : 'none';
        }
        if (cartSticky && cartCta) {
          const r2 = cartCta.getBoundingClientRect();
          const show = r2.bottom < 0 || r2.top > vh;   // nút gốc ra khỏi màn hình
          cartSticky.style.opacity = show ? '1' : '0';
          cartSticky.style.transform = `translateY(${show ? 0 : 10}px)`;
          cartSticky.style.pointerEvents = show ? 'auto' : 'none';
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      scrollCleanups.push(() => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      });
      setTimeout(onScroll, 60);
    }
  }

  root.querySelectorAll('.drag-x').forEach(dragScroll);

  // Chuyển grid 4 cột (02/03/05) / 3 cột (04-Grid3) — density toggle trên filter bar
  // Figma: nút không được chọn dùng State=Disabled → opacity .5, không đổi màu icon
  const plpGrid = root.querySelector('#plpGrid');
  root.querySelectorAll('[data-grid]').forEach(btn => {
    btn.addEventListener('click', () => {
      const cols = btn.dataset.grid;
      plpCols = cols;
      if (plpGrid) {
        plpGrid.classList.toggle('grid-cols-4', cols === '4');
        plpGrid.classList.toggle('grid-cols-3', cols === '3');
      }
      root.querySelectorAll('[data-grid]').forEach(x => x.classList.toggle('opacity-50', x.dataset.grid !== cols));
    });
  });

  // Chip "bộ lọc đang áp dụng": bỏ từng chip / xóa tất cả
  // (wire() được gọi lại sau "Xem thêm" nên phải khoá chống gắn handler 2 lần —
  //  splice chạy 2 lượt sẽ xoá nhầm chip kế bên)
  bindActiveFilterChips(root);

  // (dkDept được ghi trong chính handler [data-nav] ở trên — phải trước go())
  wireSubheader(root);

  // Dòng khuyến mãi ở PDP2 — mở info sheet với bảng chi tiết (nội dung HTML)
  root.querySelectorAll('[data-promo]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.stopPropagation();
      const p = PROMOS[btn.dataset.promo];
      if (!p || !window.__openInfoSheet) return;
      const body = `
        <div class="flex flex-col gap-4">
          <p class="t-multiline font-medium text-foreground">${p.line}</p>
          <div class="flex flex-col gap-3">
            ${p.rows.map(([k, v]) => `
              <div class="flex flex-col gap-1">
                <span class="t-single text-muted-foreground">${k}</span>
                <span class="t-multiline text-secondary-foreground">${v}</span>
              </div>`).join('')}
          </div>
        </div>`;
      window.__openInfoSheet(p.title, body, true);
    });
  });

  // Mục lục trang chính sách — bấm để mở đúng mục (nay là accordion đóng mặc
  // định, xem screenPOLICY) rồi nhảy tới đó. Đóng các mục anh em khác cho khớp
  // hành vi loại trừ của accordion (mở 1 mục thì đóng mục còn lại) — không gọi
  // .click() lên .acc-trigger vì nút đó không phân biệt được "mở" khỏi "đóng",
  // ở đây LUÔN muốn mở (không phải bật/tắt) nên set thẳng class.
  root.querySelectorAll('[data-policy-toc]').forEach(btn => {
    btn.addEventListener('click', () => {
      const sec = root.querySelector(`[data-policy-sec="${btn.dataset.policyToc}"]`);
      if (sec) {
        [...sec.parentElement.children].forEach(sib => {
          if (sib.classList && sib.classList.contains('acc')) sib.classList.toggle('open', sib === sec);
        });
      }
      sec?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  wireRail(root);
  wireInsta(root);
  wireHeroDots(root);

  // Nút mũi tên cuộn category strip (PLP brand hero)
  root.querySelectorAll('[data-strip-next]').forEach(b => b.addEventListener('click', () => {
    const strip = b.parentElement.querySelector('.drag-x');
    if (strip) strip.scrollBy({ left: 316, behavior: 'smooth' });
  }));

  /* Swatch card KHÔNG wire ở đây nữa — đã dọn vào wireProductCards (28/08) để
     lưới dựng lại bằng renderPlpGrid không mất handler; xem chú thích bên đó. */

  wireBrandHub(root);
  // breadcrumb của lưới hãng có hub: đoạn hãng quay về trang hub
  root.querySelectorAll('[data-bh-hub]').forEach(b => b.addEventListener('click', () => goPlp({ type: 'brand', brand: plpBrandName() })));
  observeReveal(root);
}

function spinnerSVG() {
  return '<svg class="spin" width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-opacity=".25" stroke-width="2"/><path d="M14.5 8A6.5 6.5 0 0 0 8 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
}

/* ── 1 điểm vào duy nhất sau MỌI thay đổi giỏ (tick / số lượng / xoá) ──
   Thứ tự bắt buộc: tính lại tiền TRƯỚC rồi mới dựng quà, vì quà theo đơn đọc
   cartSubtotal(). Gọi hàm này thay vì rải rác từng chỗ để không bao giờ có
   trạng thái "tổng đã đổi mà quà chưa đổi". */
function refreshCartAll(root) {
  if (!root || !root.querySelector('#cartList')) return;   // không phải màn giỏ
  /* NÚT ĐẶT HÀNG PHẢI NHÌN RA LÀ ĐANG KHOÁ khi không còn món nào được tick
     (11/09/2026). Chốt chặn logic đã có sẵn ở chỗ bắt `[data-checkout]` (bấm thì ra
     toast "Hãy chọn ít nhất 1 sản phẩm"), nhưng nút vẫn đen nhánh y như bấm được —
     người mua chỉ biết mình sai SAU khi bấm, mà tạm tính lúc đó đang là 0đ.
     `disabled` là đủ, không phải thêm class mới: bộ da đã có sẵn rule
     `button[disabled], [aria-disabled="true"] { opacity: .5 }`. */
  const canBuy = cartSelected().length > 0;
  root.querySelectorAll('[data-checkout]').forEach(b => {
    b.disabled = !canBuy;
    b.setAttribute('aria-disabled', String(!canBuy));
  });
  refreshCartSummary(root);
  refreshCartGifts(root);
  const items = cartItems();
  const cnt = root.querySelector('#cartCount');
  if (cnt) cnt.textContent = `(${items.length} sản phẩm)`;
  // ô tick tổng luôn nói đúng: chỉ "on" khi còn món và MỌI món đang được chọn
  const master = root.querySelector('#selectAll .chk');
  if (master) master.classList.toggle('on', items.length > 0 && items.every(c => c.sel !== false));
  /* 28/09/2026 (brief tr.19, user chốt 2A): giỏ rỗng thì ẨN hàng "Chọn tất cả · Xoá" —
     không còn món nào để tick/xoá. Ẩn cả ở lượt cập nhật tại chỗ, không chỉ lúc render,
     vì xoá món cuối trên trang không dựng lại màn. */
  const selRow = root.querySelector('#selectAll');
  if (selRow && selRow.parentElement) selRow.parentElement.classList.toggle('hidden', items.length === 0);
  const lbl = root.querySelector('#selAllLabel');
  if (lbl && ckAuth) {
    lbl.textContent = `Chọn tất cả ( ${items.length} sản phẩm )`;
    if (LANG === 'en') applyLang(lbl, 'en');
  }
}

/* Dựng lại phần quà cho khớp state hiện tại.
   · quà theo sản phẩm: chèn/gỡ ngay sau đúng dòng item (không đụng dòng khác)
   · quà theo đơn: vẽ lại ruột khối #orderGift
   Chỉ chạy animation .gift-in cho quà VỪA XUẤT HIỆN — quà đang có sẵn mà nháy
   lại mỗi lần bấm +/- thì rối mắt. */
function refreshCartGifts(root) {
  const list = root.querySelector('#cartList');
  if (list) {
    CART.forEach((c, i) => {
      const rowEl = list.querySelector(`.cart-row[data-row="${i}"]`);
      const cur   = list.querySelector(`.gift-group[data-gift-of="${i}"]`);
      const want  = !!(c.gift && GIFT_PROGRAMS[c.gift] && !c.removed && c.sel !== false && rowEl);
      if (want && !cur) {
        rowEl.insertAdjacentHTML('afterend', productGiftHTML(c, i));
        giftAppear(rowEl.nextElementSibling);
      } else if (!want && cur) {
        cur.remove();
      } else if (want && cur) {
        /* Đã có nhóm rồi nhưng nội dung có thể đổi (đổi quà, mở/đóng danh sách)
           -> dựng lại tại chỗ, KHÔNG chạy animation vì quà không mới xuất hiện.
           So bằng CHỮ KÝ (data-sig) chứ KHÔNG so outerHTML: wireLazy() đóng thêm
           class .loaded + data-lazy-wired vào thẻ <img> ngay sau khi chèn, nên
           outerHTML không bao giờ còn bằng chuỗi vừa sinh -> nhóm bị đập đi dựng
           lại mỗi lần bấm bất kỳ đâu trong giỏ (mất animation đang chạy, mất focus). */
        const sig = `${c.gift}|${giftKeyOf(c.gift)}`;
        if (cur.dataset.sig !== sig) {
          cur.outerHTML = productGiftHTML(c, i).trim();
          const el = list.querySelector(`.gift-group[data-gift-of="${i}"]`);
          wireLazy(el);
          if (LANG === 'en') applyLang(el, 'en');
        }
      }
    });
  }
  const box = root.querySelector('#orderGift');
  if (box) {
    const had = [...box.querySelectorAll('[data-gift-tier]')].map(el => el.dataset.giftTier);
    box.innerHTML = orderGiftInner();
    wireLazy(box);                       // ảnh vừa dựng lại cũng cần .loaded
    if (LANG === 'en') applyLang(box, 'en');
    box.querySelectorAll('[data-gift-tier]').forEach(el => {
      if (!had.includes(el.dataset.giftTier)) giftAppear(el, true);
    });
  }
}

/* img.lazy đứng ở opacity 0 cho tới khi có class .loaded. Chỗ gắn class đó nằm
   trong wire() — chỉ chạy lúc dựng màn — nên MỌI ảnh chèn lúc chạy (dòng quà)
   phải gọi lại hàm này, không thì ảnh quà trong suốt vĩnh viễn. */
function wireLazy(root) {
  root.querySelectorAll('img.lazy').forEach(img => {
    if (img.dataset.lazyWired) return;
    img.dataset.lazyWired = '1';
    if (img.complete) img.classList.add('loaded');
    else img.addEventListener('load', () => img.classList.add('loaded'));
    img.addEventListener('error', () => { img.style.background = 'var(--general-secondary)'; img.classList.add('loaded'); });
