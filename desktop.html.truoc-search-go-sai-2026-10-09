/* ── Kéo ngang carousel bằng chuột (mobile đã có vuốt native) ── */
function dragScroll(el) {
  let down = false, sx = 0, sl = 0, moved = false;
  const onDown = e => {
    if (e.pointerType === 'touch') return;      // để touch dùng cuộn native
    down = true; moved = false;
    sx = e.clientX; sl = el.scrollLeft;
    el.classList.add('dragging');
  };
  const onMove = e => {
    if (!down) return;
    const dx = e.clientX - sx;
    if (Math.abs(dx) > 3) moved = true;
    el.scrollLeft = sl - dx;
    e.preventDefault();
  };
  const onUp = () => {
    if (!down) return;
    down = false;
    el.classList.remove('dragging');
    /* SNAP TAY KHI NHA CHUOT (08/09/2026) — lo ra ngay sau khi va duoc cu keo.
       Truoc luot nay `scroll-behavior: smooth` lam dai KHONG nhich khi keo, nen nha chuot
       o dau thi van dung dung mot tam — chuyen snap khong bao gio xay ra. Keo chay that
       roi thi lo: `scroll-snap-type` chi snap trong mot THAO TAC CUON, con bo class
       `.dragging` de bat snap tro lai KHONG kich no. Do tren trang: keo 60% roi nha thi
       dai dung o 855/1425, keo 25% thi dung o 356 — hero nghi lung giua 2 tam, dung cai
       loi ma scroll-snap dat o do de tranh.
       CHI LAM CHO DAI CO KHAI SNAP: doc `scroll-snap-type` sau khi da bo `.dragging`
       (rule do khai `none`, doc truoc la ra sai). Trong ca 2 file chi `.hm-hero-track`
       khai snap, nen cac dai san pham/thuong hieu van cuon tu do nhu cu.
       Moc snap = `offsetLeft` cua tung con, TRU offsetLeft cua con dau: con cua dai khong
       lay track lam moc dinh vi (track khong `position: relative`) nen phai quy ve goc.
       Cach nay dung cho mo o be rong bat ky, khong gia dinh o = be rong khung.
       `moved` de mot cu BAM (khong keo) khong lam dai tu nhien nhay. */
    if (!moved) return;
    const snapType = getComputedStyle(el).scrollSnapType;
    if (!snapType || snapType === 'none') return;
    const kids = el.children;
    if (!kids.length) return;
    const base = kids[0].offsetLeft;
    let best = 0, bd = Infinity;
    for (const k of kids) {
      const x = k.offsetLeft - base;
      const d = Math.abs(x - el.scrollLeft);
      if (d < bd) { bd = d; best = x; }
    }
    el.scrollTo({ left: best, behavior: 'smooth' });
  };
  // chặn click nếu vừa kéo (tránh lỡ mở sản phẩm)
  const onClick = e => { if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; } };
  el.addEventListener('pointerdown', onDown);
  el.addEventListener('click', onClick, true);
  el.addEventListener('dragstart', e => e.preventDefault());
  window.addEventListener('pointermove', onMove, { passive: false });
  window.addEventListener('pointerup', onUp);
  window.addEventListener('pointercancel', onUp);
  scrollCleanups.push(() => {
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup', onUp);
    window.removeEventListener('pointercancel', onUp);
  });
}
/* ── Reveal observer ── */
let io;
function observeReveal(root) {
  if (!io) io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.08 });
  root.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
}
