     thiếu cờ này là markup đọc P.colors[0].name rồi ném lỗi cả màn. */
  return { idx: i, installment: '', noColors: !(p.colors && p.colors.length),
           sizes: pcSizesOf(p, i), tabs: pdpTabs(i) };
}

