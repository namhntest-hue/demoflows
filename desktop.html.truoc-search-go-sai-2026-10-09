     để cái bộ lọc tin là bộ mà màn hình đang bày. */
  const s = p.sizes && p.sizes.length ? p.sizes : sizesOf(p);
  return p.brand === 'Zimmermann' ? s.concat(s.map(v => ZIM_SIZE[v]).filter(Boolean)) : s;
}

/* `price` = { min, max }; bỏ trống thì lấy khoảng ĐÃ ÁP. Có tham số này để nút
   Áp dụng đếm theo giá đang gõ mà không phải ghi đè state thật (12/09/2026). */
function matchProducts(list, labels, price) {
  const pMin = price ? price.min : plpPriceMin;
  const pMax = price ? price.max : plpPriceMax;
  const brands = labels.filter(l => FILTER_BRANDS.includes(l));
  /* "Nhiều màu" tách khỏi mảng màu đơn sắc — nó không có bucket HSL, lọc bằng cờ
     `multi` của sản phẩm. Tick nó CÙNG các ô màu khác vẫn là HỢP (OR) như mọi
     facet: "Đen hoặc Nhiều màu". */
  const colors = labels.filter(l => l !== 'Nhiều màu' && FILTER_COLORS.some(([n]) => n === l));
  const multi  = labels.includes('Nhiều màu');
  const flags  = labels.filter(l => FILTER_FLAGS.includes(l));
  const sizes  = labels.filter(l => FILTER_VOLUMES.includes(l));
  const promos = labels.filter(l => FILTER_PROMOS.includes(l));
  const genders = labels.filter(l => FILTER_GENDERS.includes(l));   // nhóm Giới tính — chỉ có ở trang tìm kiếm
  const heels  = labels.filter(l => FILTER_HEELS.some(([n]) => n === l));
  /* DANH MỤC (12/09/2026) — khớp ở BẤT KỲ cấp nào trong đường dẫn của sản phẩm:
     chọn "Quần áo" ra cả nhánh, chọn "Đầm ngắn" ra đúng lá. Tick nhiều ô là HỢP
     (OR) như mọi facet khác. */
  const cats = labels.filter(l => FILTER_CAT_LABELS.has(l));
  /* KÍCH THƯỚC THỜI TRANG & GIÀY (12/09/2026) — nhãn trong plpFilters mang tiền
     tố ("Size XXS", "Size IT/EU 40"), còn PRODUCTS ghi số trần ("40"), nên phải
     bóc tiền tố trước khi so. KHÔNG quy đổi US/UK sang IT: bảng quy đổi trong
     demo là bản tự dựng, quy đổi bằng nó là đoán hộ khách. */
  const fsizes = labels.filter(l => FILTER_SIZE_LABELS.has(l))
                       .map(l => l.replace(/^Size (?:IT\/EU |US |UK )?/, ''));
  return list.filter(({ p }) => {
    if (cats.length) {
      const path = p.cat || [];
      if (!cats.some(c => path.includes(c))) return false;
    }
    if (fsizes.length) {
      const has = sizeTokens(p);
      if (!fsizes.some(v => has.includes(v))) return false;
    }
    /* KHOẢNG GIÁ (12/09/2026) — đọc từ 2 ô Từ/Đến. Bỏ trống thì không chặn đầu
       đó, nên gõ mỗi "Từ" vẫn lọc được. */
    if (pMin != null || pMax != null) {
      const v = vndNum(p.price);
      if (pMin != null && v < pMin) return false;
      if (pMax != null && v > pMax) return false;
    }
    if (genders.length && !genders.includes(p.gender)) return false;
    if (brands.length && !brands.includes(p.brand)) return false;
    if (colors.length || multi) {
      const buckets = (p.colors || []).map(c => colorBucketOf(c.hex));
      const hit = colors.some(c => buckets.includes(c)) || (multi && !!p.multi);
      if (!hit) return false;
    }
    if (flags.includes('Đang giảm giá') && !p.off) return false;
    if (flags.includes('Hàng mới về') && !/new/i.test(p.tag || '')) return false;
    if (flags.includes('Chỉ hàng có sẵn') && p.preorder) return false;
    /* Dung tích LỌC THẬT: 8 sản phẩm beauty trong PRODUCTS có field `sizes` trùng
       khít FILTER_VOLUMES. (Size quần áo/giày thì vẫn không lọc được — PRODUCTS
       không mang size thời trang, chỉ PDP_DATA có.) */
    if (sizes.length) {
      const has = p.sizes || [];
      if (!sizes.some(v => has.includes(v))) return false;
    }
    /* Ưu đãi LỌC THẬT theo mức giảm — xem PROMO_RANGES. Tick nhiều ô là HỢP
       (OR) như mọi facet khác, và các khoảng không chồng nhau nên không đếm
       trùng. Data hiện có: 6 SP giảm 10-30%, 2 SP nguyên giá; 3 khoảng sâu hơn
       chưa có SP nào -> tick vào ra lưới rỗng kèm empty state, đúng như mọi
       facet không khớp khác. */
    if (promos.length) {
      const pct = discountPct(p);
      const hit = promos.some(l => {
        const r = PROMO_RANGES[l];
        return r ? (pct >= r[0] && pct < r[1]) : pct === 0;
      });
      if (!hit) return false;
    }
    /* Độ cao giày (feedback 26/08 #3) — SP không khai `heel` thì KHÔNG khớp mức
       nào, y như cách `sizes` xử SP không khai dung tích. Biên [lo, hi] đóng 2 đầu
       vì bảng của khách đọc là "0 - 5.5" chứ không phải nửa khoảng. */
    if (heels.length) {
      if (p.heel == null) return false;
      const hit = heels.some(l => {
        const r = (FILTER_HEELS.find(([n]) => n === l) || ['', [0, 0]])[1];
        return p.heel >= r[0] && p.heel <= r[1];
      });
      if (!hit) return false;
    }
    return true;
  });
}
/* Mọi nhãn của cây Danh mục, cả 3 cấp — để matchProducts biết label nào đang
   nói về danh mục (12/09/2026). Dựng một lần từ chính FILTER_CATS nên thêm cấp
   vào cây là tập này tự có, không phải khai hai nơi. */
const FILTER_CAT_LABELS = (() => {
  const out = new Set();
  FILTER_CATS.forEach(([l1, subs]) => {
    out.add(l1);
    (subs || []).forEach(([l2, leaves]) => { out.add(l2); (leaves || []).forEach(l3 => out.add(l3)); });
  });
  return out;
})();

/* ── CÂY DANH MỤC: TRA NGƯỢC LÊN CHA (13/09/2026) ───────────────────────────
   Tick một ô danh mục là cây tự lan xuống toàn bộ nhánh con, nên `plpFilters`
   sau khi tick "Quần áo" có 49 nhãn. Bày cả 49 thành chip thì hàng chip dài hơn
   lưới sản phẩm mà không thêm được nghĩa nào. Hai hàm dưới gói lại ở tầng BÀY. */
const FILTER_CAT_PARENT = (() => {
  const m = {};
  FILTER_CATS.forEach(([l1, subs]) => {
    (subs || []).forEach(s => {
      const [l2, leaves] = Array.isArray(s) ? s : [s, []];
      if (l2 !== l1) m[l2] = l1;
      /* BẪY: cây của khách có lá TRÙNG TÊN với chính cha nó ("Túi xách > Túi đeo
         vai > Túi đeo vai"). Ghi thẳng là m[x] = x — một vòng tự trỏ, và vòng
         while tra ngược lên cha chạy vô tận, treo cả trang. Đã treo thật 13/09. */
      (leaves || []).forEach(l3 => { if (l3 !== l2 && l3 !== l1) m[l3] = l2; });
    });
  });
  return m;
})();
/* Bỏ mọi nhãn có CHA (hoặc ông) cũng đang được chọn. Nhãn không thuộc cây danh
   mục (thương hiệu, màu, size…) không có cha nên đi thẳng qua. */
function plpCatTop(labels) {
  const co = new Set(labels);
  return labels.filter(l => {
    /* Chặn 3 vòng: cây chỉ sâu 3 cấp, và chặn cứng để một bản dữ liệu lỗi không
       bao giờ treo được trang lần nữa. */
    let p = FILTER_CAT_PARENT[l];
    for (let i = 0; p && i < 3; i++) { if (co.has(p)) return false; p = FILTER_CAT_PARENT[p]; }
    return true;
  });
}
/* Gỡ chip cha phải gỡ luôn cả nhánh dưới — không thì nhánh con ở lại trong
   plpFilters, lưới vẫn bị lọc y như cũ mà trên trang không còn chip nào để hiểu. */
function plpCatSubtree(label) {
  return Object.keys(FILTER_CAT_PARENT).filter(k => {
    let p = FILTER_CAT_PARENT[k];
    for (let i = 0; p && i < 3; i++) { if (p === label) return true; p = FILTER_CAT_PARENT[p]; }
    return false;
  });
}

const FILTER_PROMOS  = ['Nguyên giá','10% - 30%','30% - 50%','50% - 70%','Trên 70%'];
