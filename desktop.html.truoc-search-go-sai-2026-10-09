   cần bật lại dải gợi ý dạng 5 thẻ. */
function dkRailSection(title, n, selfIdx = -1) {
  /* Thẻ mang thêm class `.dk-rail-item` (qua option `w` của productCard) để lấy
     bề rộng 1/4 dải, và `shrink-0` để flex không bóp chúng lại khi track tràn. */
  const cards = title === 'Gợi ý mua kèm'
    ? lookProducts(selfIdx, n).map(({ p, i }) => productCard(p, i, { noColors: true, model: true, w: 'dk-rail-item shrink-0' })).join('')
    : PRODUCTS.slice(0, n).map((p, i) => productCard(p, i, { noColors: true, w: 'dk-rail-item shrink-0' })).join('');
  /* DẢI RỖNG THÌ KHÔNG DỰNG GÌ (11/09/2026). Một tiêu đề mục đứng trên khoảng
     trắng tệ hơn hẳn việc không có mục đó: nó hứa một dải rồi không đưa ra gì. */
  if (!cards) return '';
  return `
      <div class="px-6 py-8 reveal">
        <div class="pt-8 flex flex-col gap-6">
          <p class="text-[18px] font-medium leading-7 text-foreground">${title}</p>
          <!-- 4 thẻ một lượt + cuộn ngang + mũi tên hiện khi rê (chốt 03/09/2026).
               Class drag-x cho kéo-để-cuộn, no-scrollbar giấu thanh cuộn, mũi tên
               do wireRail() bật/tắt theo hướng CÒN nội dung. Số đo: xem .dk-rail.
               (KHÔNG dấu backtick trong comment này — cả khối nằm trong template
               literal, một dấu backtick là cắt đôi chuỗi. Đã dính 2 lần hôm nay.) -->
          <div class="dk-rail">
            <div class="dk-rail-track drag-x flex gap-1 overflow-x-auto no-scrollbar">${cards}</div>
            <button class="dk-rail-arrow dk-rail-prev press" data-rail-prev hidden aria-label="Xem sản phẩm trước">${I.chevL}</button>
            <button class="dk-rail-arrow dk-rail-next press" data-rail-next hidden aria-label="Xem sản phẩm tiếp">${I.chevR()}</button>
          </div>
        </div>
      </div>`;
}

