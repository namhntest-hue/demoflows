/* Ô tỉnh/thành và phường/xã: mở sheet chọn. Phường phụ thuộc tỉnh nên đổi
   tỉnh là xoá phường đang chọn — giữ lại sẽ ra địa chỉ không tồn tại. */
/* ── Báo lỗi ngay dưới ô nhập ──
   App vốn không validate gì ở checkout (xem AUDIT). Ở bước nhận tại cửa hàng
   thì bắt buộc phải có: nhân viên cửa hàng cần đúng tên + số để giao hàng.
   Lỗi gắn vào input bằng aria-invalid + aria-describedby, viền đỏ bằng class
   .fld-err (tailwind build sẵn không có border-destructive), focus nhảy tới
   ô sai ĐẦU TIÊN. */
/* ── LUẬT KIỂM THEO Ô + KIỂM NGAY KHI RỜI Ô (21/09/2026, lệnh user) ─────────
   Trước lượt này mọi lỗi định dạng chỉ hiện KHI BẤM CTA: gõ sai email ở đầu form thì
   phải điền hết rồi bấm nút mới biết, rồi cuộn ngược lên sửa. Nay rời ô là biết ngay.

   MỘT BẢNG DUY NHẤT cho cả hai đường kiểm — lúc rời ô và lúc bấm CTA. Trước đó cùng
   một regex số điện thoại nằm ở 3 chỗ (validatePickup · validateShipping · closure của
   màn Tài khoản), sửa luật là phải nhớ sửa đủ cả 3 nơi.

   Ô TRỐNG THÌ KHÔNG MẮNG: rời ô khi chưa gõ gì mà đã báo "chưa đúng" là mắng người ta
   vì một việc họ chưa làm — chỉ cần lướt một lượt qua form là đỏ cả màn. Luật "bắt buộc
   nhập" vẫn thuộc về lúc bấm CTA; rời ô chỉ lo ĐỊNH DẠNG của thứ đã gõ. */
const FIELD_RULE = {
  phone: [v => /^0\d{8,10}$/.test(v.replace(/\s/g, '')), 'Số điện thoại chưa đúng'],
  email: [v => /^\S+@\S+\.\S+$/.test(v.trim()),           'Email chưa đúng'],
  /* Ngày sinh: đúng khuôn dd/mm/yyyy VÀ là ngày có thật VÀ không nằm ở tương lai.
     new Date(y, m-1, d) tự TRÀN (31/02 thành 03/03) nên phải so lại cả 3 số mới biết
     ngày vừa gõ có tồn tại hay không. */
  dob: [v => {
    const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(v.trim());
    if (!m) return false;
    const [d, mo, y] = m.slice(1).map(Number);
    const dt = new Date(y, mo - 1, d);
    return y >= 1900 && dt.getFullYear() === y && dt.getMonth() === mo - 1 && dt.getDate() === d && dt <= new Date();
  }, 'Ngày sinh chưa đúng, nhập theo dd/mm/yyyy'],
};

/* Gắn kiểm-khi-rời-ô cho mọi ô mang data-rule. Gọi trong wire() nên màn nào dựng lại
   cũng tự có; cờ data-blurWired chống gắn chồng khi wire() chạy lại trên cùng cây DOM.
   GÕ LẠI là XOÁ LỖI NGAY, không đợi rời ô lần nữa: để viền đỏ trong lúc người ta đang sửa
   là báo sai về một trạng thái không còn đúng nữa. */
function wireBlurCheck(root) {
  root.querySelectorAll('[data-rule]').forEach(el => {
    if (el.dataset.blurWired) return;
    el.dataset.blurWired = '1';
    el.addEventListener('blur', () => {
      const r = FIELD_RULE[el.dataset.rule];
      if (!r) return;
      if (!el.value.trim()) { clearFieldErr(el); return; }
      if (r[0](el.value)) clearFieldErr(el); else setFieldErr(el, r[1]);
    });
    el.addEventListener('input', () => { if (el.classList.contains('fld-err')) clearFieldErr(el); });
  });
}

function clearFieldErr(inp) {
  inp.classList.remove('fld-err');
  inp.removeAttribute('aria-invalid');
  const id = inp.getAttribute('aria-describedby');
  if (id) { const p = document.getElementById(id); if (p) p.remove(); inp.removeAttribute('aria-describedby'); }
}
function setFieldErr(inp, msg) {
  clearFieldErr(inp);
  /* 21/09/2026 — một số ô của màn xác thực dựng qua afield không truyền id, nên eid
     ra thành 'err-' cho MỌI ô: hai ô cùng sai là hai thẻ <p> TRÙNG id, xoá lỗi ô này
     gỡ nhầm lỗi ô kia. Cấp id ngay tại đây cho ô nào chưa có. */
  if (!inp.id) inp.id = 'fe' + (++_fldId);
  inp.classList.add('fld-err');
  inp.setAttribute('aria-invalid', 'true');
  const eid = 'err-' + inp.id;
  inp.setAttribute('aria-describedby', eid);
  /* ĐỔI SANG FIELD NỔI (15/09/2026) -- <label> phải là ANH EM KỀ NGAY của
     <input> (CSS +); chèn <p> lỗi thẳng afterend của input là chen vào GIỮA input
     và label, gãy :not(:placeholder-shown) + label nên nhãn rơi về giữa ô, đè
     lên chữ đã gõ. Neo vào .field-float (trùm cả input lẫn label) thay vì bản
     thân input: closest() trả về CHÍNH nó khi input không nằm trong field-float
     (case ô CHọN ở dưới truyền thẳng div làm inp), nên không đổi hành vi cũ. */
  const anchor = inp.closest('.field-float') || inp;
  anchor.insertAdjacentHTML('afterend', `<p id="${eid}" class="t-single mt-1 text-destructive">${msg}</p>`);
  const p = document.getElementById(eid);
  if (p) localizeNew(p);
}
/* 6 ô OTP không có ô nào là "ô chính" để gắn lỗi: setFieldErr chèn <p> vào
   `afterend` của phần tử truyền vào, mà afterend của một ô thì rơi vào GIỮA hàng
   flex. Nên truyền CẢ HÀNG `#otpRow` — <p> rơi ngay dưới hàng, đúng chỗ; lớp
   `.fld-err` bám vào div không viền nên vô hình, không hại gì.
   Tô đỏ 6 ô phải làm riêng, và gỡ khi gõ lại. */
function otpErr(root, msg) {
  const row = root.querySelector('#otpRow');
  if (!row) return;
  const cells = [...row.querySelectorAll('.otp-cell')];
  if (!msg) { clearFieldErr(row); cells.forEach(c => c.classList.remove('fld-err')); return; }
  setFieldErr(row, msg);
  cells.forEach(c => {
    c.classList.add('fld-err');
    c.addEventListener('input', () => otpErr(root, ''), { once: true });
  });
}
function validatePickup(root) {
  const get = k => root.querySelector(`[data-ckf="${k}"]`);
  const rules = [
    [get('pfirst'), v => !!v.trim(),                      'Vui lòng nhập tên'],
    [get('plast'),  v => !!v.trim(),                      'Vui lòng nhập họ'],
    [get('phone'), FIELD_RULE.phone[0], FIELD_RULE.phone[1]],
    [get('email'), v => !v.trim() || FIELD_RULE.email[0](v), FIELD_RULE.email[1]],
  ];
  let first = null;
  rules.forEach(([inp, ok, msg]) => {
    if (!inp) return;
    if (ok(inp.value)) { clearFieldErr(inp); return; }
    setFieldErr(inp, msg);
    if (!first) first = inp;
  });
  if (first) { first.focus({ preventScroll: true }); first.scrollIntoView({ block: 'center', behavior: 'smooth' }); }
  return !first;
}

/* Kiểm định dạng ngay khi bấm Xác nhận ở bước Vận chuyển (nhánh giao hàng) —
