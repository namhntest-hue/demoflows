/* ── DẢI CUỘN NGANG NHẬN DANH SÁCH ─────────────────────────────────────────────
   `dkRailSection` in cứng `PRODUCTS.slice(0, n)` nên không chở được danh sách đã lọc.
   Hàm này tách riêng phần DẢI (không có tiêu đề) để `hmSec` lo hàng tiêu đề.
   Nút PHẢI mang CẢ class vị trí (`.dk-rail-prev`/`.dk-rail-next`) VÀ attribute
   (`data-rail-prev`/`data-rail-next`): `wireRail()` bám ATTRIBUTE, còn CSS bám CLASS. */
/* `opts` (15/09/2026) = bộ option đi THẲNG vào productCard, ghi đè mặc định của dải.
   Sinh ra cho `noPrice` của dải Hàng mới về, và cờ đó phải nằm ở CHỖ GỌI chứ không ở
   trong này: hmRail còn phục vụ dải Đang giảm giá — dải mà bỏ giá đi là mất luôn nghĩa,
   vì giá gạch và phần trăm giảm chính là nội dung của nó. */
function hmRail(list, opts = {}) {
  return `
          <div class="dk-rail">
            <div class="dk-rail-track drag-x flex gap-1 overflow-x-auto no-scrollbar">
              ${list.map(({ p, i }) => productCard(p, i, { noColors: true, noName: true, noQuick: !HM_SHOW.quickAdd, quickPerRow: HM_QUICK_PER_ROW, quickMaxRows: HM_QUICK_MAX_ROWS, w: 'hm-rail-item shrink-0', ...opts })).join('')}
            </div>
            <button class="dk-rail-arrow dk-rail-prev press" data-rail-prev hidden aria-label="Xem sản phẩm trước">${I.chevL}</button>
            <button class="dk-rail-arrow dk-rail-next press" data-rail-next hidden aria-label="Xem sản phẩm tiếp">${I.chevR()}</button>
          </div>`;
}

/* Dải sản phẩm đầu trang chủ theo công tắc `hmBlock` (xem chú thích ở HM_SHOW). Hai nhánh cùng khuôn:
     new  : nhãn "Hàng mới về"  · dòng trưng bày HM_NEW_LINE   · thẻ = SP nguyên giá
     sale : nhãn "Khuyến mãi"   · dòng trưng bày HM_SALE_TITLE · thẻ = SP đang giảm
   Cả hai gọi hmRail với { noName: false, noQuick: true, tight: true }: hãng · tên · giá, không màu, không
   quick add, thẻ ôm sát (cờ tight chỉ bỏ hàng giá gạch khi thẻ KHÔNG giảm giá nên thẻ Khuyến mãi vẫn đủ
   giá gạch + chip %). Tag 'h1' giữ nguyên cho cả hai vì đây vẫn là tiêu đề chính của trang. */
function hmFeatured(news, sales) {
  const sale = hmBlock === 'sale';
  const list = sale ? sales : news;
  if (!list.length) return '';
  return hmSec(sale ? HM_SALE_TITLE : HM_NEW_LINE,
    hmLink('Xem tất cả', sale ? dkCatAttrs('Khuyến mãi') : dkCatAttrs('Sản phẩm mới', [hmFashionDept()])),
    hmRail(list, { noName: false, noQuick: true, tight: true }),
    'h1', sale ? 'Khuyến mãi' : 'Hàng mới về');
}

