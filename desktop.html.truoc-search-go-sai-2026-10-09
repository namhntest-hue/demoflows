  /* ACCOUNT: hàng tab. 05/09/2026 — cờ đổi sang `aria-current`, và KHÔNG dựng lại
     className nữa. Bản cũ ghi đè cả chuỗi class bằng một chuỗi in cứng có `text-[14px]`
     nên nhãn tab NHẢY CỠ ngay cú bấm đầu tiên; nay cỡ do markup giữ, trạng thái do
     `.acc-tab[aria-current]` lo, và `<span class="acc-tab-underline">` đã gỡ khỏi cả
     markup lẫn đây (để lại một trong hai là vỡ: querySelector trả null -> TypeError).
     `#accTitle` cũng gỡ — h1 nay nằm trong accountBody() nên tự vẽ lại theo innerHTML. */
  root.querySelectorAll('[data-atab]').forEach(btn => {
    btn.addEventListener('click', () => {
      accountTab = btn.dataset.atab;
      /* 28/09/2026 — mục lục + link "‹ Đơn hàng" nay còn sống ở màn Chi tiết đơn, nơi không
         có #accBody để vẽ lại tại chỗ: đứng ngoài màn Tài khoản thì chuyển hẳn sang màn đó,
         mở đúng tab vừa bấm. */
      if (current !== 'account') { memberView = ''; accResetForms(); go('account'); return; }
      /* 20/09/2026 — đổi tab là về trang chính của tab đó: không để lớp con "lịch sử
         điểm" còn bật khi người dùng bấm sang tab khác rồi quay lại. */
      memberView = '';
      accResetForms();   // rời tab là bỏ form đang mở (form đó sẽ bị innerHTML xoá)
      root.querySelectorAll('[data-atab]').forEach(x => {
        if (x.dataset.atab === accountTab) x.setAttribute('aria-current', 'true');
        else x.removeAttribute('aria-current');
      });
      const body = root.querySelector('#accBody');
      /* 22/09/2026 — wire(body) chứ KHÔNG wire(root): root là cả màn, nối lại là header/tab/
         Đăng xuất nhận thêm một listener MỖI lượt đổi tab (đo 22/09: 3 lượt -> một click icon
         giỏ gọi go() 8 lần). Chỉ ruột tab là phần tử mới, chỉ ruột tab cần nối. */
      if (body) { body.innerHTML = accountBody(); wire(body); localizeNew(body); }
      /* 28/09/2026 (lệnh user: "làm theo phương án A cả 2 bản luôn đi") — đổi tab là cuộn về
         ĐẦU TRANG, y như go() lúc mới vào màn, nên tiêu đề tab mới luôn đứng đúng một chỗ.
         Trước đó trang giữ nguyên độ cuộn của tab cũ: cuộn dở ở "Đơn hàng" rồi bấm "Sổ địa
         chỉ" là tiêu đề khuất phía trên, khách rơi thẳng vào giữa danh sách. Bấm lại chính
         tab đang mở cũng về đầu trang. Cuộn TỨC THÌ: html không khai scroll-behavior. */
      window.scrollTo(0, 0);
    });
  });
  // Đăng xuất từ trang account
  root.querySelectorAll('[data-logout]').forEach(btn => btn.addEventListener('click', () => { ckAuth = false; go('plp'); toast('Đã đăng xuất'); }));

