  const panel = gf.querySelector('.gf-panel');
  const list = gf.querySelector('#gfList');
  let onPick = null, curPk = null;
  /* `tam` = lựa chọn TẠM trong lớp trượt, {chương trình: khoá quà}. Chỉ ghi vào giỏ
