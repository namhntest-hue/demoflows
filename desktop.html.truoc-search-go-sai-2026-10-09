/* 06/10/2026 — tham số thứ 6 `act` = HTML một nút hành động nằm TRONG ô, sát phải (vd "Gửi mã OTP" ở ô SĐT của trang Đăng ký; khuôn `.fld-act`). Ô có `act` mang class `.has-act` để chừa chỗ bên phải cho chữ đang gõ. Mọi chỗ gọi cũ không truyền ⇒ không đổi. */
const afield = (label, attrs, ph, extra = '', labelCls = 'text-muted-foreground', act = '') => {
  const isPass = /type="password"/.test(attrs);
  /* 21/09/2026 — ô của màn xác thực nhận attrs dưới dạng CHUỔI thô nên không có khoá
