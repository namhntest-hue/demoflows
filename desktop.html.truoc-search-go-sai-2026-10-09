    if (cta.dataset.mode === 'add') {
      const img = document.querySelector('#pdpGallery img');
      if (img) flyToCart(img);
      if (onPick) onPick(selected);
      closeSZ();
      const p = PRODUCTS[screenProductIdx()];
      const colorEl = document.querySelector('.screen #colorName');
      const variant = [colorEl ? colorEl.textContent.trim() : '', selected].filter(Boolean).join(' , ');
      addToCart({
        img: `${A}${p.img}`, brand: p.brand, name: p.name, variant,
        price: p.price, off: p.off, was: p.was, preorder: p.preorder,
