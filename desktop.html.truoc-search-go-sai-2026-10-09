/* Chọn bản dải gợi ý bằng tham số URL. Từ 02/09/2026 tham số này áp cho CẢ 6
   PDP chứ không riêng PDP#1, và MẶC ĐỊNH LÀ A ở mọi màn (user chốt bản A).
   B và C giữ lại làm công cụ SO SÁNH (`?look=b` · `?look=c`) chứ không còn là
   khuôn mặc định của màn nào — để ở tham số chứ không phải bộ da vì đây là
   phương án bố cục đang so, không phải style thử; link khách nhận vẫn sạch. */
const LOOK_VARIANT = (() => {
  try { return (new URLSearchParams(location.search).get('look') || 'a').toLowerCase(); }
  catch (e) { return 'a'; }
})();

/* Tra khuôn theo tham số. Khai bằng bảng thay vì chuỗi ternary ở chỗ gọi để
   thêm/bớt phương án chỉ sửa MỘT chỗ. Tham số lạ thì rơi về bản A. */
const LOOK_SECTIONS = { a: dkLookSection, b: dkLookSectionB, c: dkLookSectionC };

/* Khuôn PDP của SP chưa có màn riêng (idx 6 trở đi) — dựng tại chỗ từ chính
   data sản phẩm, thay vì mượn nguyên PDP_DATA.pdp của SP#1 như trước 02/09. */
function pdpDataFor(i) {
  if (i === 0) return PDP_DATA.pdp;
  const p = PRODUCTS[i] || PRODUCTS[0];
  /* noColors đi theo ĐÚNG hợp đồng sẵn có của PDP_DATA: khối chọn màu chỉ dựng
