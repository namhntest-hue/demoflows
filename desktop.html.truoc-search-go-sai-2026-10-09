              <button class="del w-3.5 h-3.5 shrink-0 flex items-center justify-center press" aria-label="Xóa sản phẩm">${I.trash}</button>
            </div>
            <!-- 03/09/2026: badge "Đặt trước" THÔI đè góc ảnh, xuống ĐỨNG TRƯỚC
                 TÊN cùng hàng với tên — đúng khuôn thẻ PLP chốt 27/08 (lệnh user
                 "đồng bộ cách đặt badge đặt trước trước tên sản phẩm cho toàn bộ
