/* Điều kiện áp mã tính trên GIỎ HIỆN TẠI: bỏ tick / giảm số lượng là mã có thể
   rớt điều kiện — xem pruneVouchers(). */
/* ── HẠN DÙNG (11/09/2026, lệnh user) ─────────────────────────────────────────
   Trước lượt này KHÔNG có chỗ nào đọc `exp`: gõ JUNE2000 (hết hạn 30/06/2026, cờ
   `hidden`) là demo nhận và trừ 2.000.000đ. Ngày trong catalog ghi kiểu Việt
   "dd/mm/yyyy" nên phải tự tách, `new Date('30/06/2026')` trả Invalid Date.
   So tới HẾT ngày hết hạn (cộng 1 ngày rồi so "nhỏ hơn"): mã ghi 30/09 thì suốt
   ngày 30/09 vẫn dùng được, đúng cách người ta đọc một tờ voucher. */
function voucherExpired(v) {
  if (!v || !v.exp) return false;
  const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(String(v.exp).trim());
  if (!m) return false;                       // ngày lạ -> KHÔNG tự ý chặn
  const end = new Date(+m[3], +m[2] - 1, +m[1] + 1);
  return new Date() >= end;
}
function voucherEligible(v) {
  if (!v) return false;
  if (voucherExpired(v)) return false;
  if (v.minSub && cartSubtotal() < v.minSub) return false;
  if (v.minQty && cartSelectedQty() < v.minQty) return false;
  return true;
}
/* Lý do chưa dùng được — hiện ngay trên thẻ ưu đãi (thay vì chỉ làm mờ nó) */
function voucherBlockReason(v) {
  if (voucherExpired(v)) return `Mã đã hết hạn ngày ${v.exp}`;
  if (v.minSub && cartSubtotal() < v.minSub) return `Mua thêm ${(v.minSub - cartSubtotal()).toLocaleString('en-US')}đ để dùng mã`;
  if (v.minQty && cartSelectedQty() < v.minQty) return `Cần mua từ ${v.minQty} sản phẩm`;
  return '';
}
function voucherValue(v) {
  if (!v) return 0;
  if (v.type === 'amount')  return v.amount;
  if (v.type === 'percent') return Math.min(Math.round(cartSubtotal() * v.pct / 100), v.cap || Infinity);
  return 0;                               // 'ship' không trừ vào tiền hàng
}
const activeVouchers    = () => cartVouchers.map(voucherByCode).filter(v => v && voucherEligible(v));
const cartVoucherTotal  = () => activeVouchers().reduce((s, v) => s + voucherValue(v), 0);
/* Giỏ teo lại (bỏ tick / bớt số lượng) thì mã hết điều kiện phải TỰ RỚT, không
   thì tóm tắt in ra một khoản giảm mà đơn không được hưởng. Trả về danh sách mã
   vừa rớt để chỗ gọi báo cho người dùng biết. */
/* ÁP MỘT MÃ — luật gốc, dùng chung cho ô nhập ở GIỎ và ô nhập ở THANH TOÁN
   (11/09/2026). Trả về { err } để chỗ gọi tự quyết định báo ở đâu: ở giỏ là dòng
   đỏ dưới ô, ở thanh toán cũng vậy — nhưng hàm này không được biết chuyện đó.
   Luật 1 mã / nhóm giữ nguyên: mã mới ĐẨY mã cũ cùng nhóm ra (các mã trong một
   nhóm là các mức của cùng một chương trình), và trả `replaced` để báo cho đúng. */
function cartApplyCode(raw) {
  const code = String(raw || '').trim().toUpperCase();
  if (!code) return { err: '' };
  const v = voucherByCode(code);
  if (!v) return { err: 'Mã không hợp lệ' };
  if (cartVouchers.includes(code)) return { err: 'Mã đã được áp dụng' };
  if (!voucherEligible(v)) return { err: voucherBlockReason(v) };
  const old = cartVouchers.find(c => { const o = voucherByCode(c); return o && o.group === v.group; });
  cartVouchers = cartVouchers.filter(c => c !== old).concat(code);
  return { ok: true, code, replaced: old };
}

function pruneVouchers() {
  const dropped = cartVouchers.filter(c => !voucherEligible(voucherByCode(c)));
  if (dropped.length) cartVouchers = cartVouchers.filter(c => !dropped.includes(c));
  return dropped;
}

