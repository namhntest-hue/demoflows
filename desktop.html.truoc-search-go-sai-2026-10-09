              ? `<p class="t-multiline min-w-0 flex-1 text-secondary-foreground"><span class="font-medium">${it[0]}</span>${it[1] || ''}</p>`
              : `<p class="t-multiline min-w-0 flex-1 text-secondary-foreground">${it}</p>`}
          </div>`;
  return `
    <div class="${wrap} rise">
      <div class="promo-box promo-flat flex flex-col">
        <div class="promo-peek promo-body flex flex-col gap-2">${items.map(hang).join('')}
        </div>${items.length > PROMO_ROWS_SHOWN ? `
        <button data-promo-toggle data-more="Xem tất cả ${items.length} chương trình" class="promo-foot t-multiline w-full flex items-center justify-center font-medium text-foreground underline press">Xem tất cả ${items.length} chương trình</button>` : ''}
      </div>
