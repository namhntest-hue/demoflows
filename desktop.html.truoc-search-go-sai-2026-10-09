     4 view kia vẫn có lối ra bằng CHỮ nên không mất gì:
       login (là màn gốc) · register + otp ("Đã có tài khoản? Đăng nhập")
       · forgot ("← Quay lại đăng nhập")
     Muốn trả lại lối cho 2 view kia thì thêm 1 nút chữ ở cuối form, ĐỪNG dựng
     lại thanh header — đó chính là thứ vừa bỏ. */

  // ── AUTH: chuyển view ── (mọi cú bấm tab/link đều dọn banner Opt2 của trang 23)
  root.querySelectorAll('[data-auth-go]').forEach(btn => {
    btn.addEventListener('click', () => { authView = btn.dataset.authGo; forgotEmailSent = ''; resetRegOtp(); rerenderLogin(); });
  });

  /* Nhận OTP / Quên mật khẩu — xem chú thích đầy đủ ở bản mobile (index.html,
     cùng hook): #regPhone giờ nhận cả SĐT lẫn email; ở màn Quên mật khẩu, gõ
     dạng email thì rẽ Opt2 (không gửi OTP, quay về Đăng nhập kèm banner). */
  root.querySelectorAll('[data-auth-otp]').forEach(btn => {
    btn.addEventListener('click', () => {
      const inp = root.querySelector('#regPhone');
      const val = inp && inp.value.trim() ? inp.value.trim() : '';
      const isForgot = authView === 'forgot';
      if (!val) {
        if (inp) { setFieldErr(inp, isForgot ? 'Vui lòng nhập số điện thoại hoặc email' : 'Vui lòng nhập số điện thoại'); inp.focus(); }
        return;
      }
      if (inp) clearFieldErr(inp);
      if (isForgot && FIELD_RULE.email[0](val)) {
        forgotEmailSent = val;
        authView = 'login';
        rerenderLogin();
        return;
      }
      authPhone = val;
      authFlow = isForgot ? 'forgot' : 'register';
      btn.innerHTML = spinnerSVG();
      setTimeout(() => { authView = 'otp'; rerenderLogin(); toast('Đã gửi mã OTP'); }, 700);
    });
