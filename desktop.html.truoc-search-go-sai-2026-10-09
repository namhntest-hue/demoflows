   · NỔI CHỮ KHỚP (highlightMatch): tô CẢ TỪ khớp (không tô nửa từ "Đầ|m" — đọc như lỗi), mọi từ khớp, mọi lần xuất hiện. Nhấn bằng BẬC MỰC
     (STYLE-RULES §2.1): hàng gợi ý mực phụ, từ khớp mực chính (`.search-hit`). §2.3 cấm nhấn bằng độ đậm lẫn mảng màu nên KHÔNG 500 / nền;
     muốn 500 phải ghi ngoại lệ §1.1 (chờ user). Khung Figma "typing" vẽ hàng gợi ý toàn Regular #0a0a0a (chưa có kiểu nổi) ⇒ LỆCH tới khi sync.
   · LỊCH SỬ (searchHistoryAdd): tìm lại thì đưa lên đầu, gộp trùng không phân biệt hoa thường / dấu, tối đa 8.
   · Block thẻ chỉ dựng lại khi DANH SÁCH THẺ đổi (so khoá `key`) — gõ thêm chữ mà vẫn cùng bộ thẻ thì ảnh không nhấp nháy (lý do cũ của việc
     tách pane chữ / pane thẻ vẫn được giữ). */
const SEARCH_ESC = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);

/* Chuẩn hoá từng ký tự, giữ BẢN ĐỒ vị trí (norm[k] sinh từ str[map[k]]) để tô lại đúng chỗ trên chuỗi gốc. */
function searchNormMap(str) {
  const norm = [], map = [];
  let prev = ' ';
  for (let i = 0; i < str.length; i++) {
    const base = str[i].normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/đ/g, 'd');
    if (!base) continue;                                            // dấu kết hợp đứng riêng (chuỗi dạng NFD)
    const c = base[0];
    const kind = /[a-z]/.test(c) ? 'a' : /[0-9]/.test(c) ? 'd' : ' ';
    if (kind === ' ') { if (prev !== ' ') { norm.push(' '); map.push(i); } prev = ' '; continue; }
    if (prev !== ' ' && prev !== kind) { norm.push(' '); map.push(i); }   // "100ml" → "100 ml"
    norm.push(c); map.push(i); prev = kind;
  }
  return { norm: norm.join(''), map };
}
const searchNorm = s => searchNormMap(String(s == null ? '' : s)).norm.trim();
const searchTokens = s => searchNorm(s).split(' ').filter(Boolean);

/* Các từ của chuỗi gốc: dạng chuẩn hoá `tok` + đoạn [s, e) trên chuỗi gốc — dùng cho tô chữ và kho từ sửa lỗi gõ. */
function searchSpans(str) {
  const { norm, map } = searchNormMap(str);
  const out = []; const re = /[a-z0-9]+/g; let m;
  while ((m = re.exec(norm))) {
    const s = map[m.index];
    let e = map[m.index + m[0].length - 1] + 1;
    while (e < str.length && /[̀-ͯ]/.test(str[e])) e++;   // chuỗi NFD: dấu kết hợp đứng sau chữ cuối đi theo từ
    out.push({ s, e, tok: m[0] });
  }
  return out;
}

/* Bọc MỌI từ khớp (đầu từ trùng một từ đã gõ) trong <mark class="search-hit">; phần còn lại giữ nguyên, đã escape HTML. */
function highlightMatch(text, q) {
  const str = String(text == null ? '' : text);
  const qt = searchTokens(q);
  if (!qt.length) return SEARCH_ESC(str);
  let html = '', pos = 0;
  searchSpans(str).forEach(sp => {
    if (!qt.some(t => sp.tok.startsWith(t))) return;
    html += SEARCH_ESC(str.slice(pos, sp.s)) + '<mark class="search-hit">' + SEARCH_ESC(str.slice(sp.s, sp.e)) + '</mark>';
    pos = sp.e;
  });
  return html + SEARCH_ESC(str.slice(pos));
}

/* Chỉ mục tìm kiếm: dựng MỘT lần ở lượt gõ đầu (p.cat / p.gender đã gán xong ở phần dữ liệu). */
let SEARCH_INDEX = null;
function searchIndex() {
  if (SEARCH_INDEX) return SEARCH_INDEX;
  SEARCH_INDEX = PRODUCTS.map((p, i) => {
    const cats = [...new Set(p.cat || [])];                          // cây khách có lá trùng tên cha ("Túi đeo vai" × 2)
    return {
      i, p, cats,
      brand: searchTokens(p.brand), name: searchTokens(p.name), catTok: cats.map(searchTokens), gender: searchTokens(p.gender),
      brandNorm: searchNorm(p.brand), nameNorm: searchNorm(p.name),
    };
  });
  return SEARCH_INDEX;
}
const SEARCH_W = { nameFirst: 45, brand: 40, name: 30, cat: 20, gender: 5 };
/* Điểm khớp của một sản phẩm (0 = không khớp). qt = từ của truy vấn đã chuẩn hoá, qn = cả truy vấn chuẩn hoá. */
function searchScore(e, qt, qn) {
  let score = 0;
  for (const t of qt) {
    let best = 0;
    if (e.name.length && e.name[0].startsWith(t)) best = SEARCH_W.nameFirst;
    else if (e.name.some(w => w.startsWith(t))) best = SEARCH_W.name;
    if (e.brand.some(w => w.startsWith(t))) best = Math.max(best, SEARCH_W.brand);
    if (!best && e.catTok.some(ws => ws.some(w => w.startsWith(t)))) best = SEARCH_W.cat;
    if (!best && e.gender.some(w => w.startsWith(t))) best = SEARCH_W.gender;
    if (!best) return 0;
    score += best;
  }
  if (e.nameNorm.startsWith(qn)) score += 100;
  else if ((' ' + e.nameNorm).includes(' ' + qn)) score += 60;
  if (e.p.tag === 'Best seller') score += 3; else if (e.p.tag === 'New arrival') score += 2;
  return score;
}
/* Sản phẩm khớp, điểm giảm dần (hoà: thứ tự PRODUCTS) — trả { p, i } cùng khuôn với plpProducts(). */
function searchProducts(q) {
  const qt = searchTokens(q);
  if (!qt.length) return [];
  const qn = qt.join(' ');
  return searchIndex().map(e => ({ e, s: searchScore(e, qt, qn) })).filter(x => x.s > 0)
    .sort((a, b) => b.s - a.s || a.e.i - b.e.i).map(x => ({ p: x.e.p, i: x.e.i }));
}
/* Xen kẽ các danh sách sản phẩm (mỗi danh sách đã xếp hạng): lấy lần lượt phần tử đầu của từng danh sách, khử trùng — để mỗi gợi ý / mỗi từ đều có mặt trong ~5 hàng đầu. */
function searchInterleave(lists) {
  const seen = new Set(), out = [];
  for (let k = 0; ; k++) {
    let any = false;
    for (const L of lists) if (k < L.length) { any = true; if (!seen.has(L[k].i)) { seen.add(L[k].i); out.push(L[k]); } }
    if (!any) break;
  }
  return out;
}
/* Khớp MỘT PHẦN (OR theo từ) — chỉ dùng cho "liên quan" khi AND không ra gì: xen kẽ kết quả của TỪNG từ ("đầm molton" → đầm, Molton, đầm, Molton …) thay vì dồn hết một từ lên đầu. */
function searchProductsAny(qt) { return searchInterleave(qt.map(t => searchProducts(t))); }
/* Hãng khớp TRỌN truy vấn (mọi từ gõ là đầu một từ của tên hãng); hãng nhiều sản phẩm xếp trước. */
function searchBrands(q, max = 3) {
  const qt = searchTokens(q);
  if (!qt.length) return [];
  const n = new Map();
  searchIndex().forEach(e => { if (qt.every(t => e.brand.some(w => w.startsWith(t)))) n.set(e.p.brand, (n.get(e.p.brand) || 0) + 1); });
  return [...n.entries()].sort((a, b) => b[1] - a[1]).slice(0, max).map(x => x[0]);
}
/* Danh mục (3 cấp) khớp trọn truy vấn, kèm số KẾT QUẢ sẽ thấy khi bấm (= searchProducts(nhãn) — con số và lưới sau đó không chọi nhau);
   nhãn bắt đầu đúng cụm gõ xếp trước, rồi theo số kết quả. */
function searchCats(q, max = 3) {
  const qt = searchTokens(q);
  if (!qt.length) return [];
  const qn = qt.join(' ');
  const labels = new Set();
  searchIndex().forEach(e => e.cats.forEach(l => labels.add(l)));
  return [...labels]
    .filter(l => { const ws = searchTokens(l); return qt.every(t => ws.some(w => w.startsWith(t))); })
    .map(l => ({ label: l, n: searchProducts(l).length, lead: searchNorm(l).startsWith(qn) ? 1 : 0 }))
    .filter(x => x.n > 0)
    .sort((a, b) => b.lead - a.lead || b.n - a.n || a.label.localeCompare(b.label, 'vi'))
    .slice(0, max);
}

/* Kho từ (dạng chuẩn hoá → { word: dạng gốc hay gặp nhất, n: số lần }) từ hãng + tên + danh mục + giới tính — cho sửa lỗi gõ. */
let SEARCH_VOCAB = null;
function searchVocab() {
  if (SEARCH_VOCAB) return SEARCH_VOCAB;
  const v = new Map();
  const add = str => {
    const s = String(str == null ? '' : str);
    searchSpans(s).forEach(sp => {
      const cur = v.get(sp.tok) || { word: '', n: 0, forms: new Map() };
      const f = s.slice(sp.s, sp.e);
      cur.n++; cur.forms.set(f, (cur.forms.get(f) || 0) + 1);
      v.set(sp.tok, cur);
    });
  };
  searchIndex().forEach(e => { add(e.p.brand); add(e.p.name); e.cats.forEach(add); add(e.p.gender); });
  v.forEach(cur => { cur.word = [...cur.forms.entries()].sort((a, b) => b[1] - a[1])[0][0]; });
  SEARCH_VOCAB = v;
  return v;
}
/* Khoảng cách Damerau-Levenshtein (OSA: thay / thêm / bớt / hoán vị 2 ký tự kề), cắt sớm khi vượt max. */
function searchEditDist(a, b, max) {
  if (Math.abs(a.length - b.length) > max) return max + 1;
  const d = [];
  for (let i = 0; i <= a.length; i++) d[i] = [i];
  for (let j = 0; j <= b.length; j++) d[0][j] = j;
  for (let i = 1; i <= a.length; i++) {
    let rowMin = Infinity;
    for (let j = 1; j <= b.length; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1;
      let x = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost);
      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) x = Math.min(x, d[i - 2][j - 2] + 1);
      d[i][j] = x; rowMin = Math.min(rowMin, x);
    }
    if (rowMin > max) return max + 1;
  }
  return d[a.length][b.length];
}
/* "Có phải bạn muốn tìm …?": sửa từng TỪ không khớp kho (≥ 3 ký tự) bằng từ gần nhất (≤ 1 lỗi; từ ≥ 6 ký tự ≤ 2 lỗi; so cả với phần đầu
   cùng độ dài để "vesac" vẫn ra "Versace"); từ đã khớp giữ nguyên như khách gõ. Chỉ trả về khi có từ được sửa VÀ cụm sửa CÓ kết quả. */
function searchDidYouMean(q) {
  const pieces = String(q == null ? '' : q).trim().split(/\s+/).filter(Boolean);
  if (!pieces.length) return '';
  const vocab = searchVocab(); const keys = [...vocab.keys()];
  let changed = false;
  const fixed = pieces.map(piece => {
    const toks = searchTokens(piece);
    if (!toks.length) return piece;
    if (toks.every(t => keys.some(w => w.startsWith(t)))) return piece;    // từ này đã có trong kho
    const t = toks.join('');
    if (t.length < 3) return null;
    const max = t.length >= 6 ? 2 : 1;
    let best = null;
    vocab.forEach((v, w) => {
      if (w.length < 3) return;
      const d = Math.min(searchEditDist(t, w, max), w.length > t.length ? searchEditDist(t, w.slice(0, t.length), max) : max + 1);
      if (d <= max && (!best || d < best.d || (d === best.d && v.n > best.n))) best = { d, n: v.n, word: v.word };
    });
    if (!best) return null;
    changed = true;
    return best.word;
  });
  if (!changed || fixed.some(x => x === null)) return '';
  const out = fixed.join(' ');
  return searchProducts(out).length ? out : '';
}
/* Từ khoá phổ biến CỦA TỪNG FILE (mobile SEARCH_HOT · desktop DK_SEARCH_HOT) — chỉ làm gợi ý DỰ PHÒNG khi không có gì gần chữ đã gõ; typeof để dùng chung MỘT khối cho cả 2 file. */
const searchPopularKeywords = () => (typeof SEARCH_HOT !== 'undefined' && SEARCH_HOT) || (typeof DK_SEARCH_HOT !== 'undefined' && DK_SEARCH_HOT) || [];

/* KHÔNG KHỚP GÌ — MỘT nguồn cho cả 3 khối (07/10/2026: Gợi ý → Sản phẩm gần với gợi ý → Danh mục liên quan). Trả { via, query, sg, prods, cats }:
   · sg = ≤ 3 gợi ý { text, kind } sinh từ chữ đã gõ: 'fix' cụm đã sửa lỗi gõ · 'brand' / 'cat' hãng / danh mục phủ TRỌN các từ đã biết trong kho (không có thì từng từ một) · 'word' chính các
     từ đã biết khi không phải hãng / danh mục; không có gì gần chữ đã gõ thì 'popular' ≤ 5 từ khoá phổ biến của file — khối "Gợi ý" không bao giờ rỗng;
   · prods = sản phẩm gần với gợi ý: via 'fix' = kết quả của cụm sửa; 'partial' = kết quả của các từ đã biết (AND), không ra thì xen kẽ từng từ (OR); 'popular' = xen kẽ kết quả của từng từ khoá phổ biến;
   · query = cụm để nút "Xem tất cả (N)" tìm (rỗng khi danh sách là hỗn hợp nhiều gợi ý ⇒ không có liên kết);
   · cats = nhãn cấp 2 (không có thì cấp 1) hay gặp nhất trong chính prods ⇒ chip nào bấm cũng có hàng.
   Ghi nhớ kết quả của lần gọi gần nhất (mỗi phím gõ gọi vài lần từ nhiều chỗ). Nơi gọi chỉ ĐỌC kết quả, không sửa. */
let SEARCH_REL_MEMO = { q: null, r: null };
function searchRelated(q) {
  if (SEARCH_REL_MEMO.q === q) return SEARCH_REL_MEMO.r;
  const fix = searchDidYouMean(q);
  const keys = [...searchVocab().keys()];
  const kept = searchTokens(q).filter(t => keys.some(w => w.startsWith(t)));      // từ đã có trong kho
  const phrase = kept.join(' ');
  const sg = [], seen = new Set();
  const add = (text, kind) => { const k = searchNorm(text); if (k && !seen.has(k)) { seen.add(k); sg.push({ text, kind }); } };
  if (fix) add(fix, 'fix');
  if (kept.length) {
    const b = searchBrands(phrase, 1)[0], c = searchCats(phrase, 1)[0];             // một hãng / danh mục phủ trọn các từ đã biết
    if (b) add(b, 'brand');
    if (c) add(c.label, 'cat');
    if (!b && !c) kept.forEach(t => { const tb = searchBrands(t, 1)[0], tc = searchCats(t, 1)[0]; if (tb) add(tb, 'brand'); else if (tc) add(tc.label, 'cat'); });
    if (!sg.length) add(kept.map(t => (searchVocab().get(t) || { word: t }).word).join(' '), 'word');
  }
  let via = 'popular', query = '', prods = [];
  if (fix) { via = 'fix'; query = fix; prods = searchProducts(fix); }
  else if (kept.length) { via = 'partial'; prods = searchProducts(phrase); query = prods.length ? phrase : ''; if (!prods.length) prods = searchProductsAny(kept); }
  if (via === 'popular') {
    const pop = searchPopularKeywords().slice(0, 5);
    pop.forEach(k => add(k, 'popular'));
    prods = searchInterleave(pop.map(k => searchProducts(k)));
    if (!prods.length) prods = PRODUCTS.slice(0, 5).map((p, i) => ({ p, i }));
  }
  const n = new Map();
  prods.forEach(({ p }) => { const l = (p.cat || [])[1] || (p.cat || [])[0]; if (l) n.set(l, (n.get(l) || 0) + 1); });
  const cats = [...n.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'vi')).slice(0, 6).map(x => x[0]);
  const r = { via, query, sg: sg.slice(0, via === 'popular' ? 5 : 3), prods, cats };
  SEARCH_REL_MEMO = { q, r };
  return r;
}

/* Hàng trong khối "Gợi ý" của trạng thái KHÔNG khớp — dùng chung mobile (li) và lớp desktop (button): `row(inner, attrs, ink)` do nơi gọi truyền vào. Hãng → trang hãng (data-brand); còn lại → tìm chữ đó. */
function searchSuggestRows(sg, q, row) {
  const keep = inner => `<span data-i18n-skip>${inner}</span>`;
  const catLabel = l => (LANG === 'en' && tr(l, 'en')) || l;
  return sg.map(s => s.kind === 'fix'
    ? row(`Có phải bạn muốn tìm “${SEARCH_ESC(s.text)}”?`, `data-suggest="${SEARCH_ESC(s.text)}"`, 'text-foreground')
    : s.kind === 'brand'
      ? row(keep(highlightMatch(s.text, q)), `data-brand="${SEARCH_ESC(s.text)}"`)
      : s.kind === 'cat'
        ? row(keep(highlightMatch(catLabel(s.text), q)), `data-suggest="${SEARCH_ESC(s.text)}"`)
        : row(s.kind === 'word' ? keep(highlightMatch(s.text, q)) : SEARCH_ESC(s.text), `data-suggest="${SEARCH_ESC(s.text)}"`)
  ).join('');
}

/* Chip danh mục (bấm = tìm nhãn đó) — cùng khuôn chip "Từ khóa phổ biến" của màn chưa gõ (af-chip · cao 36 · pad 12 · nền secondary · btn-s). */
const searchChipHTML = l => `<button class="t-multiline af-chip h-9 px-3 shrink-0 whitespace-nowrap rounded-xs bg-secondary flex items-center font-medium text-secondary-foreground btn-s press" data-suggest="${SEARCH_ESC(l)}">${SEARCH_ESC(l)}</button>`;

/* Đưa từ vừa tìm lên ĐẦU lịch sử; gộp trùng không phân biệt hoa thường / dấu ("versace" = "Versace"); tối đa 8. */
function searchHistoryAdd(term) {
  const t = String(term == null ? '' : term).trim();
  if (!t) return;
  const n = searchNorm(t);
  searchHistory = [t, ...searchHistory.filter(h => searchNorm(h) !== n)].slice(0, 8);
}

/* Pane "đang gõ" — PHẦN CHỮ (mobile + bản sao màn Search trong FLOW của desktop): nhóm Thương hiệu / Danh mục khi có kết quả; KHÔNG khớp gì thì khối "Gợi ý" = báo kèm từ đã gõ + ≤ 3
   từ khoá gợi ý sinh từ chữ đã gõ (xem searchRelated), TIẾP THEO là block Sản phẩm rồi chip Danh mục liên quan (searchSugProductsHTML) — đúng thứ tự user chốt 07/10. Hàng gợi ý mực phụ,
   từ khớp mực chính; hàng hành động mực chính. Trả '' khi không có gì để nói (có kết quả nhưng không hãng / danh mục nào khớp trọn) — pane sẽ chỉ còn block sản phẩm. */
function searchSuggestHTML() {
  const q = searchQuery.trim();
  const row = (inner, attrs, ink = 'text-muted-foreground') =>
    `<li><button class="t-multiline search-suggest w-full text-left px-4 py-3 ${ink} press" ${attrs}>${inner}</button></li>`;
  const head = t => `<h2 class="t-single px-4 py-2 text-muted-foreground">${t}</h2>`;
  /* Chữ DỮ LIỆU (hãng / nhãn danh mục) bọc data-i18n-skip: thẻ mark tách text node nên bộ dịch EN sẽ dịch LẺ TỪNG MẢNH ("Đầm" → "Dresses"
     giữa một tên tiếng Việt — đo 06/10). Nhãn danh mục có khoá dịch thì dịch TRƯỚC khi tô: bản EN hiện "Bags (7)", không tô vì từ gõ là tiếng Việt. */
  const keep = inner => `<span data-i18n-skip>${inner}</span>`;
  const catLabel = l => (LANG === 'en' && tr(l, 'en')) || l;
  if (!searchProducts(q).length) {
    const rel = searchRelated(q);
    return `
  <section class="flex flex-col py-4">
    ${head('Gợi ý')}
    <p class="t-multiline px-4 py-3 text-foreground">Không tìm thấy kết quả cho “${SEARCH_ESC(q)}”</p>
    ${rel.sg.length ? `<ul>${searchSuggestRows(rel.sg, q, row)}</ul>` : `<p class="t-multiline px-4 py-3 text-muted-foreground">Thử từ khoá ngắn hơn, hoặc tìm theo tên thương hiệu.</p>`}
  </section>`;
  }
  const brands = searchBrands(q), cats = searchCats(q);
  if (!brands.length && !cats.length) return '';
  return `
  <section class="flex flex-col py-4">
    ${brands.length ? head('Thương hiệu') + `<ul>${brands.map(b => row(keep(highlightMatch(b, q)), `data-brand="${SEARCH_ESC(b)}"`)).join('')}</ul>` : ''}
    ${cats.length ? head('Danh mục') + `<ul>${cats.map(c => row(keep(`${highlightMatch(catLabel(c.label), q)} (${c.n})`), `data-suggest="${SEARCH_ESC(c.label)}"`)).join('')}</ul>` : ''}
  </section>`;
}

/* MỘT HÀNG sản phẩm kiểu mini cart — dùng chung 2 nơi: MOBILE (searchSugProductsHTML: danh sách dọc, thẻ li mang mx-4) và LỚP TÌM KIẾM DESKTOP (renderProducts trong
   desktop.html: lưới 2 cột, thẻ div) — một khuôn markup để hai khổ không lệch nhau (08/10/2026, user: "cái kết quả search cho layout thẻ dạng list ngang giống mobile"). */
function searchProductRowHTML({ p, i }, tag = 'li', cls = 'search-prow mx-4') {
  return `
