   chuyển qua Trang chủ nữ chứ không phải khi bấm vào Nữ > Giày mới hiện"): điều kiện
   duy nhất là NGỮ CẢNH GIỚI TÍNH NỮ. Bảng của khách ghi "chỉ áp dụng vs GIÀY NỮ" nên
   hàng nam và ngành làm đẹp vẫn không có mục này.
   Trước đó mục này còn ràng theo nhánh Giày dép (breadcrumb) và tự hiện/ẩn khi tick
   cate Giày dép trong panel — ĐÃ GỠ cả hai cùng lượt, kèm `syncHeelSection()`,
   `SHOE_BRANCH_LABELS` và `data-cat-name` vốn chỉ tồn tại để phục vụ cơ chế đó. */
const heelSection = () => plpGender() === 'Nữ' && !isBeautyPlp();

/* Danh sách sản phẩm theo chế độ PLP (giữ index gốc cho router PDP/quick-add) */
function plpProducts() {
  const all = PRODUCTS.map((p, i) => ({ p, i }));
  if (plpMode.type === 'search') {   // tìm kiếm quét cả 2 ngành hàng
    /* 06/10/2026 — CÙNG bộ so khớp với gợi ý (searchProducts: bỏ dấu, từng từ ở đầu từ, hãng + tên + danh mục + giới tính), xếp theo độ
       khớp — mục "Phù hợp nhất" của Sắp xếp giữ nguyên thứ tự này. Trước: chuỗi con CÓ DẤU của "hãng + tên" theo thứ tự PRODUCTS. */
    const q = (plpMode.query || '').trim();
    return q ? searchProducts(q) : all;
  }
  /* PLP thương hiệu chỉ hiện hàng CỦA hãng đó (02/09/2026). Trước đây màn brand
     đổ nguyên danh sách nên trang "Versace" liệt kê cả nước hoa Montblanc.
     So bằng chuỗi brand — cùng nguồn với facet Thương hiệu của bộ lọc. */
  if (plpMode.type === 'brand') {
    const b = plpBrandName();
    /* 04/10/2026 — `scent` (ô dòng hương / chip của hub Molton Brown): tên SP có chứa từ đó, không phân biệt hoa thường. */
    const sc = String(plpMode.scent || '').toLowerCase();
    return all.filter(({ p }) => p.brand === b && (!sc || p.name.toLowerCase().includes(sc)));
  }
  const beauty = isBeautyPlp();
  return all.filter(({ p }) => (p.dept === 'beauty') === beauty);
}
