       nào hiện nút; nhánh hơn 5 đã kiểm bằng dữ liệu giả 6–7 hàng. */
const promoBox = (items, wrap = 'px-4 pb-2') => {
  const hang = (it, i) => `
          <div class="promo-row${i >= PROMO_ROWS_SHOWN ? ' promo-more' : ''} flex items-start gap-2">
