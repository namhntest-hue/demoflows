       đổi" giữ nguyên — lúc đó bấm xong KHÔNG đi tiếp mà quay về bước xa nhất. */
    openSec.textContent = ckMaxStep > ckStep ? 'Lưu thay đổi' : 'Xác nhận & tiếp tục';
    localizeNew(openSec);
  }

  /* ── PHÍ GIAO + TỔNG PHẢI VẼ LẠI Ở ĐÂY (23/09/2026) ──
     Panel tóm tắt dựng MỘT LẦN trong screenCHECKOUT(), còn paintCheckout() trước nay
     chỉ đụng các section. Nên khi bấm Xác nhận ở bước "Phương thức vận chuyển",
     `ckMaxStep` lên 2 và `ckShipFast` đã đúng NHƯNG panel vẫn in "Sẽ được tính sau" và
     tổng cũ — đã đo được đúng lỗi này ngay khi dựng tính năng.
     Cập nhật theo id, có guard: bản mobile có THÊM một cặp trong #ckBagSheet
     (`ckShipVal2` / `ckTotalVal`), bản desktop chỉ có một cặp.
     `localizeNew` để chuỗi vừa ghi được dịch nếu đang ở bản EN.
     04/10/2026: phần vẽ này tách thành paintCkMoney() ngay dưới hàm — bấm chọn phương thức
     (chưa Xác nhận) cũng phải vẽ lại đúng hai con số này mà KHÔNG đụng tới các section. */
  paintCkMoney(root);
}

/* Vẽ lại ĐÚNG hai con số của khối tóm tắt đơn: dòng "Phí vận chuyển" + Tổng cộng.
   Tách khỏi paintCheckout 04/10/2026 để bấm chọn phương thức vận chuyển gọi riêng được. */
function paintCkMoney(root) {
  const shipMuted = !(ckMode === 'pickup' || ckShipChosen());
  root.querySelectorAll('#ckShipVal, #ckShipVal2').forEach(el => {
    el.textContent = ckShipText();
    el.classList.toggle('text-muted-foreground', shipMuted);
    el.classList.toggle('text-foreground', !shipMuted);
    localizeNew(el);
  });
  const totalEl = root.querySelector('#ckTotalVal');
  if (totalEl) totalEl.textContent = vndCom(ckTotalNow());
}

