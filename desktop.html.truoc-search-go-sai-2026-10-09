   hỏng bản EN — nhưng chuỗi mới cũng chưa có bản dịch, y như trước. */
/* 02/10/2026 (user: "Chỉnh lại text: 1240 điểm khả dụng (1 điểm = 1000đ)" + dời xuống DƯỚI ô nhập điểm) — chữ nay là "{trần} điểm khả dụng (1 điểm = 1.000đ)": bỏ vế "cho order này" và số tiền quy đổi
   ({trần x 1000} ₫, id pointsMoneyVal — HẾT, mọi chỗ JS từng cập nhật nó đã gỡ), thay bằng tỉ giá cố định REWARD_POINT_VALUE. Số vẫn là TRẦN dùng được cho đơn này như từ 23/09 (id pointsUsedVal, JS cập nhật khi giỏ đổi);
   dòng đặt trong pointsExtra, dưới hàng ô nhập. i18n: vế sau là một text node riêng, khoá 'khả dụng (1 điểm = 1.000đ)'. KHAI GIỐNG HỆT index.html. */
function pointsSubText() {
  const max = maxUsablePoints();
  return `<span id="pointsUsedVal">${max.toLocaleString('vi-VN')} điểm</span> khả dụng (1 điểm = ${REWARD_POINT_VALUE.toLocaleString('vi-VN')}đ)`;
}

/* ── 09/09/2026 — TRỞ LẠI Ô NHẬP MÃ GÕ TAY (chốt khách) ──
   Khách bỏ mô hình "hàng thu gọn -> panel chọn ưu đãi" của chốt 17/08: ở giỏ nay
   HIỆN SẴN ô nhập + nút "Áp dụng" như bản trước 17/08.
   ĐÃ GỠ theo cái panel: 3 helper của hàng thu gọn (voucherAvailCount /
   voucherPlaceholder / voucherPickValue — sinh chữ "Chọn mã ưu đãi ( 6 )" và "Đã áp
   dụng 2 mã" cho `.pick-label`), thẻ ưu đãi + danh sách theo nhóm (voucherCardHTML /
   voucherSheetHTML / voucherSumOf) và cả lớp nổi #vcSheet (.dk-drawer).
   GIỮ NGUYÊN toàn bộ phần TÍNH: catalog VOUCHERS, luật 1 mã/nhóm, voucherEligible /
   voucherBlockReason / voucherValue / pruneVouchers và các dòng trong khối tóm tắt —
   đợt này đổi MẶT NHẬP LIỆU, không đổi cách tính đồng nào.
   Bản panel tra lại ở git history (có từ commit đầu d81ffd7). */

/* Phiếu mua hàng: demo không có backend tra cứu mã thật, nên sinh số tiền giảm
   ổn định theo chuỗi mã (cùng 1 mã luôn ra cùng 1 số tiền) — 50,000 .. 1,000,000đ,
   bước 50,000. Nhiều mã cộng dồn vào tổng nhưng chỉ hiện 1 dòng "Phiếu mua hàng"
   trong summary (xem discountLinesHTML) — từng mã cụ thể xem ở badge dưới input. */
function pbhAmount(code) {
  let h = 0;
  for (let i = 0; i < code.length; i++) h = (h * 31 + code.charCodeAt(i)) >>> 0;
  return 50000 + (h % 20) * 50000;
}
function cartPbhTotal() { return cartPbh.reduce((s, p) => s + p.amount, 0); }

/* Các dòng Tạm tính / giảm giá trong summary — sinh động theo state (đăng nhập,
   reward đang chọn, voucher, N mã phiếu mua hàng), dùng chung cho cả lần render
   đầu (screenCART) và mỗi lần cập nhật sau tương tác (refreshCartSummary).
   Theo đúng Figma 3437:55820: MỖI mã (voucher hoặc phiếu mua hàng) có 1 dòng
   riêng dạng "Giảm giá(<CODE>)" — cả 2 loại dùng CHUNG format nhãn này, không
   gộp/rút gọn thành 1 dòng tổng như bản trước. */
/* Ô NHẬP MÃ Ở MÀN THANH TOÁN (11/09/2026, lệnh user "dựng demo luôn").
   Trước lượt này quên mã ở giỏ là phải quay lui một màn để gõ — mà giỏ thì nằm
   sau nút "Đặt hàng" nên quay lui là mất hết những gì vừa điền.
   Đặt NGAY TRÊN khối tiền, không nhét vào một mục đóng-mở: người đang ở bước cuối
   mà còn phải đi tìm chỗ gõ mã thì thà quay lui thật.
   Dùng lại y khuôn ô nhập của giỏ (input h-10 + nút Áp dụng bg-secondary) — cùng
   một việc thì cùng một mặt. */
function ckCodeRow() {
  return `
    <div class="flex flex-col gap-2 py-3">
      <!-- CỘT bao quanh ô nhập: setFieldErr chèn dòng lỗi ngay SAU .field-float, mà
           .field-float lại là con trực tiếp của HÀNG NGANG này — thiếu cột thì dòng
           lỗi rơi vào giữa hàng, nằm CẠNH nút Áp dụng (user báo kèm ảnh 16/09/2026).
           items-start giữ nút dính mép TRÊN khi cột cao thêm vì dòng lỗi. -->
      <div class="flex items-start">
        <div class="flex-1 min-w-0 flex flex-col">
          <div class="field-float">
            <input id="ckCode" placeholder=" " class="t-multiline bg-background border rounded-xs px-2 text-foreground outline-none focus:border-primary transition-colors">
            <label for="ckCode" class="text-muted-foreground">Mã ưu đãi</label>
          </div>
        </div>
        <button id="ckApplyCode" disabled class="t-multiline h-12 px-4 shrink-0 bg-primary text-primary-foreground rounded-xs font-medium btn-p press">Áp dụng</button>
      </div>
      <div id="ckCodeList" class="${cartVouchers.length ? 'flex gap-2 flex-wrap' : 'hidden'}"></div>
    </div>`;
}

/* Hàng chip mã đang áp ở màn thanh toán — sinh lại từ state mỗi lượt, y như
   renderVoucherUI() của giỏ. Gỡ mã xong dựng lại cả màn: bỏ một mã là mọi dòng
   tiền bên dưới đổi theo. */
function renderCkCodes(root) {
  if (!root) return;
  const list = root.querySelector('#ckCodeList');
  if (!list) return;
  list.className = cartVouchers.length ? 'flex gap-2 flex-wrap' : 'hidden';
  list.innerHTML = cartVouchers.map(c => `
    <span class="vc-badge bg-secondary rounded flex items-center gap-1.5 px-2 py-0.5 h-6" data-vc-code="${c}">
      <span data-i18n-skip class="t-single font-medium text-secondary-foreground truncate max-w-[140px]">${c}</span>
      <button class="vc-del w-3 h-3 flex items-center justify-center shrink-0 press [&_svg]:w-3 [&_svg]:h-3" aria-label="Gỡ mã">${IcoCross}</button>
    </span>`).join('');
  list.querySelectorAll('.vc-del').forEach(b => b.addEventListener('click', e => {
    e.stopPropagation();
    const code = b.closest('.vc-badge').dataset.vcCode;
    cartVouchers = cartVouchers.filter(c => c !== code);
    const scr = document.querySelector('[data-screen="checkout"]');
    if (scr) rerenderCheckout(scr);
    toast('Đã gỡ ' + code);
  }));
}

function discountLinesHTML() {
  /* py-2 (không h-9 cố định) + items-start: mã dài (VOUCHERPBH...) sẽ XUỐNG
     DÒNG thay vì bị cắt "..." — đúng theo Figma (dòng đó cao 56px = 2 dòng
     label, không phải 36px 1 dòng như các dòng còn lại). */
  /* 23/09/2026 — BỎ `py-1.5`: Figma `614:105500` cho các dòng KHÔNG đệm dọc, khoảng
     cách do KHE 16 của `#discountLines` lo (dòng cao đúng 16 và 18). Trước đây đệm
     6/6 + khe 0 cho ra 12px giữa hai dòng; nay là 16. */
  const line = (label, amount, isDiscount) => `
    <div class="flex justify-between items-start gap-2">
      <span class="t-single font-light ${isDiscount ? 'text-destructive' : 'text-muted-foreground'}">${label}</span>
      <span class="t-single font-light ${isDiscount ? 'text-destructive' : 'text-foreground'} shrink-0">${isDiscount ? '-' : ''}${amount.toLocaleString('en-US')}đ</span>
    </div>`;
  /* Ưu đãi vận chuyển không phải một khoản tiền trừ vào hàng (demo miễn phí
     giao sẵn) — nó là một DÒNG CHỮ, nên cần biến thể không format tiền. */
  const lineText = (label, text) => `
    <div class="flex justify-between items-start gap-2">
      <span class="t-single font-light text-muted-foreground">${label}</span>
      <span class="t-multiline font-light text-foreground shrink-0">${text}</span>
    </div>`;
  const sub = cartSubtotal();
  const rows = [line('Tạm tính', sub, false)];
  /* Không còn món nào được chọn thì KHÔNG in dòng giảm giá nào: "Tạm tính 0đ"
     kèm "Giảm giá(JUNE2000) -2.000.000đ" rồi "Tổng cộng 0đ" là 3 dòng không
     cộng lại thành nhau — mã vẫn giữ nguyên, tick lại món là hiện lại. */
  if (sub > 0) {
    if (ckAuth) {
      const amt = rewardAmount(cartReward);
      /* 02/10/2026 (user: "Dùng 1240 điểm đổi thành Điểm thưởng") — nhãn dòng điểm là "Điểm thưởng" (không còn "Dùng N điểm"); số điểm đang dùng nằm ở ô nhập ngay trên. */
      if (amt > 0) rows.push(line(cartReward === 'points' ? 'Điểm thưởng' : 'Giảm giá thành viên', amt, true));
    }
    /* MỖI mã 1 dòng riêng (Figma 3437:55820) — giờ có thể nhiều mã cùng lúc,
       nên đây là vòng lặp chứ không còn 1 dòng cứng như bản 1-mã. */
    activeVouchers().forEach(v => {
      if (v.type !== 'ship') rows.push(line(`Giảm giá (${v.code})`, voucherValue(v), true));
    });
    cartPbh.forEach(p => rows.push(line(`Giảm giá (${p.code})`, p.amount, true)));
    /* ĐÃ GỠ 23/09/2026 — dòng "Phí vận chuyển (ước tính)" (lệnh user: giỏ không có
       phí vận chuyển). Phí nay chỉ xuất hiện ở checkout, sau khi chọn phương thức —
       xem ckShipFee()/ckShipChosen().
       ⚠ Khung Figma 614:105494 VẪN vẽ dòng này; lệnh miệng sau nên thắng. Đổi ý thì
       nhớ bật lại cả ở đây lẫn ở cartTotalNow(). */
  }
  return rows.join('');
}

/* Tổng ưu đãi đang áp, CHẶN TRẦN theo tạm tính (giỏ teo lại vì bỏ tick / xoá
   món thì ưu đãi không được lớn hơn tiền hàng) + tổng phải trả. Tách riêng để
   lúc dựng màn và lúc cập nhật tại chỗ dùng chung đúng 1 công thức. */
function cartDiscountTotal() {
  const reward = ckAuth ? rewardAmount(cartReward) : 0;
  return Math.min(reward + cartVoucherTotal() + cartPbhTotal(), cartSubtotal());
}
/* Phí giao CỘNG SAU khi đã trừ ưu đãi, và chỉ khi còn hàng để giao — giỏ rỗng
   hoặc bỏ tick hết thì tổng phải là 0đ chứ không phải 50.000đ tiền ship suông. */
/* TỔNG Ở GIỎ — KHÔNG cộng phí giao (23/09/2026, xem khối ckShipFee). */
function cartTotalNow() { return Math.max(0, cartSubtotal() - cartDiscountTotal()); }
/* TỔNG Ở CHECKOUT — cộng phí giao. Tách hàm riêng thay vì thêm tham số: hai màn có
   hai con số khác nhau THẬT, gọi nhầm hàm là sai tiền chứ không phải sai chữ. */
function ckTotalNow() { return cartTotalNow() + ckShipFee(); }

/* Rule text 1 mục khuyến mãi — 3 tầng chữ: Headline 14px medium (tên chương
   trình + thời gian), Scheme 14px regular (cơ chế giảm giá), T&Cs 12px regular
   (điều kiện/loại trừ). scheme/tnc để trống khi mục không có (ví dụ dòng
   freeship đơn lẻ, không kèm mã/điều kiện riêng) — chỉ hiện dòng headline. */
function promoRule(headline, scheme, tnc) {
  return `
  <div class="flex flex-col gap-1">
    <p class="t-multiline font-medium text-foreground">${headline}</p>
    ${scheme ? `<p class="t-multiline text-foreground">${scheme}</p>` : ''}
    ${tnc ? `<p class="t-single text-foreground">${tnc}</p>` : ''}
  </div>`;
}

