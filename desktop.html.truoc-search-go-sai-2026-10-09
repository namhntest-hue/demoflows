  .pop { animation: pop .4s cubic-bezier(.22,1,.36,1); }
  /* ── Fly-to-cart ── */
  @keyframes flyOut { to { transform: translate(var(--dx), var(--dy)) scale(.15); opacity: 0; border-radius: 50%; } }
  .fly { position: fixed; z-index: 999; pointer-events: none; object-fit: cover; animation: flyOut .75s cubic-bezier(.55,-0.05,.6,.32) forwards; }
