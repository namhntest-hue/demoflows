/* Trả về true = được phép đặt hàng. Gọi TRƯỚC placeOrder() ở chỗ bắt data-nav="done". */
function ckGuard() {
  const root = document.querySelector('[data-screen="checkout"]');
  if (!root) return true;                       // không ở màn thanh toán thì không chặn
  root.querySelectorAll('.fld-err').forEach(el => clearFieldErr(el));
  if (!ckMissingFields(root).length) return true;
  /* Mở lại bước Vận chuyển TRƯỚC khi vẽ lỗi: nút Đặt hàng nằm ở bước 3, không mở lại
     thì người dùng thấy báo lỗi mà không thấy ô nào. `ckMaxStep` giữ nguyên nên các
     bước đã xong vẫn ở dạng tóm tắt — không mất dữ liệu đã nhập. */
  ckStep = 0;
  paintCheckout(root);
  const after = document.querySelector('[data-screen="checkout"]') || root;
  ckMissingFields(after).forEach(([el, msg], i) => {
    if (!el) return;                             // thiếu nhưng ô chưa render -> chỉ còn toast
    if (!el.id) el.id = 'ckmiss' + i;            // setFieldErr đặt id dòng lỗi theo id của ô
    setFieldErr(el, msg);
  });
  const first = after.querySelector('.fld-err');
  if (first) {
    first.scrollIntoView({ block: 'center', behavior: 'smooth' });
    if (first.focus) setTimeout(() => first.focus({ preventScroll: true }), 320);
  }
  toast('Còn thiếu thông tin nhận hàng');
  return false;
}

