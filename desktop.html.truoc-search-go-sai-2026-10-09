  /* Gõ lại vào ô SĐT thì xoá lỗi ngay — không thì lỗi nằm lì tới lần bấm sau.
     Cùng lối với ô checkout ([data-ckf]) đã làm. */
  root.querySelectorAll('#regPhone, #loginId').forEach(inp =>
    inp.addEventListener('input', () => clearFieldErr(inp)));

  /* ── ĐĂNG KÝ bằng SĐT — MỘT TRANG (06/10/2026, user kèm ảnh tham chiếu) ──
     Ô SĐT (nút "Gửi mã OTP" nằm trong ô) + ô "Nhập mã OTP" ngay dưới + nút Xác nhận, tất cả hiện sẵn. Nút trong ô:
       · chưa gửi: kiểm SĐT (trống → "Vui lòng nhập số điện thoại"; sai định dạng → "Số điện thoại chưa đúng", cùng luật kiểm khi rời ô) rồi
         quay 0,7s → toast "Đã gửi mã OTP" → đổi thành "Nhận lại mã (60s)" (đếm ngược, vô hiệu) → ô OTP lấy focus;
       · đã gửi + hết đếm ngược: bấm = gửi lại (toast "Đã gửi lại mã OTP", đếm lại 60s).
     Sửa SĐT sau khi đã gửi ⇒ mã cũ không còn khớp: nút về "Gửi mã OTP", xoá ô OTP.
     Xác nhận: SĐT trống → báo ở ô SĐT; chưa gửi mã → "Vui lòng gửi mã OTP trước"; thiếu số → "Vui lòng nhập đủ 6 số" (cùng chuỗi cũ của 6 ô);
     đủ 6 số → sang "Hoàn tất đăng ký" (như cũ; demo chưa so mã đúng/sai — xem AUDIT). */
  const regSend = root.querySelector('[data-reg-send]');
  if (regSend) {
    const phoneEl = root.querySelector('#regPhone'), otpEl = root.querySelector('#regOtp');
    const stopTimer = () => { clearInterval(regOtpIv); regOtpIv = null; };
    const startCountdown = () => {
      stopTimer();
      regSend.disabled = true;
      regSend.innerHTML = 'Nhận lại mã (<span id="otpTimer">60</span>s)';
      localizeNew(regSend);
      let t = 60; const tEl = regSend.querySelector('#otpTimer');
      regOtpIv = setInterval(() => {
        t--; if (tEl) tEl.textContent = t;
        if (t <= 0) { stopTimer(); regSend.disabled = false; regSend.textContent = 'Nhận lại mã'; localizeNew(regSend); }
      }, 1000);
    };
    const idleSend = () => { regSend.disabled = false; regSend.textContent = 'Gửi mã OTP'; localizeNew(regSend); };
    if (regOtpSent) startCountdown(); else stopTimer();

    regSend.addEventListener('click', () => {
      if (regSend.disabled) return;
      if (regOtpSent) { toast('Đã gửi lại mã OTP'); startCountdown(); return; }
      const val = phoneEl.value.trim();
      if (!val) { setFieldErr(phoneEl, 'Vui lòng nhập số điện thoại'); phoneEl.focus(); return; }
      if (!FIELD_RULE.phone[0](val)) { setFieldErr(phoneEl, FIELD_RULE.phone[1]); phoneEl.focus(); return; }
      clearFieldErr(phoneEl);
      authPhone = val; authFlow = 'register';
      regSend.disabled = true; regSend.innerHTML = spinnerSVG();
      setTimeout(() => {
        if (phoneEl.value.trim() !== val) { idleSend(); return; }   // vừa sửa số trong lúc quay: không coi là đã gửi
        regOtpSent = true; startCountdown(); clearFieldErr(otpEl); toast('Đã gửi mã OTP'); otpEl.focus();   // clearFieldErr: bỏ lỗi "gửi mã OTP trước" nếu đã lỡ bấm Xác nhận
      }, 700);
    });
    phoneEl.addEventListener('input', () => {
      if (!regOtpSent) return;
      resetRegOtp(); idleSend(); otpEl.value = ''; clearFieldErr(otpEl);
    });
    otpEl.addEventListener('input', () => { otpEl.value = otpEl.value.replace(/\D/g, '').slice(0, 6); clearFieldErr(otpEl); });
    root.querySelectorAll('[data-reg-verify]').forEach(btn => btn.addEventListener('click', () => {
      const val = phoneEl.value.trim();
      if (!val) { setFieldErr(phoneEl, 'Vui lòng nhập số điện thoại'); phoneEl.focus(); return; }
      if (!regOtpSent) { setFieldErr(otpEl, 'Vui lòng gửi mã OTP trước'); otpEl.focus(); return; }
      if (otpEl.value.length < 6) { setFieldErr(otpEl, 'Vui lòng nhập đủ 6 số'); otpEl.focus(); return; }
      clearFieldErr(otpEl);
      authPhone = val; authFlow = 'register';
      btn.innerHTML = spinnerSVG();
      setTimeout(() => { resetRegOtp(); authView = 'reginfo'; rerenderLogin(); }, 700);
    }));
  }

  // Đổi SĐT từ màn OTP -> quay lại màn nhập SĐT của luồng
  root.querySelectorAll('[data-otp-change]').forEach(btn => {
