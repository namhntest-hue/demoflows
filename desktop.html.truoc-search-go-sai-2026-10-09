function cartPidAttr(c) {
  const i = PRODUCTS.findIndex(p => p.name === c.name && (!c.brand || p.brand === c.brand));
  return i >= 0 ? ` data-product="${i}"` : '';
}
function cartRowNote(c) {
  if (!c) return '';
  if (c.stock === 0)
    return `<p class="cart-note t-single text-destructive pt-1">Sản phẩm đã hết hàng</p>`;
  if (c.stock != null && (c.qty || 1) >= c.stock)
    return `<p class="cart-note t-single pt-1" style="color:var(--general-warning,#a1670a)">Chỉ còn ${c.stock} sản phẩm</p>`;
