/* ĐỔI SANG FIELD NỔI (15/09/2026) — xem khối CSS `.field-float`. Nhãn CŨ đứng
   TĨNH phía trên (`<label>` riêng dòng) nay dời vào TRONG ô, làm luôn việc của
   placeholder; `for`/`id` giữ nguyên nên bấm nhãn vẫn nhảy vào ô. */
const accField = (key, label, val, ph, opts = {}) => {
  const { type = '', mode = '', auto = '', hint = '' } = opts;
  const id = 'acc-' + key;
  const pass = type === 'password';
  /* 21/09/2026 — xem FIELD_RULE; aphone là ô số điện thoại trong form địa chỉ. */
  const rule = key === 'aphone' ? 'phone' : key === 'aemail' ? 'email' : (FIELD_RULE[key] ? key : '');   // 02/10/2026: aemail = ô Email của form địa chỉ
  return `
    <div class="pb-4 flex flex-col gap-2">
      <div class="field-float">
        <input id="${id}" data-af="${key}"${rule ? ` data-rule="${rule}"` : ''} value="${val}" placeholder=" "${type ? ` type="${type}"` : ''}${mode ? ` inputmode="${mode}"` : ''}${auto ? ` autocomplete="${auto}"` : ''}
               class="t-multiline bg-background border rounded-xs px-2 ${pass ? 'pr-9 ' : ''}text-foreground outline-none focus:border-primary transition-colors">
        <label for="${id}" class="text-muted-foreground">${label}</label>
        ${pass ? eyeBtn() : ''}
      </div>
      ${hint ? `<p class="t-single text-muted-foreground">${hint}</p>` : ''}
    </div>`;
};

/* Ô KHOÁ (brief trang 47: "4 trường tô xám là 4 trường không thể thay đổi thông tin").
