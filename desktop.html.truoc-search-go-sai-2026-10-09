/* MENU_BRANDS viết tên kiểu wordmark (ZIMMERMANN, FERRAGAMO) còn PRODUCTS.brand
   viết thường (Zimmermann) — quy về một mối trước khi tra bảng trên. */
function brandKey(name) {
  const n = String(name || '').trim().toLowerCase();
  return Object.keys(BRAND_PAGES).find(b => b.toLowerCase() === n) || null;
}

/* Thương hiệu của PLP đang đứng. Mặc định Versace để mọi lối vào cũ (logo
   header, link chung, `{type:'brand'}` không kèm tên) giữ nguyên hành vi. */
const plpBrandName = () => (plpMode.type === 'brand' && plpMode.brand) || 'Versace';

/* 22 hãng còn lại trong menu CHƯA có data (không logo, không ảnh, không copy) —
   trả khuôn rỗng để trang vẫn dựng được: tên hãng chạy chữ thay logo, không hero,
   không dải danh mục, lưới rơi về trạng thái 0 kết quả của chính PLP. Thà vậy
   còn hơn đưa người dùng vào trang Versace mang tên hãng khác. */
function brandPage(name) {
  const key = brandKey(name);
  return Object.assign({ name: key || name, logo:'', hero:'', desc:'', cats:[] },
                       key ? BRAND_PAGES[key] : null, { name: key || name });
}

