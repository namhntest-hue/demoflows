/* Card sản phẩm — Card-item của Figma (2541:175787)
   giá bán #d62845 Medium 14/20 + badge -%% nền #fef2f2 · giá gốc gạch ngang #737373
   Dùng chung cho: grid PLP, hàng gợi ý PDP, "Show more". */
/* ── Nguồn thẻ cho dải "Gợi ý mua kèm" (02/09/2026, lệnh user: dải này phải
   demo bằng ẢNH NGƯỜI MẪU thay vì ảnh sản phẩm tĩnh) ─────────────────────
   Chỉ nhận SP CÓ ảnh on-model thật (`p.model`) — SP không có thì loại khỏi dải
   luôn, chứ không để nó lọt vào rồi rơi về ảnh tĩnh: một dải nửa model nửa
   packshot đọc ra là lỗi chứ không phải chủ ý.
   Loại luôn chính SP đang xem: "Gợi ý mua kèm" mà thẻ đầu là món đang mở thì vô
   nghĩa (dải cũ mắc lỗi này vì luôn lấy PRODUCTS.slice(0, n)).
   XOAY theo selfIdx để 6 PDP không ra cùng một bộ 5 thẻ; xoay chứ không random
   để mỗi lần dựng lại màn vẫn ra đúng bộ cũ. */
function lookProducts(selfIdx, n) {
  const pool = PRODUCTS.map((p, i) => ({ p, i })).filter(({ p, i }) => p.model && i !== selfIdx);
  if (!pool.length) return [];
  const take = Math.min(n, pool.length);
  const start = (Math.max(0, selfIdx | 0) * 3) % pool.length;
  return Array.from({ length: take }, (_, k) => pool[(start + k) % pool.length]);
}

/* Thẻ của 2 dải gợi ý dưới PDP. Tách thành hàm chung vì 6 màn PDP lặp y hệt
   đoạn này, và từ 02/09 hai dải KHÔNG còn chung một nguồn thẻ nữa:
   "Gợi ý mua kèm" đi ảnh model, "Sản phẩm tương tự" giữ ảnh tĩnh như cũ. */
function lookRailCards(title, n, selfIdx, w, badgeAt = -1) {
  const badge = k => (k === badgeAt ? 'New arrival' : '');
  if (title !== 'Gợi ý mua kèm')
    return PRODUCTS.slice(0, n).map((p, i) => productCard(p, i, { w, noColors: true, badge: badge(i) })).join('');
  return lookProducts(selfIdx, n)
    .map(({ p, i }, k) => productCard(p, i, { w, noColors: true, model: true, badge: badge(k) })).join('');
}

