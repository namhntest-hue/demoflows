function hmUsp() {
  /* MỘT KHỐI CHO MỌI TRANG. `camKetSection()` nay gọi thẳng hàm này (xem ở đó), nên
     sửa khuôn ở đây là sửa cho cả trang chủ lẫn 6 màn PDP, màn Hoàn tất…
     Số đo đọc từ component Figma `hm-usp` (664:124121):
       khối   HORIZONTAL · đệm 40/24 · khe 16 · canh giữa cả 2 trục · 1440x148
       mục    VERTICAL   · khe 8 · canh giữa · 324x68 → icon 40 TRÊN, nhãn DƯỚI
       nhãn   t-label-lead = 14/20 Inter Medium, mực #0a0a0a
       vạch   1px cao 68, màu #f5f2ed (= mặt kem) giữa các mục
     40 + 68 + 40 = 148 ✓
     ⚠ ICON TRỞ LẠI KIỂU "TRÊN NHÃN" và về cỡ 40 — đảo đúng hai lượt 07/09 (xuống cạnh
     nhãn) và 10/09 (về 16). Lần này user sửa thẳng trong component nên component là bên
     chuẩn; đừng đảo lại nếu không có thiết kế mới.
     ⚠ KHỐI NAY KHÔNG CÒN NỀN KEM. Trong khung Figma user sửa, `hm-usp` không có fill
     (nằm trên nền trắng) còn `hm-occ` / `hm-signup-band` / footer thì vẫn kem — tức đây
     là chủ ý, không phải sót. Đã gỡ `.hm-usp` khỏi danh sách mặt kem của bộ da.
     Vạch ngăn dùng CHÍNH màu kem trên nền trắng: nhạt có chủ ý, nó chỉ để tách 4 mục. */
  return `
      <div class="hm-usp reveal">
${'            '}${HM_USP.map(([ico, label]) => `
        <div class="hm-usp-item">
          <span class="hm-usp-ico shrink-0 flex items-center justify-center">${USP_ICO[ico]}</span>
          <p class="t-lead font-medium text-foreground">${label}</p>
        </div>`).join('')}
      </div>`;
}

