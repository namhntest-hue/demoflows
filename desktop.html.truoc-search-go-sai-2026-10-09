    prods.querySelectorAll('[data-product]').forEach(el => el.addEventListener('click', e => {
      const ps = e.target.closest('[data-pc-size]');        // dải size hover (mã chết khi noQuick, giữ để bật lại chỉ cần bỏ cờ)
      if (ps) { e.stopPropagation(); pcSizeClick(el, ps); return; }
      const qa = e.target.closest('.quick-add');
      const i = el.dataset.product;
      close();                                              // đóng layer trước, y như goSearch
      if (qa) { if (window.__openQuickAdd) window.__openQuickAdd(+qa.dataset.quick); return; }
      goPdp(i);
    }));
    localizeNew(prodTitle.parentElement); localizeNew(prods);
  };
  const render = () => { renderTerms(); renderStatic(); renderProducts(); };

  const open = () => {
    if (layer.classList.contains('open')) return;
    const el = $in(), row = $row(), nav = $nav(), btn = $btn();
    if (!el || !row || !nav || !btn) return;
    el.value = searchQuery || '';
    render();
    nav.classList.add('search-open');           // quét ô nhập + tắt subheader
    btn.innerHTML = I.close;                    // icon search -> dấu ✕ (chính nó đóng)
    btn.setAttribute('aria-label', 'Đóng tìm kiếm');
    lockBodyScroll();                           // khoá cuộn TRƯỚC rồi mới đo nav
    syncInner();                                // nội dung = đúng ô nhập: đo SAU khi khoá cuộn (body bù thanh cuộn nên ô nhập giữ nguyên chỗ)
    /* Tấm gợi ý bắt đầu ĐÚNG DƯỚI HÀNG NAV CHÍNH, tức KÉO LÊN phủ luôn dải
       subheader vừa tắt (17/08/2026, yêu cầu user) — trước đó đo theo đáy cả
       .navbar nên tấm này bắt đầu dưới subheader, chừa lại một dải trống.
       Đo tại lúc mở vì chiều cao nav đổi theo trạng thái cuộn (promo bar). */
    layer.style.top = Math.round(row.getBoundingClientRect().bottom) + 'px';
    layer.classList.add('open');
    layer.setAttribute('aria-hidden', 'false');
    /* Nền tối KHÔNG cần JS đặt mốc nữa: layer là flex-col, nền tối là item thứ 2
       nên tự bám đáy tấm dù tấm cao thấp thế nào (xem khối CSS #dkSearchLayer). */
    setTimeout(() => el.focus(), 60);
  };
  function close() {
    const nav = $nav(), btn = $btn();
    if (nav) nav.classList.remove('search-open');
    if (btn) { btn.innerHTML = I.search; btn.setAttribute('aria-label', 'Tìm kiếm'); }
    if (!layer.classList.contains('open')) return;
    layer.classList.remove('open');
    layer.setAttribute('aria-hidden', 'true');
    unlockBodyScroll();
  }

  /* NỘI DUNG BẰNG Ô NHẬP (06/10/2026, user): đo hộp của `#dkNavSearchField` (animation của nó là clip-path nên hộp luôn ở chỗ cuối, không đổi
     theo hiệu ứng) rồi đặt `--ds-left` / `--ds-width` cho `.ds-inner`. Gọi lúc mở và khi đổi cỡ cửa sổ đang mở. Không có ô nhập (không xảy ra) thì để mặc định. */
  const syncInner = () => {
    const bar = document.getElementById('dkNavSearchField');
    if (!bar) return;
    const r = bar.getBoundingClientRect();
    layer.style.setProperty('--ds-left', Math.round(r.left * 100) / 100 + 'px');
    layer.style.setProperty('--ds-width', Math.round(r.width * 100) / 100 + 'px');
  };
  addEventListener('resize', () => { if (layer.classList.contains('open')) syncInner(); });
  layer.querySelector('.ds-backdrop').addEventListener('click', close);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

  localizeNew(layer);
  window.__openDkSearch = open;
  window.__closeDkSearch = close;
  window.__dkSearchOpen = () => layer.classList.contains('open');
  /* Gọi trong wire() sau mỗi lần render: nối lại listener cho ô nhập MỚI */
  window.__wireDkSearch = root => {
    const el = root.querySelector('#dkSearchInput');
    if (!el) return;
    el.addEventListener('input', () => { renderTerms(); renderProducts(); });   // 06/10/2026: cột phải cũng đi theo từ khoá (có so khoá)
    el.addEventListener('keydown', e => {
      if (e.key === 'Enter') { const q = el.value.trim(); if (q) goSearch(q); }
      if (e.key === 'Escape') close();
    });
  };
})();

